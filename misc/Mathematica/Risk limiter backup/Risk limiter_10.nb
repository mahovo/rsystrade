Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      StyleBox[
       RowBox[{"exp", "(", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"log", "(", "b", ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"c", " ", "x"}], " ", "-", " ", "1"}], ")"}]}], ")"}]}],
       FontSize->14]], "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ExponentialE]", " ", "c", " ", "b", " ", 
         RowBox[{"log", "(", "b", ")"}]}], " ", "+", " ", "1"}], ")"}], " ", 
      "x"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb0508cd-6d10-4e66-b48a-149eae679661"],
 "    ",
 Cell[BoxData[
  FormBox[
   RowBox[{",", " ", 
    RowBox[{
     RowBox[{"for", " ", "x"}], "<", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"c", " ", 
        RowBox[{"log", "(", "b", ")"}]}]]}], "\[Congruent]", "a"}]}], 
   TraditionalForm]],ExpressionUUID->"bf34f699-866b-4f89-b70d-f86926c68b25"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "==", 
    FormBox[
     TagBox[GridBox[{
        {"\[Piecewise]", GridBox[{
           {
            RowBox[{
             RowBox[{"f", "(", 
              RowBox[{
               RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], " "}], 
            RowBox[{
             RowBox[{"for", " ", "x"}], " ", "<", " ", "a", "\[Congruent]", 
             RowBox[{"\[ExponentialE]", " ", "b"}]}]},
           {"x", 
            RowBox[{
             RowBox[{"for", " ", "x"}], ">", "a", "\[Congruent]", 
             RowBox[{"\[ExponentialE]", " ", "b"}]}]}
          },
          AllowedDimensions->{2, Automatic},
          Editable->True,
          GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
