  FormatType->TraditionalForm,ExpressionUUID->
  "0e9a142d-fc0b-47ff-b269-e6f89c6163e2"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "\[Lambda]"}], ")"}], "=", 
    RowBox[{
     RowBox[{"\[Lambda]", " ", 
      RowBox[{"g", "(", 
       RowBox[{"x", ";", " ", "b"}], ")"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "\[Lambda]"}], ")"}], 
      RowBox[{"max", "(", 
       RowBox[{"x", ",", " ", "b"}], ")"}]}]}]}], TraditionalForm]],
