Cell[CellGroupData[{

Cell["Initial thoughts", "Subsection",
 CellChangeTimes->{{3.900339695733982*^9, 3.900339701774494*^9}, {
  3.9004196025555*^9, 
  3.900419603571909*^9}},ExpressionUUID->"86a925ac-299f-4842-b693-\
8da17363f510"],

Cell[TextData[{
 "See section ",
 StyleBox["\[OpenCurlyDoubleQuote]Our soft knee limiter function\
\[CloseCurlyDoubleQuote]",
  FontWeight->"Bold"],
 " below for analysis of the final limiter function."
}], "Text",
 CellChangeTimes->{{3.900419658371395*^9, 3.900419719493042*^9}},
 Background->RGBColor[
  1., 1., 0.85],ExpressionUUID->"64343bbb-ec1f-4915-b6ae-712544cfc82e"],

Cell[TextData[{
 "We want to limit risk (standard deviation) downward.\nBelow ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "f9af625d-b9a3-46aa-b4d8-b601486894fc"],
 ", limit ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "03034981-8b2d-4eb7-a18c-0873f7f16791"],
 " with a function, ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "be2e3f30-3833-4f9c-9f3f-f8d711ac29e7"],
 ", such that ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "6ab5c309-b027-4f5c-a3d1-3e2ac67548d8"],
 " approaches a limit, ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "4b1501b3-dbc9-4310-908a-f9b0d355f2c2"],
 ", as ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "6a3701e6-b71e-4a36-9899-a1544600e1ed"],
 " approaches 0 from above.\nAbove ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "e9d767f7-0689-47f4-bdc1-8d2383cb85ac"],
 ", we want the input ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "3042932c-b92c-4b86-924f-142bf1b9a4e1"],
 " to pass unchanged to the output ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "8f53b942-7760-4e60-98c8-26b032e36647"],
 ", i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", " ", "=", " ", "x"}], TraditionalForm]],ExpressionUUID->
  "ec58d85e-6522-4d37-92cb-fa9627dd1273"],
 ". \nLet ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", 
     RowBox[{"(", "x", ")"}]}], " ", "=", " ", "x"}], TraditionalForm]],
  ExpressionUUID->"e9b35d17-70c4-4269-a7bf-880c9d377a10"],
 ".\nSo we want to construct a piecewise function which is equal to ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "c37093dc-fca1-46dd-b39b-c00675858800"],
 " below ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "bf0503bc-eeab-4519-9266-c1a377c7d699"],
 " and equal to ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "cb8f651c-cc1c-4c3c-b15d-ee835e4325cc"],
 " above ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "6196d80f-4b02-47a6-9f13-07c47e720e47"],
 ".\nInitial idea for ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "ebb2421b-9725-424d-8087-d70a77d24595"],
 ":"
}], "Text",
 CellChangeTimes->{{3.900294305981065*^9, 3.900294384129437*^9}, {
  3.900294429306973*^9, 3.90029446366776*^9}, {3.9002944994532623`*^9, 
  3.900294561319963*^9}, {3.9002946459786158`*^9, 3.9002947412983522`*^9}, {
  3.900295366654849*^9, 3.9002954723140373`*^9}, {3.9004818372944517`*^9, 
  3.900481871631463*^9}, {3.9004879055661583`*^9, 3.900488024816081*^9}, {
  3.900488063501767*^9, 3.900488065057616*^9}, {3.900488127241456*^9, 
  3.900488196526112*^9}},ExpressionUUID->"7d4fcaf9-b8e1-481b-81f0-\
5ace1639908c"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "a"}], ",", " ", "b"}], ")"}], "=", 
   FractionBox["a", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"log", "(", "b", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "a"}], ")"}]}]]]}], 
  TraditionalForm]],ExpressionUUID->"b9bb2315-ac11-4d37-9808-2a3dbbcdc462"]], \
"Text",
 CellChangeTimes->{{3.900487673076721*^9, 3.900487725501163*^9}, {
  3.900488549898467*^9, 
  3.90048854989853*^9}},ExpressionUUID->"0c60d407-3f89-49db-9cc5-\
62a760b4f92e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"x_", ",", " ", "a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{"a", "/", 
   RowBox[{"(", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"Log", "[", "b", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"x", "-", "a"}], ")"}]}], "]"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.900293194839884*^9, 3.900293247824238*^9}, {
   3.900293335219287*^9, 3.900293337610111*^9}, {3.900293412962286*^9, 
   3.900293415369874*^9}, {3.900293496412507*^9, 3.900293498226777*^9}, 
   3.9004193768519993`*^9},
 CellLabel->
  "In[1218]:=",ExpressionUUID->"d38b60de-fd73-4162-b881-1cc1f7f90ec4"],

