Cell[TextData[{
 "The smaller the value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "119d3afa-a006-4f51-86f6-c5367bc7e377"],
 ", the lower the position of the curve. The blue line at the bottom \
corresponds to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "0.1"}], TraditionalForm]],ExpressionUUID->
  "bc217762-1c62-46c0-b30b-9ee5afe19675"],
 "."
}], "Text",
 CellChangeTimes->{{3.900406103877269*^9, 3.900406166909837*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"12b8eaa7-b42e-4aff-b0aa-c49b2d2093db"],

Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "c", "<", 
    RowBox[{"1", "/", "x"}]}], TraditionalForm]],ExpressionUUID->
  "2a91f169-a304-4434-9e42-0b2be037d433"],
 " we see that for a given value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "b1b67503-e5a1-4c84-815b-8693923d801a"],
 " there is a minimum valid value of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "54d13ce8-ea7c-4c5c-ae83-1621d996049b"],
 ". This is a little worrying, as we want small values of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "65cbffae-a794-4b94-b9c6-670f431354c5"],
 " (the minimum value of our output). There is also a maximum value of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "486d2486-b811-487c-b72a-b8223e8f5d99"],
 ", but this seems to be outside the region.\n\nIt follows that for a given \
value of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "57cbfb4a-ebc6-4e56-aa85-adc4e050e081"],
 ", we need to compute the constraints on ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "a79ac393-f421-4290-9d09-259d13e05518"],
 "."
}], "Text",
 CellChangeTimes->{3.900405910097822*^9},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"c85269f6-7cb2-4472-9053-4dd3c6daa345"],

Cell[TextData[{
 "We can\[CloseCurlyQuote]t express ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "35d38549-bb8c-4c77-b587-da093fc2c39f"],
 " as a function of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "69af3e50-d235-48d0-9ea0-a36b32bdaa25"],
 ", because the constraint function includes the form ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", " ", 
    SuperscriptBox["\[ExponentialE]", "c"]}], TraditionalForm]],
  ExpressionUUID->"c56654fd-a051-41b8-9cb8-ddfb4bb37330"],
 "as well as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", " ", 
    RowBox[{"log", "(", "b", ")"}]}], TraditionalForm]],ExpressionUUID->
  "ce96818b-7398-4219-a7f2-e34ab8e9faef"],
 ". Neither of those forms can be reduced with elementary functions, as the \
solution is a Lambert ",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],ExpressionUUID->
  "cdca21c0-9e79-4092-a613-7a2986c42a9e"],
 " function (see note). Instead we will have to calculate the constraints on ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "fc8bf826-6e9b-452f-a8ec-4cdb647d74fc"],
 " numerically for a given value of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "5327c1fb-b3a4-432d-9518-2563033d6a6b"],
 "."
}], "Text",
 CellChangeTimes->{{3.900404779708096*^9, 3.900404959076885*^9}, {
  3.900404994743349*^9, 3.9004050478718653`*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"4a118849-6daf-4562-979e-3cd9a0990994"],

Cell[TextData[{
 "We do observe from these plots, that for small values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "e9e4930b-9ea8-4b2b-9e1f-fc591909a2ba"],
 " and small values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "633f6458-43ea-4cd4-8395-9a4548263f45"],
 ", the lower constraint on ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "550beccc-fa46-4c93-8d02-ca4aeabbacb1"],
 " is quite small. Let\[CloseCurlyQuote]s get a better sense of how small \
with a log-log plot and smaller values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "870ccabe-6caf-4715-97f8-8ffd336250e3"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9004062209744596`*^9, 3.90040622524625*^9}, {
  3.900406257070621*^9, 3.900406350095334*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"02a4a81c-e958-4146-8b41-f10ff56ef7e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"b", ",", " ", "c"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"x_", ",", " ", "c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"x", "*", "c"}]}], ")"}]}], "-", "1"}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvalues", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "n"}], "]"}]}], ")"}], "/", "10"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<c=\>\"", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"cvalues", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}]}],
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", " ", "\"\<\[Tau](x)=1\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", 
      RowBox[{"tauvals", "[", 
       RowBox[{"x", ",", " ", 
        RowBox[{"cvalues", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", " ", "b"}], "]"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", " ", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"LogLinearPlot", "[", "\[IndentingNewLine]", 
  RowBox[{"out", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"b", ",", " ", "0", ",", 
     RowBox[{"1", "/", "\[ExponentialE]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", " ", "legends"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<b\>\"", ",", " ", "12"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<\[Tau](\>\"", ",", 
          RowBox[{"ToString", "[", "x", "]"}], ",", " ", "\"\<)\>\""}], "]"}],
         " ", ",", " ", "12"}], "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"\"\<x = \>\"", ",", " ", 
      RowBox[{"ToString", "[", "x", "]"}], ",", " ", "\"\<, Log-lin\>\""}], 
     "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9004059177739267`*^9, 3.900405945008497*^9}, {
   3.900406011697072*^9, 3.9004060411928587`*^9}, 3.900406076029212*^9, {
   3.9004063613763657`*^9, 3.900406362322069*^9}, {3.900471805222283*^9, 
