Cell[CellGroupData[{

Cell["Derivation of the downward limiter function, version 2", "Section",
 CellChangeTimes->{
  3.900643417616568*^9, {3.9008258998256474`*^9, 3.900825901361472*^9}, {
   3.900826358851714*^9, 
   3.9008263589638777`*^9}},ExpressionUUID->"600b40a4-e172-48e5-8a03-\
dd772bb4d253"],

Cell[TextData[{
 "Initial idea:\n\nThe ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73f5dc95-cb74-4aaa-a6cc-eb2d018179a9"],
 "-function in version 1 offers a limited minimum \
\[OpenCurlyDoubleQuote]softness\[CloseCurlyDoubleQuote] of the knee. In other \
words, we can\[CloseCurlyQuote]t achieve a hard knee with that function.\n\n\
To enable the limiter function to offer anything between a hard and a very \
soft knee, we may simply interpolate between ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "414e22e4-ccf9-4391-9701-dd77626d8edf"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"max", "(", 
    RowBox[{"b", ",", " ", "x"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "181e2ecb-49b3-45c6-a9e5-7cd08bafada7"],
 ":"
}], "Text",
 CellChangeTimes->{{3.900826611411841*^9, 
  3.900826825183737*^9}},ExpressionUUID->"8d13b481-f165-42c9-9e14-\
522c4150b972"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"log", "(", "b", ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c", " ", "x"}], "-", "1"}], ")"}]}], ")"}], ")"}]]}], 
   TraditionalForm]],ExpressionUUID->"345effbc-61c7-49f6-8902-1643081310ca"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", 
    RowBox[{"-", 
     FractionBox["1", 
      StyleBox[
       RowBox[{"\[ExponentialE]", " ", "b", " ", 
        RowBox[{"log", "(", "b", ")"}]}],
       FontSize->13]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5c63702b-dd3d-4db1-a1b3-9882460d14a0"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "==", 
    FormBox[
     TagBox[GridBox[{
        {"\[Piecewise]", GridBox[{
           {
            RowBox[{
             RowBox[{"f", "(", "x", ")"}], " "}], 
            RowBox[{
             RowBox[{"for", " ", "x"}], " ", "<", " ", "a"}]},
           {"x", 
            RowBox[{
             RowBox[{"for", " ", "x"}], ">", "a"}]}
          },
          AllowedDimensions->{2, Automatic},
          Editable->True,
          GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
          GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
          GridBoxSpacings->{"Columns" -> {
              Offset[0.27999999999999997`], {
               Offset[0.84]}, 
              Offset[0.27999999999999997`]}, "Rows" -> {
              Offset[0.2], {
               Offset[0.4]}, 
              Offset[0.2]}},
          Selectable->True]}
