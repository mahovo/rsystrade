Cell[TextData[{
 "We can show, that the limit is in fact ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", " ", 
    SuperscriptBox["b", "a"]}], TraditionalForm]],ExpressionUUID->
  "44c48f7b-e81d-47fd-9aaa-8c080fa5a45b"],
 " \[Dash] and not ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "3850dcb2-1dff-4f3b-95f0-5f515df5bf67"],
 ". So we need to fix this."
}], "Text",
 CellChangeTimes->{{3.900592034306448*^9, 3.9005920831399*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"3da2441d-b455-4908-8822-a59f71ebf639"],

