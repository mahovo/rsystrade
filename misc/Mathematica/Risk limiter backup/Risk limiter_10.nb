  FormBox["c", TraditionalForm]],ExpressionUUID->
  "2a56daff-184b-4b28-a203-cf1a28c7e363"],
 " value, as in the plot below, where the range fo the slider for the ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "e7dcbdaf-f2cc-406d-901c-14ad777fbf25"],
 " value is calculated automatically based on the chosen ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "97329a90-ebd6-4833-bf81-d53bb37f9b5e"],
 " value. 10 might be a sensible maximum value for a ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "1552dffb-ab8c-4861-94e7-fe02888c44b1"],
 " slider."
}], "Text",
 CellChangeTimes->{
  3.900569675873061*^9, {3.900570093797077*^9, 3.900570134908476*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"1be1e99b-5d92-40f5-9db9-1b6dc3fa8c8e"],

Cell[CellGroupData[{

Cell[TextData[{
 "Conclusion for region 2 (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "\[ExponentialE]"], "<", "b", "<", "1"}], 
   TraditionalForm]], "Subsection",ExpressionUUID->
  "e97025ec-bf38-4b9d-a24b-ef115ba881a3"],
 ")"
}], "Subsubsection",
 CellChangeTimes->{{3.900344737070858*^9, 3.900344752059111*^9}, {
  3.900344791517351*^9, 3.90034482208648*^9}, {3.900344955626459*^9, 
  3.900344960954851*^9}, {3.9004812347605143`*^9, 3.900481234856823*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"221b48fb-ecb0-41d7-bca7-5cb5753b5e9b"],

Cell[TextData[{
 "Constraint:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"30044b40-41f4-4eec-9412-df7621127df6"],
 "\n\nIf we constrain ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "0a8dac35-df2c-409a-b53a-a446413322bd"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"787ffcbb-1deb-4fe3-83ae-d0035bd0cfb9"],
 ", when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "\[ExponentialE]"], "<", "b", "<", "1"}], 
   TraditionalForm]],ExpressionUUID->"35cbd9c4-9232-4fa6-b891-6d2ac6aa280d"],
 ", we should be safe for all positive ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "f1f6b1fc-8726-4581-a018-10b8c76a5cb5"],
 "."
}], "Text",
 CellChangeTimes->{{3.900344831101749*^9, 3.900344889522518*^9}, {
  3.90039302449625*^9, 3.90039302449636*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"d90239cc-a23c-48cf-aa59-b505caa3dce1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Region 3: ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "<", "b", "<", "\[ExponentialE]"}], TraditionalForm]],
  ExpressionUUID->"c3c37767-2e34-4eac-a3e8-bd5e355251d3"]
}], "Subsection",
 CellChangeTimes->{{3.900344917522976*^9, 3.900344920369581*^9}, {
   3.900399018954021*^9, 3.900399019623485*^9}, 3.900399051278219*^9},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"a07243cf-ffeb-49ad-aac5-7c56a2943fde"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<=", 
    RowBox[{"log", "(", "b", ")"}], "<", 
    RowBox[{"1", "\[DoubleLongLeftRightArrow]", "1"}], "<", "b", "<", 
    "\[ExponentialE]"}], TraditionalForm]],ExpressionUUID->
  "13d022df-e1ec-45b6-a1b7-9321926377b5"],
 "\n\nIf ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], " ", "=", " ", "1"}], TraditionalForm]],
  ExpressionUUID->"cf275211-1f9e-4585-8e54-25a6813a1c99"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "\[ExponentialE]"}], TraditionalForm]],ExpressionUUID->
  "7fcf933b-c6c1-49b0-95e7-4683231c713a"],
 ", and we get the constraint...\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", " ", 
       RowBox[{
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{"c", "(", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"1", "-", "cx"}]], "-", "1"}], ")"}], "<", "1"}]}]}], 
   TraditionalForm]],ExpressionUUID->"d5dc41d7-1dcd-4777-a0fc-5969c850b60e"]
}], "Text",
 CellChangeTimes->{{3.900339492282131*^9, 3.9003394976992083`*^9}, {
  3.9003449234894733`*^9, 3.9003449388820066`*^9}, {3.9003449878765306`*^9, 
  3.9003449917568293`*^9}, {3.900345036937491*^9, 3.900345042478012*^9}, {
  3.900345075791234*^9, 3.9003450870599937`*^9}, {3.900384224046463*^9, 
  3.900384287080649*^9}, {3.900386395071802*^9, 3.9003864382959023`*^9}, {
  3.900386481070064*^9, 3.9003865152551622`*^9}, {3.90038663339544*^9, 
  3.9003866336445436`*^9}, {3.900419969986762*^9, 3.90041996998945*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"4b1035f7-4ace-4cb1-8c68-794dcefbe7fb"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s get a visual of the situation. Define\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{"c", ";", " ", "x"}], ")"}], ":=", 
    RowBox[{"c", "(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"1", "-", "cx"}]], "-", "1"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"72e5823e-be15-496c-ac0a-638c62e3272f"]
}], "Text",
 CellChangeTimes->{{3.900386635697893*^9, 3.900386641162822*^9}, {
  3.900427510477626*^9, 3.900427530670504*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"974897b0-9a71-4e38-acac-a952f47f192f"],

