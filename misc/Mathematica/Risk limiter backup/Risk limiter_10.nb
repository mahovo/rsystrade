Cell[TextData[{
 "Finally, we need to calculate the valid parameter ranges for b and c, given \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ">=", "0"}], TraditionalForm]],ExpressionUUID->
  "bb221c84-f162-40f6-8fc0-549582bb7151"],
 ".\nThese will be ones where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "'"}], TraditionalForm]],ExpressionUUID->
  "0a676f4d-ca83-4a11-9a33-d49743a6c6aa"],
 " is always positive for positive values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "f2d30ab7-7456-4ebd-9be4-ac2a42e4b0c3"],
 ".\n\nSo, we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"51e1637d-69ae-4fca-91b6-9cd7155bd045"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", 
    RowBox[{
     RowBox[{"\[ExponentialE]", " ", "b", " ", "c", " ", 
      RowBox[{"log", "(", "b", ")"}]}], "+", "1"}]}], TraditionalForm]],
  ExpressionUUID->"cbc91a5b-db4d-426c-8739-a06ede5e37b1"],
 ", and we need:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[ExponentialE]", " ", "b", " ", "c", " ", 
       RowBox[{"log", "(", "b", ")"}]}], "+", "1", "-", 
      RowBox[{"c", " ", 
       RowBox[{"log", "(", "b", ")"}], " ", 
       SuperscriptBox["b", 
        RowBox[{"1", "-", 
         RowBox[{"c", " ", "x"}]}]]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"c", " ", "b", " ", 
        RowBox[{"log", "(", "b", ")"}], 
        RowBox[{"(", 
         RowBox[{"\[ExponentialE]", " ", "-", 
          SuperscriptBox["b", 
           RowBox[{
            RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "+", "1"}], ">", " ", 
      "0", " "}]}]}], TraditionalForm]],ExpressionUUID->
  "b3793912-e944-4f2d-9a7f-0fc810e786fe"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[DoubleLongLeftRightArrow]", "c"}], " ", "b", " ", 
     RowBox[{"log", "(", "b", ")"}], 
     RowBox[{"(", 
      RowBox[{"\[ExponentialE]", " ", "-", 
       SuperscriptBox["b", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "<", " ", "1", " "}], 
   TraditionalForm]],ExpressionUUID->"2d928a33-b2b1-43f4-af90-b6ff27d846ff"],
 "\n\nLet\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{"c", " ", "b", " ", 
     RowBox[{"log", "(", "b", ")"}], 
     RowBox[{"(", 
      RowBox[{"\[ExponentialE]", " ", "-", 
       SuperscriptBox["b", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"9257d3f9-efa3-45f8-9789-d167eca417df"]
}], "Text",
 CellChangeTimes->{{3.9006480051284733`*^9, 3.9006480350593767`*^9}, {
  3.90064808426403*^9, 3.900648084264151*^9}, {3.900648125969315*^9, 
  3.90064816882441*^9}, {3.900648199547165*^9, 3.9006482366256857`*^9}, {
  3.900648282140132*^9, 3.9006482821402597`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"0552909d-9cf1-4f63-9b5c-3557233e5d56"],

Cell[CellGroupData[{

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"b", ">", "1"}], TraditionalForm]],
 FormatType->
  TraditionalForm,ExpressionUUID->"464cfdd9-6b2b-461f-aa2b-e7a523575ec6"]], \
"Subsubsection",
 CellChangeTimes->{{3.900665234155162*^9, 3.9006652515415583`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"f8749d11-458c-47e2-8537-a1f89cb5f707"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "abc909c4-d0f4-47a1-bbbd-b77c4bb39453"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"c", " ", 
        RowBox[{"log", "(", "b", ")"}]}]]}], "<", "0"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "80a5f8b6-99e0-460f-9c16-e8b8906201eb"],
 ", which means that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{"g", "(", "x", ")"}], 
     RowBox[{"\[ForAll]", 
      RowBox[{"x", ">", "0"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d4d9fb0a-2b97-4511-81e0-0403e792183d"],
 ". The softknee function will never kick in. So in implementation we should \
constrain ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "185a66e9-85d0-495c-a0cb-914df0bb64a2"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "84b42d4f-da78-4167-8010-268d4fce52da"],
 "."
}], "Text",
 CellChangeTimes->{{3.900729127209436*^9, 3.900729176786358*^9}, {
  3.9007292310848217`*^9, 3.900729346012282*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"a623f867-0ef3-4fc4-8128-e4fa7ce9bb1a"],

Cell[TextData[{
 "Nevertheless, lets examine the case ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f1e1c466-69ac-4773-a13f-0769812acd52"],
 "."
}], "Text",
 CellChangeTimes->{{3.900729359963777*^9, 3.9007293909316063`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"13dd7ca8-95d2-416a-ad75-1e997245ac92"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"b", " ", "=", " ", "1.2"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"m", "=", "1"}], ";", " ", "\[IndentingNewLine]", 
    RowBox[{"n", "=", 
     RowBox[{
      RowBox[{"2", "*", "m"}], "+", "2"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"c", ",", " ", "x"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"x_", ",", " ", "c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", "*", "b", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{"E", "-", 
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}], ")"}]}]}], ")"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"xvalues", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "m"}], ",", "m"}], "]"}], ")"}]}]}], "]"}], "]"}], 
      "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvalues", "=", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", " ", "1", ",", " ", "10", ",", " ", "100"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"Length", "[", "xvalues", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", 
    RowBox[{"i", "<", 
     RowBox[{"n", "+", "1"}]}], ",", " ", 
    RowBox[{"i", "++"}], ",", " ", 
    RowBox[{"legends", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"legends", ",", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<x=\>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"xvalues", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", 
    RowBox[{"i", "<", 
     RowBox[{"n", "+", "1"}]}], ",", " ", 
    RowBox[{"i", "++"}], ",", " ", 
    RowBox[{"out", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"out", ",", 
       RowBox[{"tauvals", "[", 
