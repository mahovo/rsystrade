Cell[CellGroupData[{

Cell["Soft knee downward limiter function, version 1", "Subsection",
 CellChangeTimes->{{3.9003983929845448`*^9, 3.9003983969289827`*^9}, {
  3.900481268777191*^9, 3.900481270848681*^9}, {3.900837786986436*^9, 
  3.9008377896428623`*^9}},ExpressionUUID->"0e37ac92-e39c-4d88-86da-\
29db4fd19bd8"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "=", 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {
           RowBox[{
            RowBox[{"f", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}]}], "=", 
            RowBox[{
             FractionBox["1", 
              StyleBox[
               RowBox[{"exp", "(", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"log", "(", "b", ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"c", " ", "x"}], " ", "-", " ", "1"}], ")"}]}], 
                 ")"}]}],
               FontSize->14]], "+", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"\[ExponentialE]", " ", "c", " ", "b", " ", 
                 RowBox[{"log", "(", "b", ")"}]}], " ", "+", " ", "1"}], 
               ")"}], " ", "x"}]}]}], 
           RowBox[{",", " ", 
            RowBox[{
             RowBox[{"for", " ", "x"}], "<", 
             RowBox[{"-", 
              FractionBox["1", 
               RowBox[{"c", " ", 
                RowBox[{"log", "(", "b", ")"}]}]]}], "\[Congruent]", 
             "a"}]}]},
          {
           RowBox[{
            RowBox[{"g", 
             RowBox[{"(", "x", ")"}]}], "=", "x"}], 
           RowBox[{",", " ", 
            RowBox[{
             RowBox[{"for", " ", "x"}], ">=", 
             RowBox[{"-", 
              FractionBox["1", 
               RowBox[{"c", " ", 
                RowBox[{"log", "(", "b", ")"}]}]]}], "\[Congruent]", "a"}]}]}
         },
         AllowedDimensions->{2, Automatic},
         Editable->True,
         GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
         GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.84]}, 
             Offset[0.27999999999999997`]}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}},
         Selectable->True]}
      },
      GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.35]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}],
     "Piecewise",
     DeleteWithContents->True,
     Editable->False,
     SelectWithContents->True,
     Selectable->False,
     StripWrapperBoxes->True]}], TraditionalForm]],ExpressionUUID->
  "72bf1f47-8801-4ebe-8499-c61588202a70"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"87e4e565-cba6-4f24-9ced-00b403eda1ba"],
 " \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", 
    RowBox[{
     RowBox[{"\[ExponentialE]", " ", "c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}]}], "+", "1"}]}], TraditionalForm]],
  ExpressionUUID->"f41a90f2-e835-4b13-8255-fa9d659b34e4"]
}], "Text",
 CellChangeTimes->{
  3.900686189434826*^9, {3.9006862701038427`*^9, 3.90068627731194*^9}, {
   3.900686339458811*^9, 3.900686342082961*^9}, {3.900753635010848*^9, 
