Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"c", ",", " ", "x"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"x_", ",", " ", "c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", "*", "b", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{"E", "-", 
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}], ")"}]}]}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xvalues", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", " ", "n"}], "]"}], "/", "10"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", 
    RowBox[{"i", "<", 
     RowBox[{"n", "+", "1"}]}], ",", " ", 
    RowBox[{"i", "++"}], ",", " ", 
    RowBox[{"legends", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"legends", ",", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<x=\>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"xvalues", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", 
    RowBox[{"i", "<", 
     RowBox[{"n", "+", "1"}]}], ",", " ", 
    RowBox[{"i", "++"}], ",", " ", 
    RowBox[{"out", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"out", ",", 
       RowBox[{"tauvals", "[", 
        RowBox[{
         RowBox[{"xvalues", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", " ", "c", ",", " ", "b"}], 
        "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{"out", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"c", ",", " ", "0", ",", " ", "4"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<c\>\"", ",", " ", "12"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\[Tau](c; x)\>\"", ",", " ", "12"}], "]"}]}], "}"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"\"\<b = \>\"", ",", " ", 
      RowBox[{"ToString", "[", "b", "]"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", "legends"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", " ", "1"}], "}"}]}]}], "\[IndentingNewLine]", 
  "]"}]}], "Input",
