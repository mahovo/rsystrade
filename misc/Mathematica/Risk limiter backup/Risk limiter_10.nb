 Background->GrayLevel[
  1],ExpressionUUID->"2ee8a0a0-b438-4b97-a95b-f7b83c2b9fcb"],

Cell[TextData[{
 "But again we already know from above, that the relevant extreme value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9e9fa725-b19f-4235-a113-b03825577dad"],
 " is ",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b5892c50-3779-482f-80e2-5f9e0bce419c"],
 ".\nSo we can ignore this constraint, which is redundant anyway."
}], "Text",
