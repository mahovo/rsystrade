Cell[TextData[{
 "The way forward is to solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"29d0e48c-9f34-441e-99c5-384390bb118b"],
 " for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "e7621f8b-3e26-4a9d-8a2a-3685f6f4e00a"],
 " given a value of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "c4a80a89-e14a-43cf-acc2-68265ed3ab97"],
 ", to find the range of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "ecb97f64-7f05-4980-8372-2e8d74b9c07d"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "<", "1"}], 
   TraditionalForm]],ExpressionUUID->"690f5f2d-c27e-4be0-8f84-177ff3a0e6ab"],
 ".\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", " ", 
       RowBox[{
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"9e374582-985b-4fa2-a137-dacab77283ee"]
}], "Text",
