Cell[TextData[{
 "We see that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0aa0f2d6-98da-4753-9c4a-cb8d1d90a3f7"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    FractionBox[
     RowBox[{
      RowBox[{"b", " ", "c"}], "-", "1"}], "c"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ead4cf70-3c63-4033-9e21-b8cbafc5c4eb"],
 ".\n\nWe can now plug this expression of ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "101e8848-8ed5-485f-916c-ec4bdceb3cb6"],
 " into ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fbb0dc5c-668f-4b42-9968-958e04861535"],
 ", and join the piecewise functions at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    FractionBox[
     RowBox[{
      RowBox[{"b", " ", "c"}], "-", "1"}], "c"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6c4dac6a-3a7b-4f15-969c-e5d6bc0ccf4f"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], " ", "=", " ", 
    RowBox[{"b", " ", "-", " ", 
     StyleBox[
      FractionBox[
       RowBox[{"b", " ", "-", " ", 
        FractionBox[
         RowBox[{
          RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"]}], 
       RowBox[{"exp", "(", 
        RowBox[{"c", "(", 
         RowBox[{"x", " ", "-", " ", 
          FractionBox[
           RowBox[{
            RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"]}], ")"}], 
        ")"}]],
      FontSize->18]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fe252d81-6167-4a2c-8e35-49839748c6e6"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{"c", "(", 
      RowBox[{"b", "-", 
       FractionBox[
        RowBox[{
         RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"]}], ")"}], " ", 
