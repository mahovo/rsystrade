Cell[TextData[{
 "The point here is, that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "9919350b-7ace-49b7-bbcf-f5bd58310bb5"],
 " is the only constraint on ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "001f4f2a-9243-4c2f-baf5-acff15582dc3"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<=", "1"}], TraditionalForm]],ExpressionUUID->
  "8ab2a368-3b3f-4bea-81e4-6bbd944313ad"],
 "."
}], "Text",
 CellChangeTimes->{{3.900649822537108*^9, 3.900649889469152*^9}, {
  3.9006499386868143`*^9, 3.9006499446790237`*^9}, {3.900650597626218*^9, 
  3.900650597874037*^9}, {3.90065077207716*^9, 3.90065079381213*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"47219d0e-27a7-40c1-9935-dabd37bf2c7d"],

Cell[TextData[{
 "The tricky part is that we don\[CloseCurlyQuote]t know if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d15a9c4a-b81a-4726-aefa-a0c06bb3701c"],
 " is increasing in ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06eab3a5-b0d0-4738-a287-3f6b917a6410"],
 ". So we don\[CloseCurlyQuote]t know if the constrains for the lower extreme \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d7036294-b1ab-4759-ab14-21c5dfb07c4c"],
 ") or the higher extreme (",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7b3ae13d-2b68-461d-97fb-5b2ae609f7dc"],
 ") apply."
}], "Text",
 CellChangeTimes->{{3.9006644700985613`*^9, 3.900664557718123*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"34696880-d2ab-434b-8d73-3250d174a4a2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", " ", "c", ",", " ", "b"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Delta]", "=", "1*^-12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cmax", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f6", "[", 
   RowBox[{"x_", ",", " ", "b_", ",", " ", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"Log", "[", "b", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c", " ", "*", " ", "x"}], "-", "1"}], ")"}]}], "]"}], 
     ")"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", "*", 
       RowBox[{"Log", "[", "b", "]"}]}], "+", "1"}], ")"}], "*", 
    "x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g6", "[", "x_", "]"}], ":=", "x"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h6", "[", 
    RowBox[{"x_", ",", " ", "b_", ",", " ", "c_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f6", "[", 
         RowBox[{"x", ",", " ", "b", ",", " ", "c"}], "]"}], ",", " ", 
        RowBox[{"x", "<", 
         RowBox[{"1", "/", "c"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g6", "[", "x", "]"}], ",", " ", 
        RowBox[{"x", ">=", 
         RowBox[{"1", "/", "c"}]}]}], "}"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"LogLogPlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"h6", "[", 
      RowBox[{"x", ",", " ", "b", ",", " ", "c"}], "]"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", "100"}], "}"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "100"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", "\"\<h(x)\>\"", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", " ", "\"\<h(x)\>\""}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0.1"}], "}"}], ",", " ", "\[Delta]", ",", " ", 
     "2", ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "0.1"}], "}"}], ",", " ", "\[Delta]", ",", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"b", ">", "1"}], ",", " ", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"b", " ", "*", 
          RowBox[{"Log", "[", "b", "]"}], "*", " ", "E"}], ")"}]}], ",", " ", 
       "cmax"}], "]"}], ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
