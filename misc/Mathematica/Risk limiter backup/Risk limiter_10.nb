Cell[TextData[{
 "Let\[CloseCurlyQuote]s consider the extreme case where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "89467ed5-7e6a-4bb3-b12b-7f90fdb6fc45"],
 ":\nThen we have the constraint\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", "(", 
     RowBox[{"1", "-", " ", 
      FractionBox["1", "\[ExponentialE]"]}], ")"}], "<", "1"}], 
   TraditionalForm]],ExpressionUUID->"ae0fc666-25c7-4ed5-a813-9bcc13dc7fb5"],
 "\nwhich is only true for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["\[ExponentialE]", 
     RowBox[{"\[ExponentialE]", "-", " ", "1"}]], "\[TildeTilde]", 
    "1.5819767068693265`"}], TraditionalForm]],ExpressionUUID->
  "d154cf4d-0776-499c-94c7-ce308d9bbcd4"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.9003402112088737`*^9, 3.900340218137027*^9}, {
  3.900340485255355*^9, 3.900340631727298*^9}, {3.900386505942822*^9, 
  3.900386508006837*^9}, {3.9004000222962646`*^9, 3.9004000229196444`*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"5132ed45-921c-424e-9515-ceebd51e4f5e"],

