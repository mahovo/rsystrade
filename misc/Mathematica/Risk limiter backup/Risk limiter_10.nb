Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"23.025850929940454`", " ", "a", " ", 
    SuperscriptBox["0.1`", 
     RowBox[{
      RowBox[{"-", "10"}], " ", 
      RowBox[{"(", 
       RowBox[{"x", "-", "a"}], ")"}]}]], " ", 
    SuperscriptBox["z", 
     RowBox[{
      RowBox[{"-", "10"}], " ", 
