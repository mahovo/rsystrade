Cell[TextData[{
 "The strategy is to solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", " ", "\[ExponentialE]"}], " ", "-", 
      RowBox[{"c", " ", 
       SuperscriptBox["b", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}]]}]}], ")"}], ">", 
    FractionBox["1", 
     RowBox[{"b", " ", 
      RowBox[{"log", "(", "b", ")"}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4b8da8c9-3c03-4f73-abf4-5fb43142c6ea"],
 "for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0c7584cb-82fe-4ca8-a151-7d28032d025f"],
 " with two extreme values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "77137a25-9dd2-4e1c-97f6-bd745c883ce0"],
 "."
}], "Text",
 CellChangeTimes->{{3.9006628283873053`*^9, 3.9006629230451317`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"9f5333e4-8b1a-4c32-ab48-5b95821b8941"],

Cell[TextData[{
 "First, we set ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "77d81427-a572-4c19-b982-887477c59118"],
 " to 0:"
}], "Text",
 CellChangeTimes->{{3.900662933654418*^9, 3.900662943133285*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"c6801e42-ec6b-48f0-a909-792355fc9367"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "b", ",", "c"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "1.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x", "=", "0"}], ";"}], "\n", 
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"c", "*", "E"}], "-", 
     RowBox[{"c", "*", 
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "c"}], "*", "x"}], ")"}]}]}]}], "==", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"b", "*", 
       RowBox[{"Log", "[", "b", "]"}]}], ")"}]}]}], ",", "c", ",", "Reals"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9006627721735573`*^9, 3.90066277219248*^9}, {
  3.900662804164171*^9, 3.9006628252922*^9}, {3.9006629484813766`*^9, 
  3.900662949059424*^9}},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->
  "In[1365]:=",ExpressionUUID->"4df54586-dece-4bcc-8c5f-19b8c97ddb66"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"c", "\[Rule]", "2.6600287842312516`"}], "}"}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.900663014165924*^9, 3.9007522659580603`*^9, 
  3.9008395267281446`*^9},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->
  "Out[1368]=",ExpressionUUID->"9000246a-e2c4-4db8-b6b7-16723018d69d"]
}, Open  ]],

Cell[TextData[{
 "Then, we set ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b212eb41-7eab-4169-80c2-99cda36b3441"],
 " to a very high number which is effectly ",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca1ac7b6-d1fe-418d-8965-a63994130cc4"],
 ". We find that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "1000000"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f4873fac-af9c-4a36-851a-c6f3ef19f3a2"],
 " is a reasonable extreme value:"
}], "Text",
 CellChangeTimes->{{3.9006629538296013`*^9, 3.900663012294491*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"a4094354-c88d-47ca-93dd-764678ac5621"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "b", ",", "c"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "1.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x", "=", "1000000"}], ";"}], "\n", 
 RowBox[{"NSolve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"c", "*", "E"}], "-", 
     RowBox[{"c", "*", 
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "c"}], "*", "x"}], ")"}]}]}]}], "==", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"b", "*", 
       RowBox[{"Log", "[", "b", "]"}]}], ")"}]}]}], ",", "c", ",", "Reals"}], 
  "]"}]}], "Input",
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->
  "In[1369]:=",ExpressionUUID->"155c1450-cc1d-4503-8abc-c8ef6660abb2"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"c", "\[Rule]", 
      RowBox[{"-", "0.00006151710158598661`"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"c", "\[Rule]", "1.6814588815883074`"}], "}"}]}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{3.900663017338944*^9, 3.9007522676536703`*^9, 
  3.900839527947359*^9},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->
  "Out[1372]=",ExpressionUUID->"07ad0bb6-d62b-49f5-b2d7-852b3013b732"]
}, Open  ]],

Cell["We abandon the negative solution.", "Text",
 CellChangeTimes->{{3.900663573782866*^9, 3.9006635806557198`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"06c0ebf8-1ace-47b5-9610-b167aed95675"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f87f3885-580e-44b1-9ecf-df87fa4e8a10"],
 ", ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e524df8-b4fe-40d9-948c-313881b88438"],
 " should be greater than the calculated threshold.\n If ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8863d630-7252-463e-9f92-b2c939e7846e"],
 ", ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "946cf987-ee6f-41ea-929e-54b644140359"],
 " should be less than the calculated threshold (and greater than 0)."
}], "Text",
 CellChangeTimes->{{3.900663058061446*^9, 3.9006631955928507`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"4d0b5531-9a8a-4172-9c6a-33fb2fe46cdc"],

Cell[TextData[{
 "Generate an exponential sequence of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", " "}], TraditionalForm]],ExpressionUUID->
  "3de51134-c91f-4302-b7a1-63b87ca3a1e7"],
 "x-values between 0 and 1, then 1, then ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "3fb54527-e808-4525-9454-ef1fcbaaeff7"],
 " values above 1, all prepended by 0. E.g. (0, 0.01, 0.1, 1, 10, 100). A \
total of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    RowBox[{
     RowBox[{"2", "*", "m"}], "+", "2"}]}], TraditionalForm]],ExpressionUUID->
  "1dc694af-00b5-4299-abe5-6a9ed4c39363"],
 " numbers."
}], "Text",
 CellChangeTimes->{{3.900472972151526*^9, 3.900473214950618*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"9a377d3a-0db5-4fda-aa46-16af36d26ef2"],

Cell[TextData[{
 "Generate an exponential sequence of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"m", " "}], TraditionalForm]],ExpressionUUID->
  "0e41932a-1671-42cd-9a53-06c7da7dd877"],
 "x-values between 0 and 1, then 1, then ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "21608e1d-f983-43ec-92b9-cfae2190f035"],
 " values above 1, all prepended by 0. E.g. (0, 0.01, 0.1, 1, 10, 100). A \
total of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", 
    RowBox[{
     RowBox[{"2", "*", "m"}], "+", "2"}]}], TraditionalForm]],ExpressionUUID->
  "8e562c0f-5ba4-417c-b2db-59ed5fc4af79"],
 " numbers."
}], "Text",
 CellChangeTimes->{{3.900472972151526*^9, 3.900473214950618*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"e19bf681-6cd4-47e8-b6a3-f094bafece11"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"b", " ", "=", " ", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m", "=", "2"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{
     RowBox[{"2", "*", "m"}], "+", "2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"c", ",", " ", "x"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"x_", ",", " ", "c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"x", "*", "c"}]}], ")"}]}], "-", "1"}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvalues", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Append", "[", 
      RowBox[{
       RowBox[{"{", "0", "}"}], ",", " ", 
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "m"}], ",", "m"}], "]"}], ")"}]}]}], "]"}], "]"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", 
    RowBox[{"i", "<", 
     RowBox[{"n", "+", "1"}]}], ",", " ", 
    RowBox[{"i", "++"}], ",", " ", 
    RowBox[{"legends", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"legends", ",", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<x=\>\"", ",", 
          RowBox[{"ToString", "[", 
           RowBox[{"xvalues", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", 
    RowBox[{"i", "<", 
     RowBox[{"n", "+", "1"}]}], ",", " ", 
    RowBox[{"i", "++"}], ",", " ", 
    RowBox[{"out", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"out", ",", 
       RowBox[{"tauvals", "[", 
        RowBox[{
         RowBox[{"xvalues", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", " ", "c", ",", " ", "b"}], 
        "]"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{"out", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"c", ",", " ", "0", ",", " ", "0.1"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<c\>\"", ",", " ", "12"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\[Tau](c; x)\>\"", ",", " ", "12"}], "]"}]}], "}"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", "legends"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"\"\<b = \>\"", ",", " ", 
      RowBox[{"ToString", "[", "b", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
   "]"}]}], "Input",
 CellChangeTimes->{{3.90042113860468*^9, 3.9004211467549477`*^9}, {
   3.900421208757407*^9, 3.900421231508594*^9}, {3.900421307741969*^9, 
