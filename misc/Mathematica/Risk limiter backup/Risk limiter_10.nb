Cell["", "Text",
 CellChangeTimes->{{3.900505500999456*^9, 3.900505507335327*^9}, 
   3.900506411911784*^9},ExpressionUUID->"370b3d82-a391-4d3e-a03d-\
c1bd457a4301"],

Cell[CellGroupData[{

Cell["Constraints", "Subsection",
 CellChangeTimes->{
  3.900339680165222*^9},ExpressionUUID->"a3934eb8-70a8-4166-80c5-\
851671f6f153"],

Cell[TextData[{
 "And this works beatifully! We just need to find the valid parameter ranges \
for b and c.\nThese will be ones where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12fd732e-aeb0-47de-95ad-df7bb6d73828"],
 " is always positive for positive values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "494bf0d6-0797-4e61-8090-d66a72ffd866"],
 ".\nSo, we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "-", 
       FractionBox[
        RowBox[{
         RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"]}], ")"}], " ", 
     RowBox[{"exp", "(", 
      RowBox[{"c", "(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"], "-", " ", 
        "x"}], ")"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d3383ed-bf61-4aea-90d9-a35727aa09b1"],
 ", which gives us the constraint:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "-", 
       FractionBox[
        RowBox[{
         RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"]}], ")"}], " ", 
     RowBox[{"exp", "(", 
      RowBox[{"c", "(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"], "-", " ", 
        "x"}], ")"}], ")"}]}], ">", "0"}], TraditionalForm]],ExpressionUUID->
  "f9225998-ceb3-4e37-b9c6-baa8052c37a1"]
}], "Text",
 CellChangeTimes->{{3.90032414970619*^9, 3.90032417073059*^9}, {
   3.900324261187848*^9, 3.900324318957041*^9}, {3.9003243551816177`*^9, 
   3.900324454391169*^9}, {3.900324484647634*^9, 3.900324488967885*^9}, {
   3.9003245240165367`*^9, 3.900324569861414*^9}, {3.90032464978821*^9, 
   3.9003246765642843`*^9}, {3.900324748426568*^9, 3.900324750853655*^9}, {
   3.900324846957675*^9, 3.900324871007663*^9}, {3.9003249084238577`*^9, 
   3.900324993808462*^9}, {3.9003250254338017`*^9, 3.9003250913376513`*^9}, {
   3.900325125502775*^9, 3.900325150891171*^9}, {3.900325227174155*^9, 
   3.9003252277655582`*^9}, {3.9003252585890102`*^9, 3.900325430362507*^9}, {
   3.900325473782709*^9, 3.900325529826768*^9}, {3.9003255602430353`*^9, 
   3.900325691156994*^9}, {3.900331747019508*^9, 3.900331755911275*^9}, {
   3.9003324708649473`*^9, 3.9003325526863747`*^9}, {3.900332742861664*^9, 
   3.900332781757737*^9}, {3.90033283303869*^9, 3.900333074480991*^9}, {
   3.9003332197552843`*^9, 3.900333243230195*^9}, {3.90033332881354*^9, 
   3.900333348817614*^9}, {3.900333520707447*^9, 3.900333564067746*^9}, {
   3.9003336316392813`*^9, 3.9003336689458447`*^9}, {3.900333712539856*^9, 
   3.900333768417945*^9}, {3.900333799097686*^9, 3.900333893306139*^9}, {
   3.900334001474799*^9, 3.900334009441972*^9}, {3.9003340477784147`*^9, 
   3.9003340913395576`*^9}, {3.9003341325631237`*^9, 3.900334133818204*^9}, {
   3.900334165579273*^9, 3.9003342223800583`*^9}, {3.9003342600646267`*^9, 
   3.90033433717244*^9}, {3.900334368425778*^9, 3.900334414745357*^9}, {
   3.9003344649243793`*^9, 3.9003345015935993`*^9}, {3.900334556979898*^9, 
   3.900334570325199*^9}, {3.900334617389607*^9, 3.900334635085965*^9}, {
   3.9003347365077257`*^9, 3.900334772451439*^9}, {3.900334842125585*^9, 
   3.9003348474601593`*^9}, {3.9003349302201757`*^9, 
   3.9003349790288057`*^9}, {3.900335023316833*^9, 3.9003351935452127`*^9}, {
   3.9003352241271067`*^9, 3.900335259462422*^9}, {3.9003352895092916`*^9, 
   3.900335416049757*^9}, {3.900335481346909*^9, 3.900335532916551*^9}, {
   3.900336561331726*^9, 3.900336562985169*^9}, {3.900336593971222*^9, 
   3.900336769343853*^9}, {3.9003368040647163`*^9, 3.9003368053439207`*^9}, {
   3.900336909661395*^9, 3.900337005127562*^9}, {3.9003370951318073`*^9, 
   3.900337136898678*^9}, {3.900337181328578*^9, 3.900337276598661*^9}, {
   3.900337307887*^9, 3.900337338920165*^9}, {3.900337973256772*^9, 
   3.900338043354267*^9}, {3.900338113754068*^9, 3.900338153802239*^9}, {
   3.900338187255007*^9, 3.900338187590827*^9}, {3.9003382284041853`*^9, 
   3.900338231370656*^9}, {3.900338268023943*^9, 3.900338289600753*^9}, {
   3.900338423787026*^9, 3.900338424635783*^9}, {3.900338470396657*^9, 
   3.900338473133354*^9}, {3.9003385231856318`*^9, 3.90033854242533*^9}, {
   3.9003386111164618`*^9, 3.9003386353882504`*^9}, {3.90033892276726*^9, 
   3.900338969259165*^9}, {3.9003390087800694`*^9, 3.9003390163616333`*^9}, {
   3.9003391048842487`*^9, 3.9003391048846493`*^9}, {3.9003391555575857`*^9, 
   3.9003391808691597`*^9}, {3.90033929279193*^9, 3.9003393373083477`*^9}, {
   3.900339483512981*^9, 3.900339515715581*^9}, {3.900339546816031*^9, 
   3.90033955620413*^9}, {3.900339645706365*^9, 3.900339650161151*^9}, {
   3.9003397339742804`*^9, 3.9003397341196003`*^9}, {3.900398553381487*^9, 
   3.900398579601697*^9}, {3.900419766638781*^9, 3.9004197714862747`*^9}, {
   3.900419802815733*^9, 3.900419836110716*^9}, {3.9004198755309353`*^9, 
   3.900419875532749*^9}, 3.900506413808758*^9, {3.9005064557832327`*^9, 
   3.900506460999734*^9}, {3.900506563441008*^9, 3.900506569543947*^9}, {
   3.900506629548106*^9, 3.900506636988081*^9}, {3.900506738013153*^9, 
   3.900506738716907*^9}, {3.900506768806546*^9, 3.900506769389222*^9}, {
   3.9005073343192797`*^9, 
   3.900507340575245*^9}},ExpressionUUID->"bc687e20-de13-474b-9290-\
b98724bf589c"],

Cell[TextData[{
 "\nInitial constraints:\n1) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "b4de4b59-230c-423d-8cd1-9400890c5042"],
 " (because ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "df745abc-8b25-4149-8d94-2d4723fd9d42"],
 " is a standard deviation)\n2)  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", " ", "c"}], ">", "1"}], TraditionalForm]],ExpressionUUID->
  "7283d02c-5abd-48f3-865d-d643b61fbfdc"],
 ", because  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{"b", " ", "c"}], "-", "1"}], "c"], "<=", "0"}]}], 
   TraditionalForm]],ExpressionUUID->"b04ffa91-ce96-4041-912d-38a6a53129aa"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", " ", "c"}], "<=", "1"}], TraditionalForm]],ExpressionUUID->
  "e3f692f0-84bd-4a84-8594-749fa57dd5c9"],
 ".\n3a) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "0", " "}], TraditionalForm]],ExpressionUUID->
  "24af5f1e-e6a1-4477-8f28-da363d20d9ea"],
 " because we take log of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "1296737f-d075-4724-87ae-efbf87521acb"],
 " (because ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "c7e892ef-a036-4a22-8ea1-4ec1d2f37569"],
 " is a risk value, i.e. a standard deviation).\n3b) Given ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "351b43ce-b5f8-4e4f-92a9-bdba2667f4a4"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", 
    FractionBox["1", "c"]}], TraditionalForm]],ExpressionUUID->
  "ba284bd9-9c37-4b4f-9afa-046ea79d994e"],
 ".\n4a) Because ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "ccadd26b-4172-4534-a235-6f0f0ed79dd2"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "1f13e828-c215-47ee-8aff-116d9600bd7d"],
 ", which follows from 2) and 3a).\n4b) Given ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "31be7c96-9ab4-4e2b-be78-ee7fbe6d45aa"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", 
    FractionBox["1", "b"]}], TraditionalForm]],ExpressionUUID->
  "89766271-d0d0-4788-a735-9c3b576fe5fc"],
 ", which follows from 2) and 3).\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "(", 
    RowBox[{"c", "(", 
     RowBox[{
      FractionBox[
       RowBox[{
        RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"], "-", " ", "x"}], 
     ")"}], ")"}], TraditionalForm]],ExpressionUUID->
  "1d643bab-6c28-4b45-a50e-fdab5ee3505d"],
 " is always positive, so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], ">", "0"}], TraditionalForm]],ExpressionUUID->
  "500e3d83-9b13-48d0-b14e-16a5b419130d"],
 ", when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", "-", 
     FractionBox[
      RowBox[{
       RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"]}], ">", 
    RowBox[{
     RowBox[{"0", " ", "\[DoubleLongLeftRightArrow]", "b"}], " ", "c"}], ">", 
    
    RowBox[{
     RowBox[{"b", " ", "c"}], "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "826b18e7-83c8-488c-a17c-846c5bc817a9"],
 ".\nSo there are no other constraints than the initial ones."
}], "Text",
 CellChangeTimes->{
  3.900339648821661*^9, {3.900339742174902*^9, 3.9003397462246027`*^9}, {
   3.900506773149963*^9, 3.900506773902216*^9}, {3.900507289477539*^9, 
   3.9005073063340893`*^9}, {3.900507352583786*^9, 3.900507489997663*^9}, {
   3.9007296187131367`*^9, 3.900729665680026*^9}, {3.9007297219786263`*^9, 
   3.900729729878419*^9}, {3.900729813346796*^9, 3.900729942504191*^9}, {
   3.900730144434523*^9, 3.900730231850027*^9}, {3.900730269459735*^9, 
   3.9007303469499893`*^9}, {3.9007303983714314`*^9, 3.900730520435429*^9}, 
   3.900730606124002*^9, {3.900730665120089*^9, 
   3.900730671892537*^9}},ExpressionUUID->"8f857553-18ca-42a1-a1e0-\
2a8d4a8a10db"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Note on the product log function", "Section",
 CellChangeTimes->{{3.900346234284408*^9, 3.900346246548719*^9}, {
  3.900346335831873*^9, 
  3.900346341662569*^9}},ExpressionUUID->"b57b8acb-2995-4e81-b119-\
8e79f233c183"],

Cell[TextData[{
 "To solve this problem we often run into situations where we need to solve \
equations of the general form\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"x", " ", 
      SuperscriptBox["\[ExponentialE]", "x"]}], "-", "1"}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"b2bc5157-9e6c-4a6f-a84a-f1ca8e5fbdbf"],
 ".\nThis has a solution which can not be expressed with elementary \
functions. The solution is the product log function \[Dash] or Lambert ",
 Cell[BoxData[
  FormBox["W", TraditionalForm]],ExpressionUUID->
  "6c6d3b40-fd60-44a3-827a-c56a0ff7cbd6"],
 " function.\n\nSee https://en.wikipedia.org/wiki/Lambert_W_function"
}], "Text",
 CellChangeTimes->{{3.9003462491664867`*^9, 3.900346250170882*^9}, {
  3.900346410953862*^9, 
  3.9003465652784843`*^9}},ExpressionUUID->"0a1d216a-ff96-4945-a1c7-\
37f78eedc58e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Scrap",
 FontColor->GrayLevel[0.85]]], "Section",
 CellChangeTimes->{{3.900732384918449*^9, 3.900732385654705*^9}, {
  3.9007324453849173`*^9, 
  3.900732448678823*^9}},ExpressionUUID->"b4d0f331-4676-4103-82a7-\
1bf0ac0fd04c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"log", "(", "b", ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", " ", "x"}], "-", "1"}], ")"}]}], ")"}], ")"}]], "+", 
     " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ExponentialE]", " ", "c", " ", "b", " ", 
         RowBox[{"log", "(", "b", ")"}]}], " ", "+", " ", "1"}], ")"}], 
      "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "896b104a-1d1d-4b69-a86b-8bb6c2c569a8"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", " ", 
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]]}], ")"}]}], "+", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"13314be4-ba2b-4740-9d15-b6bf59768819"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", "x", ")"}], "=", 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {
           RowBox[{"f", 
            RowBox[{"(", "x", ")"}]}], 
           RowBox[{
            RowBox[{"for", " ", "0"}], "<", "x", "<", 
            RowBox[{"1", "/", "c"}]}]},
          {"x", 
           RowBox[{
            RowBox[{"for", " ", "x"}], ">=", 
            RowBox[{"1", "/", "c"}]}]}
         },
         AllowedDimensions->{2, Automatic},
         Editable->True,
         GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
         GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
         GridBoxSpacings->{"Columns" -> {
             Offset[0.27999999999999997`], {
              Offset[0.84]}, 
             Offset[0.27999999999999997`]}, "Rows" -> {
             Offset[0.2], {
              Offset[0.4]}, 
             Offset[0.2]}},
         Selectable->True]}
      },
      GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
      GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
      GridBoxSpacings->{"Columns" -> {
          Offset[0.27999999999999997`], {
           Offset[0.35]}, 
          Offset[0.27999999999999997`]}, "Rows" -> {
          Offset[0.2], {
           Offset[0.4]}, 
          Offset[0.2]}}],
     "Piecewise",
     DeleteWithContents->True,
     Editable->False,
     SelectWithContents->True,
     Selectable->False,
     StripWrapperBoxes->True]}], TraditionalForm]],ExpressionUUID->
  "fcaf7da6-9656-4bb0-af6f-c79b1993d1c1"]
}], "Text",
 CellChangeTimes->{{3.9003984327124987`*^9, 3.900398476580019*^9}, {
  3.900398595108418*^9, 3.9003986034307957`*^9}, {3.9003988463179407`*^9, 
  3.9003988737031403`*^9}, {3.9004191013357553`*^9, 3.9004191097197247`*^9}, {
  3.90041917456161*^9, 3.900419237529207*^9}, {3.9004192739057713`*^9, 
  3.900419300410536*^9}, {3.900506163638538*^9, 3.900506167908842*^9}, {
  3.900686101278297*^9, 3.900686139902276*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"d87cc048-76cc-4255-911a-8ef1dbb1b407"],

Cell["Downward softknee limiter", "Text",
 CellChangeTimes->{{3.900732563023881*^9, 
  3.900732569224495*^9}},ExpressionUUID->"25ab49df-93c5-4987-8f23-\
73b27579c0ec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Delta]", "=", "1*^-12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maxc", "=", "10"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Chosen", " ", "maximum", " ", "value", " ", "of", " ", "c", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"not", " ", "theoretical", " ", "max"}], ",", " ", 
       RowBox[{
        RowBox[{
        "which", " ", "can", " ", "be", " ", "Inf", " ", "for", " ", "b"}], 
        "=", "1"}]}], ")"}], "."}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"maxx", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", " ", "b_", ",", " ", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"Log", "[", "b", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c", " ", "*", " ", "x"}], "-", "1"}], ")"}]}], "]"}], 
     ")"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", "*", 
       RowBox[{"Log", "[", "b", "]"}]}], "+", "1"}], ")"}], "*", 
    "x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "[", "x_", "]"}], ":=", "x"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", 
    RowBox[{"x_", ",", " ", "b_", ",", " ", "c_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
