Cell[CellGroupData[{

Cell["Derivation", "Chapter",
 CellChangeTimes->{{3.90047847192407*^9, 3.900478484995057*^9}, {
   3.9004814505122547`*^9, 3.900481450600335*^9}, {3.900583769972466*^9, 
   3.90058377335667*^9}, {3.900583831470009*^9, 3.900583832637801*^9}, 
   3.900732472112516*^9, {3.9007327429227543`*^9, 
   3.90073274545839*^9}},ExpressionUUID->"87a35d7b-d395-4c8c-87fd-\
9db3612a37f8"],

Cell[CellGroupData[{

Cell["Derivation of the downward limiter function, version 1", "Section",
 CellChangeTimes->{
  3.900643417616568*^9, {3.9008258998256474`*^9, 
   3.900825901361472*^9}},ExpressionUUID->"c36968d2-8026-492c-9e35-\
c3c0bf5b270e"],

Cell[TextData[StyleBox["See derivation of the upward limiter function below.",
 
 FontWeight->"Bold"]], "Text",
 CellChangeTimes->{{3.900732794762785*^9, 3.9007328044268007`*^9}},
 Background->RGBColor[
  1., 1., 0.85],ExpressionUUID->"38e1e28a-009d-4995-b528-d432ded78d12"],

Cell[TextData[{
 "We want to limit risk (standard deviation) downward.\nBelow ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "345a8cd6-bc87-49e0-8864-0e3d523a78e5"],
 ", limit y with a function, ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "7205fbcd-2ec1-46e0-b76e-577a7138c90c"],
 ", such that ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "9694b9f7-a0f1-4894-98fb-a42a0eff68fb"],
 " approaches a limit, ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "49223f53-9b43-47e2-b985-8ca81b52f849"],
 ", as ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "728d30b1-ba47-470b-bbb3-702274dabf30"],
 " approaches 0 from above.\nAbove ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "5c51d379-d881-4cb1-aa1c-50cae454a63e"],
 ", we want the input ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "10106698-1222-4ce4-bc4c-a0c6254b86c5"],
 " to pass unchanged to the output ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "79184cc7-3b1b-44fb-bc4d-ae5c32369432"],
 ", i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], " ", "=", " ", "x"}], TraditionalForm]],
  ExpressionUUID->"e7702218-0c7a-4c41-9114-943d70b4a837"],
 ". \nSo we want to construct a piecewise function which is equal to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "272a0f2e-c40f-4528-8abe-06ec781cf72f"],
 " below ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "f51e1819-4a72-4324-8bd6-1196828b8ceb"],
 " and equal to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "8339bc5a-b2f5-495c-b132-adeed70bd0d1"],
 " above ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "5c507dd2-1212-4e1f-9d0b-30bfbb167f3b"],
 ".\nInitial idea for ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "5d73ce1b-5915-4fd5-b566-7cf50f14b049"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9004882272636127`*^9, 3.9004882409414597`*^9}, {
  3.900583863049191*^9, 3.900583943456339*^9}, {3.9006452817404423`*^9, 
  3.900645326804406*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"78cab81d-7249-4087-a5b6-e8760e4f9a87"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "81368054-3aa8-4c5f-97a7-c3e8c56f2e0a"],
 " should tend to the limit ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "e7209052-3d04-48cd-a77e-c26d5b976b01"],
 ", as ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "476f5184-1537-4a20-8751-115dadd82ca1"],
 " tends to ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "8976d181-6aec-45cb-bdc3-a223baf12e44"],
 " from above.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "71d6a5d1-33a6-401f-858c-9cdd5dd55096"],
 " should tend to 0, as ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "50295886-161a-4aeb-90a8-7b4aacfe07cc"],
 " tends to ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "8d41d5d6-158f-4d33-9948-307a8ef2dd75"],
 " from above.\n\nThis gives us the following idea:"
}], "Text",
 CellChangeTimes->{{3.90039788499474*^9, 3.900397983581708*^9}, {
  3.900398135120605*^9, 3.900398144770084*^9}, {3.900398253101708*^9, 
  3.900398279671317*^9}, {3.9004926547924232`*^9, 3.900492708665297*^9}, {
  3.900492752803659*^9, 3.9004927765974007`*^9}, {3.9004928161840763`*^9, 
  3.90049295370513*^9}, {3.9004944786204443`*^9, 3.900494496389407*^9}, {
  3.900584088005245*^9, 3.900584131582625*^9}, {3.900643584694977*^9, 
  3.900643704584837*^9}, {3.900643739006867*^9, 3.900643740200976*^9}, {
  3.900645337617846*^9, 3.9006453383124037`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"6e56abda-f7e4-4379-b7a6-2d1c1e65975d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "a"}], ",", " ", "b"}], ")"}], "=", 
    StyleBox[
     FractionBox["a", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"log", "(", "b", ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "a"}], ")"}], " "}]]],
     FontSize->20]}], TraditionalForm]],ExpressionUUID->
  "4ecb3b5e-f458-40eb-aa2f-142e39782c9f"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", ";", " ", "a"}], ",", " ", "b"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"-", "a"}], " ", 
     RowBox[{"log", "(", "b", ")"}], " ", 
     SuperscriptBox["b", 
      RowBox[{"a", "-", "x"}]]}]}], TraditionalForm]],ExpressionUUID->
  "a17c7e72-17e9-4143-b343-29d2a38f02b4"]
}], "Text",
 CellChangeTimes->{{3.900487673076721*^9, 3.900487725501163*^9}, {
   3.900488549898467*^9, 3.90048854989853*^9}, {3.9005841798556633`*^9, 
   3.900584217434085*^9}, 3.900584505481124*^9, {3.900588706091732*^9, 
   3.900588757875146*^9}, {3.9005889511393948`*^9, 3.900588978313716*^9}, {
   3.900643921682272*^9, 3.900643921684287*^9}, {3.9006439698288927`*^9, 
   3.900643969829009*^9}, {3.900644814563899*^9, 3.9006448753000107`*^9}, {
   3.9006449736534443`*^9, 3.90064497462952*^9}},
 FontColor->GrayLevel[0],
 Background->GrayLevel[
  1],ExpressionUUID->"17ee63b2-b8a0-44f6-bbc9-a8fe8fc775c4"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", "x", ")"}], "=", "x"}], TraditionalForm]],
  ExpressionUUID->"b7716194-88c9-4fd7-b29d-1fdb7f545c89"],
 ", it must be true that in the point where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "952f2124-14e4-4bec-9f37-407308709553"],
 " meets ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "2e00c5f7-3386-4619-8d98-dc0f699f00b4"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "a", ")"}], "=", "a"}], TraditionalForm]],
  ExpressionUUID->"450772fa-114a-4f41-9ac2-30b39a306831"],
 "."
}], "Text",
 CellChangeTimes->{3.900644792615428*^9},
 Background->GrayLevel[
  1],ExpressionUUID->"843c67cf-ba7c-46e3-9cdd-5491a7527e60"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f1", "[", 
   RowBox[{"x_", ",", " ", "a_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{"a", "/", 
   RowBox[{"(", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"Log", "[", "b", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"x", "-", "a"}], ")"}]}], "]"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.900293194839884*^9, 3.900293247824238*^9}, {
   3.900293335219287*^9, 3.900293337610111*^9}, {3.900293412962286*^9, 
