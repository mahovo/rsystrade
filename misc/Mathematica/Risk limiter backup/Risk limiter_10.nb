Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"a88ed301-3e7c-49c4-ac9f-f211437e7efb"],
 "  is not monotonically increasing in ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "60601719-03bc-4a5c-892c-70fafab8e7b1"],
 ".\n\nSo for which extreme value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "5e23d2d5-f529-47b4-acd5-e9da01835e69"],
 " should we solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"138d946b-b0ad-4a36-b86a-dc1d2caa253f"],
 " for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "e3774a89-38e7-4984-9a88-3b6a07998833"],
 "? 0 or \[Infinity]?\n\nFor positive values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "294ef6d6-3332-41f9-b496-4a90b1542a11"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "48c4f987-d572-48a0-a370-0a9b6abbbd53"],
 " ",
 StyleBox["is ",
  FontWeight->"Bold"],
 "increasing in ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7ab06def-18a2-40e7-b9ad-beb92560a050"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74abf2ff-06d1-4234-a981-e52d48b617c3"],
 " eventually exceeds 1 for all values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18dc4e80-c71b-43a3-b1aa-7d405d05aabb"],
 ", if we increase ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4408381d-8a83-42d3-bb01-785727e204e9"],
 " enough.\n\nSince we have an upper constraint on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"27b215f5-d5a9-4c25-9fef-0d27f399622e"],
 ", the \[OpenCurlyDoubleQuote]worst case\[CloseCurlyDoubleQuote] is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "0a065643-215b-4c29-8868-95e890178734"],
 ". As the plot suggests, the higher the value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c6ef4714-3403-4e0d-82a9-115ab0d8e3ba"],
 ", the sooner \[Tau](x; b, c) will reach the limit of 1, as ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a4582cc1-4a5a-4b66-a6c7-89bf8a4e39ab"],
 " increases.\n\nLook at the constraint again:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", " ", "-", 
        SuperscriptBox["b", 
         RowBox[{
          RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"b100c1da-659d-4841-8ca0-48434b3a313e"],
 "\n\nFor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1dfd3453-2dcf-4a23-b632-753a93172720"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "567c0683-ff88-4bab-81b4-7ab3b2b38fb9"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["b", 
      RowBox[{
       RowBox[{"-", "c"}], " ", "x"}]]}], "->", 
    RowBox[{"-", "\[Infinity]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "164e77ff-4354-40f7-9266-325400a27c6a"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "61e3ecf5-84e8-458e-8fb6-b59f12eb213a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", " ", "b", " ", 
     RowBox[{"log", "(", "b", ")"}]}], "<", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e57ef08-17fa-4ba2-88fd-2e9ab391b2bf"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", " ", "b", " ", 
     RowBox[{"log", "(", "b", ")"}], 
     RowBox[{"(", 
      RowBox[{"\[ExponentialE]", " ", "-", 
       SuperscriptBox["b", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "->", "\[Infinity]"}], 
   TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2c14cdfb-09e9-46f1-a2d0-46906bb8ece7"],
 ".\n\nIn short:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "->", 
    "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b1571be8-e3a3-4d81-b790-c48d6b80f5d5"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ca39e670-f48a-4164-998e-49eb1518cf3e"],
 " for all values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5711c8ef-31e3-4456-9611-e46db6fb7384"],
 ".\n\nIn the extreme case, where ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7fd03218-64cf-4fb3-8905-4badf56ab6b6"],
 " is extremely high, no value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6d26d07a-8be6-4186-b4b2-fc809127e18e"],
 " will be valid.\nSo we need to determine a practical range of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3a64062c-29bd-4888-97d5-1c5582bce8cf"],
 ". For this we need heuristics."
}], "Text",
 CellChangeTimes->{
  3.9004212622241163`*^9, {3.900421837281644*^9, 3.9004218835215693`*^9}, 
