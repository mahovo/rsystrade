 Background->RGBColor[1, 0.85, 0.85],
 CellLabel->
  "Out[1282]=",ExpressionUUID->"e22dff2c-620e-4b20-890a-d81fed6ac479"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"c", " ", "x"}]}], ")"}]]}]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"e58ccf3c-dcec-41b8-a47b-fda268e089ce"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLeftRightArrow]", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"c", " ", "x"}]}], ")"}]}]}]}], "=", 
    RowBox[{"d", "-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "4dde58d4-f2fe-4d0d-91a8-dca4572e820c"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLeftRightArrow]", " ", 
     RowBox[{"b", "^", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}], ")"}]}]}], "=", 
    FractionBox[
     RowBox[{"d", "-", "1"}], 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}]}]]}], TraditionalForm]],ExpressionUUID->
  "3103c313-308b-4639-a517-083f76bfcb79"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLeftRightArrow]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}], ")"}], 
      RowBox[{"log", "(", "b", ")"}]}]}], "=", 
    RowBox[{"log", "(", 
     FractionBox[
      RowBox[{"d", "-", "1"}], 
      RowBox[{"c", " ", 
       RowBox[{"log", "(", "b", ")"}]}]], ")"}]}], TraditionalForm]],
  ExpressionUUID->"4a895553-032c-4177-9270-5f60cbd32e54"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLeftRightArrow]", 
     RowBox[{"1", "-", 
      RowBox[{"c", " ", "x"}]}]}], "=", 
    FractionBox[
     RowBox[{"log", "(", 
      FractionBox[
       RowBox[{"d", "-", "1"}], 
       RowBox[{"c", " ", 
        RowBox[{"log", "(", "b", ")"}]}]], ")"}], 
     RowBox[{"log", "(", "b", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "295785a6-99f2-490c-992c-06b35dad19ff"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLeftRightArrow]", "x"}], "=", 
    RowBox[{
     FractionBox["1", "c"], "-", 
     FractionBox[
      RowBox[{"log", "(", 
       FractionBox[
        RowBox[{"d", "-", "1"}], 
        RowBox[{"c", " ", 
         RowBox[{"log", "(", "b", ")"}]}]], ")"}], 
      RowBox[{"c", " ", 
       RowBox[{"log", "(", "b", ")"}]}]]}]}], TraditionalForm]],
  ExpressionUUID->"a2d947ca-b94a-437d-b7de-085888786b52"]
}], "Text",
 CellChangeTimes->{{3.900600826380653*^9, 3.9006009145712357`*^9}, {
  3.9006009595724154`*^9, 3.900600991267922*^9}, {3.9006010285349283`*^9, 
  3.900601072952023*^9}, {3.900602001985278*^9, 3.900602259051059*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"9b598f68-8ba0-4c79-b03b-5c5a0e7ccdfe"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"log", "(", "b", ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", " ", "x"}], "-", "1"}], ")"}]}], ")"}], ")"}]], "+", 
     " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", " ", 
         RowBox[{"log", "(", "b", ")"}]}], " ", "+", " ", "1"}], ")"}], 
      "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "02b2e292-5719-4a46-9aae-f39896086437"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", " ", 
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]]}], ")"}]}], "+", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"e9468fdf-6868-478f-ae81-048d9230fff7"]
}], "Text",
 CellChangeTimes->{
  3.900594250663793*^9, {3.90059678037891*^9, 3.9005967863468227`*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"73f22e7e-cc2d-4441-998f-a6765f0009d7"],

Cell[TextData[{
 "The slope of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "09b73c72-7be5-472d-a534-6a181893dbc4"],
 " is 1 when\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", " ", 
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]]}], ")"}]}], "+", "1"}], "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"e072e89a-532a-4db5-9ad0-22b7f902c023"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLongLeftRightArrow]", 
     SuperscriptBox["b", 
      RowBox[{"1", "-", 
       RowBox[{"c", " ", "x"}]}]]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"599f4147-e19d-4b3c-a3ec-a7e50ee461a6"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[DoubleLongLeftRightArrow]", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}], ")"}]}], " ", 
     RowBox[{"log", "(", "b", ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"95f436bb-efcb-4764-8dec-ff1871570a14"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[DoubleLongLeftRightArrow]", "1"}], "-", 
     RowBox[{"c", " ", "x"}]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "10a356af-689d-445d-af44-d308a3c367d4"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLongLeftRightArrow]", "x"}], "=", 
    RowBox[{"1", "/", "c"}]}], TraditionalForm]],ExpressionUUID->
  "f51db69a-f7d0-4025-95f1-3fd845dfa585"]
}], "Text",
 CellChangeTimes->{{3.900575058889161*^9, 3.90057508622003*^9}, {
  3.9005755635526953`*^9, 3.900575659869409*^9}, {3.900575690318159*^9, 
  3.900575782353385*^9}, {3.900575817219459*^9, 3.900575831746729*^9}, {
  3.9005964843476553`*^9, 3.9005964860026073`*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"8fe15ec0-491b-4fed-932b-28c8789569bb"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "0", ")"}], "=", "b"}], TraditionalForm]],
  ExpressionUUID->"f800182d-f935-4cdd-b58f-0c7c946a17e0"],
 " as it is supposed to be."
}], "Text",
 CellChangeTimes->{{3.900596510059524*^9, 3.900596527579033*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"f73a6127-3178-4f47-80dd-2c6dff309cc2"],

Cell[TextData[{
 "But \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"1", "/", "c"}], ")"}], "=", 
    RowBox[{"1", "+", " ", 
     RowBox[{"log", "(", "b", ")"}], " ", "+", " ", 
     RowBox[{"1", "/", "c"}]}]}], TraditionalForm]],ExpressionUUID->
  "1d82b660-5115-4462-96d2-e4e5fa8e2fa8"],
 "\nwhich is not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "c"}], TraditionalForm]],ExpressionUUID->
  "fa484b08-0410-43f6-b1db-086ceef727c4"],
 "!"
}], "Text",
 CellChangeTimes->{{3.90059387679963*^9, 3.900593903721713*^9}, {
  3.900593933841667*^9, 3.900593978114705*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"aa2d99b7-9eb1-47ab-b417-8b7735dd67d7"],

Cell[TextData[{
 "This is ok:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"log", "(", "b", ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c", " ", "x"}], "-", "1"}], ")"}]}], ")"}], ")"}]]}], 
   TraditionalForm]],ExpressionUUID->"d29c4d4a-d627-48b3-99f3-8c9bfb2db2ec"],
 "\n\nAdding a term creates the problem:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"log", "(", "b", ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", " ", "x"}], "-", "1"}], ")"}]}], ")"}], ")"}]], "+", 
     "dx"}]}], TraditionalForm]],ExpressionUUID->
  "d20e8bca-7fd8-44f7-b973-5083d7c9a643"],
 "\n\n"
}], "Text",
 CellChangeTimes->{{3.900596792809751*^9, 3.9005968031234827`*^9}, {
  3.90059693383937*^9, 3.9005969351775513`*^9}, {3.900597511606536*^9, 
  3.9005975116065807`*^9}, {3.900597605929076*^9, 3.900597617184376*^9}, {
  3.9005977941499166`*^9, 3.900597798189982*^9}, {3.900597896864335*^9, 
  3.900597903241185*^9}, {3.900598002290803*^9, 3.900598002489513*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"65fa5b23-4b4d-40e8-aeee-cfaed9c65645"],

Cell[CellGroupData[{

Cell["Constraints", "Subsubsection",
 CellChangeTimes->{
  3.900339680165222*^9},ExpressionUUID->"9316726e-3493-44c0-a138-\
52227b051a9d"],

Cell[TextData[{
 StyleBox["Note: This section is based on a wrong expression of ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox["d", TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"fc5be48b-e491-4b4f-8ea8-80927a9c4752"],
 StyleBox["!",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.900646975773984*^9, 3.900646978084992*^9}, {
  3.9006478875116653`*^9, 3.9006479121682034`*^9}},
 Background->RGBColor[
  1., 1., 0.85],ExpressionUUID->"0ed98b47-b326-414c-94ec-2d31dc004549"],

Cell[TextData[{
 "This works. We just need to find the valid parameter ranges for b and c.\n\
These will be ones where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "'"}], TraditionalForm]],ExpressionUUID->
  "27752da5-ee54-47f0-9ba0-639a6576c6ba"],
 " is always positive for positive values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "cfb4fbe7-471a-495f-b645-2f8f5d09d07d"],
 ".\nSo, we have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"76184c90-cf48-46e2-ad0b-27edbc4e88b9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}]}], "+", "1"}]}], TraditionalForm]],
  ExpressionUUID->"42463aa8-0fc3-42b8-a3f0-8037e7fefd30"],
 ", and we need:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]]}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"log", "(", "b", ")"}]}], "+", "1", "-", 
      RowBox[{"c", " ", 
       RowBox[{"log", "(", "b", ")"}], " ", 
       SuperscriptBox["b", 
        RowBox[{"1", "-", 
         RowBox[{"c", " ", "x"}]}]]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"c", " ", 
        RowBox[{"log", "(", "b", ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", " ", 
          SuperscriptBox["b", 
           RowBox[{"1", "-", 
            RowBox[{"c", " ", "x"}]}]]}], ")"}]}], "+", "1"}], ">", " ", "0", 
      " "}]}]}], TraditionalForm]],ExpressionUUID->
  "2d287069-900b-4b6e-96fd-5838bf4a9571"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[DoubleLongLeftRightArrow]", "c"}], " ", 
     RowBox[{"log", "(", "b", ")"}], 
     RowBox[{"(", " ", 
      RowBox[{
       SuperscriptBox["b", 
        RowBox[{"1", "-", 
         RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "<", " ", "1", 
    " "}], TraditionalForm]],ExpressionUUID->
  "289d795c-a2bb-4241-8031-4d11d1102354"],
 "\n\nLet\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{"c", " ", 
     RowBox[{"log", "(", "b", ")"}], 
     RowBox[{"(", " ", 
      RowBox[{
       SuperscriptBox["b", 
        RowBox[{"1", "-", 
         RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"96552941-1574-4dac-a315-8e358bf37d46"]
}], "Text",
 CellChangeTimes->CompressedData["
1:eJwlzn8s1HEcx3GaML9Ku0x2iXXszm9LdH4rPxoiP8JIdFydoxxRl/y4/OqH
