 "\n\nConstraint:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     StyleBox[
      RowBox[{"b", " ", 
       RowBox[{"log", "(", "b", ")"}], 
       RowBox[{"(", 
        RowBox[{"\[ExponentialE]", "-", "\[Infinity]"}], ")"}]}],
      FontSize->14]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05fc6493-5898-4e79-97b1-97bda6bdcb8d"],
 "\n\nFor implementation we replace the theoretical maximum possible ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "07cd339d-2517-4e0a-b7fc-e89110d35d8a"],
 "-value, ",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "87c6e672-809a-4193-89c6-f0b672a970b9"],
 ", with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "extreme"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "82bd5e75-eb84-4175-93d8-505e2a77c32e"],
 ". In practice, this value is chosen heuristically. The trade-off is that \
the higher the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "extreme"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4d8a42d1-6075-42cc-8ed6-1b88b88eef19"],
 ", the more narrow the valid range of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "ce8f9665-aa19-486b-8bee-b2dda9ee0f6a"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "extreme"], "=", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "25411dc7-6d9a-4ee9-b806-b00bf3f6a711"],
 " there will be no valid value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "26bca474-e8c8-4bac-9623-7b03ba7ae0b1"],
 ". For values of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "extreme"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "11fb3d2d-6e9a-4d89-aacd-416dc8b7aebc"],
 " very close to ",
 Cell[BoxData[
  FormBox["\[ExponentialE]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dbad100e-2ad5-4799-b0e5-92d71eeeb559"],
 ", the max value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b41498a7-5410-4fbb-a67e-11322b9948fa"],
 " can get very big, and the resulting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "18eceb2f-e918-4d6d-8422-0592a5c04a83"],
 " may have negative slope for some values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d1035c4b-9245-415c-a519-17dc97ff7287"],
 ".\n\nFor ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bb9e86ff-e476-4fa9-85d9-7093f4a8a43c"],
 " values close to 1, ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0501c61b-33ea-4f57-a0af-cc4f3ca04e45"],
 " can get very big. \n\nFor implementation it can be a good idea to impose a \
maximum ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40beeba0-549c-43e5-849e-56b3551041f0"],
 " value. But this is a bit tricky, because the most useful value will depend \
on ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c0998ade-2b54-4c59-a378-38607ca08757"],
 "."
}], "Text",
 CellChangeTimes->{{3.900425077533064*^9, 3.900425154167832*^9}, {
  3.900425201728876*^9, 3.900425225137726*^9}, {3.9004259331509666`*^9, 
  3.900425947552602*^9}, {3.900649356281088*^9, 3.9006493714991293`*^9}, {
  3.900649536471546*^9, 3.900649561495467*^9}, {3.900649595352298*^9, 
  3.900649617490563*^9}, {3.900650210536124*^9, 3.900650247608173*^9}, {
  3.900680639360813*^9, 3.900680640169045*^9}, {3.900680955331485*^9, 
  3.900680956140126*^9}, {3.900681380408497*^9, 3.9006813843589087`*^9}, {
  3.900733898846386*^9, 3.900733907377675*^9}, {3.9007502495431747`*^9, 
  3.900750249889592*^9}, {3.900750284665146*^9, 3.900750376642542*^9}, {
  3.900750449875119*^9, 3.9007505085878973`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"4bdeb9bb-4b73-40d3-b2e7-22dd0a2973fb"],

Cell[TextData[{
 "We set ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "cd445cf2-99a0-4a7a-b7b7-2e51276db270"],
 " to a very high number which is effectly ",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "03ac8a71-ac8c-441e-8848-afcf9cd77fe2"],
 ". We find that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "1000000"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8fd4dc28-fe5c-4e02-8b02-50c9ad610b51"],
 " is a reasonable extreme value:"
}], "Text",
 CellChangeTimes->{{3.9006629538296013`*^9, 3.900663012294491*^9}, {
  3.900681393222427*^9, 3.90068139534144*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"58a165a9-4e10-4cc6-a277-7903eaeaf2ad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "b", ",", "c"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "0.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xtreme", "=", "1000000"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tauinf", "[", 
     RowBox[{"b_", ",", " ", "c_"}], "]"}], ":=", " ", 
    RowBox[{"c", " ", "*", " ", "b", "*", 
     RowBox[{"Log", "[", "b", "]"}], "*", 
     RowBox[{"(", 
      RowBox[{"E", " ", "-", " ", "xtreme"}], ")"}]}]}], "*)"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"c", "*", "E"}], "-", 
       RowBox[{"c", "*", 
        RowBox[{"b", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "c"}], "*", "x"}], ")"}]}]}]}], "==", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"b", "*", 
         RowBox[{"Log", "[", "b", "]"}]}], ")"}]}]}], ",", "c", ",", 
     "Reals"}], "]"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"tauinf", "[", 
       RowBox[{"b", ",", " ", "c"}], "]"}], "==", "1"}], ",", "c", ",", 
     "Reals"}], "]"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"1", "/", 
  RowBox[{"(", " ", 
   RowBox[{"b", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{"E", " ", "-", " ", "xtreme"}], ")"}]}], ")"}]}]}], "Input",
 CellChangeTimes->{{3.900676652404319*^9, 3.9006766526997766`*^9}, {
  3.900677493228257*^9, 3.900677496461212*^9}, {3.900681443789997*^9, 
  3.90068149619799*^9}, {3.900681872707005*^9, 3.900681873019599*^9}, {
  3.9007335917083607`*^9, 3.900733592917897*^9}, {3.9007336263004103`*^9, 
  3.900733645173675*^9}},
 Background->GrayLevel[1],
 CellLabel->
  "In[1126]:=",ExpressionUUID->"c0b44864-2af8-453f-b44c-5e13508664ee"],

Cell[BoxData[
 FormBox["3.1066831176383248`*^-6", TraditionalForm]], "Output",
 CellChangeTimes->{3.900681497302289*^9, 3.9006818739486923`*^9, 
  3.900733648397999*^9, 3.900752077583301*^9, 3.900839393232562*^9},
 Background->GrayLevel[1],
 CellLabel->
  "Out[1129]=",ExpressionUUID->"c5023cc6-09df-4d81-be5d-9eaa6951c20b"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "->", 
    "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5b32d5ca-3361-4cfa-a9ee-80303f3fffc4"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5839e5c5-7425-4d09-9248-cb58365f35f8"],
 " for all values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5170f98f-88cf-4494-8408-22e6af09d2e4"],
 ".\n\nThis means that the max value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f37ccea-6418-4428-90cb-58e4369ae91f"],
 " goes to ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d1b3746e-4dd5-4584-a27c-6dbc55d768e7"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "836ae1af-5424-4d63-bd37-af20de409a98"],
 ", for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a2382aa-3bf9-48e2-9a98-395fc7ff00b3"],
 ".\n\nIn the extreme case, where ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8f714056-6eff-409f-bd38-b4ba42701a9b"],
 " is extremely high, no value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6985e0e3-f64b-41ee-ac39-7e6f60d3a2a8"],
 " will be valid.\n\nSo we need to determine a practical range of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f90359ed-d65e-4920-8f96-e98c02c32511"],
 ". For this we need heuristics."
}], "Text",
 CellChangeTimes->{{3.9006775227886877`*^9, 3.900677533917569*^9}, 
   3.9006776203435698`*^9, 3.900681358266406*^9, {3.900681525933971*^9, 
   3.900681597280211*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"a4721a3b-6530-4300-83e5-db1233ffa211"],

Cell[TextData[{
 "If the practical use case is ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2b0d39ac-f82b-4f62-81a6-c221ccf0d075"],
 " representing risk of daily returns as a standard deviation, a max ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a85fb7a6-d959-4c1c-8671-792391b2a199"],
 " value of 1 should be extremely high. Let\[CloseCurlyQuote]s multiply that \
by 100. Let\[CloseCurlyQuote]s also pick a more realistic ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1c117d0a-3a78-4871-ad1e-b6c63e3441db"],
 " value of 0.001."
}], "Text",
 CellChangeTimes->{{3.900681658014388*^9, 3.9006817415288887`*^9}, {
  3.9006817790005627`*^9, 3.900681847377612*^9}, {3.900681914994854*^9, 
  3.900681940188003*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"bb9b739e-2218-41f9-9e9b-9fea241d7ff3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "b", ",", "c"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "0.001"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xtreme", "=", "10"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tauinf", "[", 
     RowBox[{"b_", ",", " ", "c_"}], "]"}], ":=", " ", 
    RowBox[{"c", " ", "*", " ", "b", "*", 
     RowBox[{"Log", "[", "b", "]"}], "*", 
     RowBox[{"(", 
      RowBox[{"E", " ", "-", " ", "xtreme"}], ")"}]}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"c", "*", "E"}], "-", 
       RowBox[{"c", "*", 
        RowBox[{"b", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "c"}], "*", "x"}], ")"}]}]}]}], "==", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"b", "*", 
         RowBox[{"Log", "[", "b", "]"}]}], ")"}]}]}], ",", "c", ",", 
     "Reals"}], "]"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"tauinf", "[", 
       RowBox[{"b", ",", " ", "c"}], "]"}], "==", "1"}], ",", "c", ",", 
     "Reals"}], "]"}], "*)"}]}], "\n", 
 RowBox[{"1", "/", 
  RowBox[{"(", " ", 
   RowBox[{"b", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{"E", " ", "-", " ", "xtreme"}], ")"}]}], ")"}]}]}], "Input",
 CellChangeTimes->{{3.900676652404319*^9, 3.9006766526997766`*^9}, {
  3.900677493228257*^9, 3.900677496461212*^9}, {3.900681443789997*^9, 
  3.90068149619799*^9}, {3.900681857082623*^9, 3.900681911395865*^9}, {
  3.900733561349571*^9, 3.9007335736339693`*^9}},
 Background->GrayLevel[1],
 CellLabel->
  "In[1130]:=",ExpressionUUID->"91cdd236-6afd-433f-a5d1-4addc726e8cf"],

Cell[BoxData[
 FormBox["19.88058640704696`", TraditionalForm]], "Output",
 CellChangeTimes->{{3.900681878300476*^9, 3.900681912079207*^9}, {
   3.900681961213677*^9, 3.900681965548223*^9}, 3.9007335215417013`*^9, 
   3.900733577787085*^9, 3.900752080012995*^9, 3.900839393258452*^9},
 Background->GrayLevel[1],
 CellLabel->
  "Out[1133]=",ExpressionUUID->"bc9f3f6e-5c9e-4243-8d73-416cc90bd005"]
}, Open  ]],

Cell[TextData[{
 "This gives us a maximum ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "600ce0fd-45e5-461b-9653-936f7c83a2a8"],
 " value of 19.88."
}], "Text",
 CellChangeTimes->{{3.9006819702360783`*^9, 3.90068198514053*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"79f14bb7-8a29-41e8-80a8-abe4728cb3e2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "b", ",", "c"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xtreme", "=", "10"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauinf", "[", 
    RowBox[{"b_", ",", " ", "c_"}], "]"}], ":=", " ", 
   RowBox[{"c", " ", "*", " ", "b", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{"E", " ", "-", " ", 
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "c"}], "*", "xtreme"}], ")"}]}]}], ")"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cmax", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"tauinf", "[", 
          RowBox[{"b", ",", " ", "c"}], "]"}], "==", "1"}], ",", "c", ",", 
        "Reals"}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "cmax", "\[IndentingNewLine]", 
 RowBox[{"b", "^", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "cmax"}], "*", "xtreme"}], ")"}]}]}], "Input",
 CellChangeTimes->{{3.900676652404319*^9, 3.9006766526997766`*^9}, {
  3.900677493228257*^9, 3.900677496461212*^9}, {3.900681443789997*^9, 
  3.90068149619799*^9}, {3.900681857082623*^9, 3.900681911395865*^9}, {
  3.900733561349571*^9, 3.9007335736339693`*^9}, {3.900750677705863*^9, 
  3.90075070696979*^9}, {3.900750768211945*^9, 3.900750807254222*^9}, {
  3.900750839127339*^9, 3.9007509310406227`*^9}, {3.900750985012212*^9, 
  3.900751019187441*^9}},
 Background->GrayLevel[1],
 CellLabel->
  "In[1134]:=",ExpressionUUID->"3c8a4aaf-bf89-45c3-8ad3-657f64204c24"],

Cell[BoxData[
 FormBox["0.15005259779632657`", TraditionalForm]], "Output",
 CellChangeTimes->{{3.9007509202493963`*^9, 3.900750931486014*^9}, {
