Cell[TextData[{
 "Now we need to find the point where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "a", ")"}], "=", "a"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4388ba89-eead-417b-abf4-2cd598a51e98"],
 ". At this point, ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "900b82ac-1459-4570-9549-ad02fed18568"],
 " will touch ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "4a39da4a-4526-4816-a048-a82adf85beef"],
 " (though not necessarily be tangent). For this we modify ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0026f103-63f2-49cb-9003-5d0f12a99145"],
 " slightly:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "a"}], ",", " ", "b", ",", " ", "c"}], ")"}], 
    "=", 
    RowBox[{"b", "-", 
     FractionBox[
      RowBox[{"b", "-", "a"}], 
      RowBox[{"exp", "(", 
       RowBox[{"c", " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", "a"}], ")"}]}], ")"}]]}]}], TraditionalForm]],
  ExpressionUUID->"841ad82a-2133-4fdd-8bfa-942fb3d6693b"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"b", "-", "a"}], ")"}], " ", 
     RowBox[{"exp", "(", 
      RowBox[{"c", "(", 
       RowBox[{"a", "-", " ", "x"}], ")"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05d43ceb-570d-4208-a2f3-932a55cb6573"]
}], "Text",
