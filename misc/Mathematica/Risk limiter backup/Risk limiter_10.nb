Cell[CellGroupData[{

Cell["Soft knee downward limiter function, version 3", "Subsection",
 CellChangeTimes->{{3.9003983929845448`*^9, 3.9003983969289827`*^9}, {
  3.900481268777191*^9, 3.900481270848681*^9}, {3.9008386020034103`*^9, 
  3.900838603499311*^9}, {3.900845658325346*^9, 
  3.900845658453526*^9}},ExpressionUUID->"8c9b1322-39d1-4f4b-8588-\
65d4b0b141dc"],

Cell[TextData[{
 "The idea here is to connect the horizontal line ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "b"}], TraditionalForm]],ExpressionUUID->
  "79af2bc8-e908-48d0-9ef9-15bbbe1cec5a"],
 " with the \[OpenCurlyDoubleQuote]bypass\[CloseCurlyDoubleQuote] line ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "x"}], TraditionalForm]],ExpressionUUID->
  "bc4f06c6-a5e7-4f29-9532-f70d9b0d1faa"],
 " by a suitable section of the line ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"y", "\[Congruent]", 
     RowBox[{"f", "(", 
      RowBox[{
       RowBox[{"x", ";", " ", "a"}], ",", " ", "c"}], ")"}]}], "=", 
    SuperscriptBox[
     RowBox[{"a", "(", 
      RowBox[{"x", "-", "c"}], ")"}], "2"]}], TraditionalForm]],
  ExpressionUUID->"f62f556c-1b74-44b8-a4cf-b854c6f0f0c5"],
 ":"
}], "Text",
 CellChangeTimes->{{3.900845842407481*^9, 3.900846077100492*^9}, 
   3.9008466077746143`*^9, {3.9008524632577477`*^9, 3.900852465265874*^9}, {
   3.90085319287106*^9, 3.9008532219441137`*^9}, {3.9008534891293573`*^9, 
   3.9008535134420433`*^9}, {3.900854402769335*^9, 3.900854402832375*^9}, {
   3.900854606230729*^9, 
   3.90085461479862*^9}},ExpressionUUID->"1495bcce-67b4-4f68-a39d-\
3073924a1f2c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "a"}], ",", " ", "c"}], ")"}], " ", "=", 
    RowBox[{"a", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", "c"}], ")"}], "2"]}]}], TraditionalForm]],
  ExpressionUUID->"7385eec0-1c35-4bef-96f6-cfba298bbbfb"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", ";", " ", "a"}], ",", " ", "c"}], ")"}]}], "=", 
    RowBox[{"2", 
     RowBox[{"a", "(", 
      RowBox[{"x", "-", "c"}], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "85cd903b-e44a-4db2-836c-b30558a8c851"],
 "\n\nThe slope of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "806020da-62d5-4d19-85ce-b7100ed9997c"],
 " is 1 when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", 
     RowBox[{"a", "(", 
      RowBox[{"x", "-", "c"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"1", "\[DoubleLeftRightArrow]", "x"}], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", "a"}]], "+", "c"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a006e8e5-63ed-4dd9-8743-e7ad76ffa5a2"],
 " \nThe slope of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "de3c5707-1b57-4ca2-9ec8-194f4b3e964f"],
 " is 0 when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"a", "(", 
      RowBox[{"x", " ", "-", " ", "c"}], " ", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"0", " ", "\[DoubleLeftRightArrow]", " ", "x"}], " ", "=", " ", 
     "c"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2135f645-ab04-46f1-b64f-96771c62acca"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "a"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2ee58c20-d981-43da-8fe9-7bd8594c6bc4"],
 " is a tangent to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "40050c5a-9dcf-4b55-9947-99c5606271b0"],
 ", when \n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox[
     RowBox[{"a", "(", 
      RowBox[{"x", "-", "c"}], ")"}], "2"], "=", "x"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dbe109db-f59d-491a-a009-24b3fa152677"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "a"}]], "+", "c"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b1b0c5fa-397a-4aea-9258-c270f4e0a170"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLeftRightArrow]", 
     SuperscriptBox[
      RowBox[{"a", "(", 
       FractionBox["1", 
        RowBox[{"2", "a"}]], ")"}], "2"]}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", "a"}]], "+", "c"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8918c7f8-4de8-49ed-bbb6-dfdfc49936a4"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLeftRightArrow]", "c"}], "=", 
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"4", "a"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1bd562da-3d79-4433-a76f-50ad43c65d0f"],
 "\n\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "a"}], ",", " ", "b"}], ")"}], "=", 
    TagBox[GridBox[{
       {"\[Piecewise]", GridBox[{
          {"b", 
           RowBox[{",", " ", 
            RowBox[{
             RowBox[{"for", " ", "0"}], "<", "x", "<=", 
             RowBox[{"b", "-", 
              FractionBox["1", 
               RowBox[{"4", "a"}]]}]}]}]},
          {GridBox[{
             {
              RowBox[{"f", "(", 
               RowBox[{"x", ";", " ", "a"}], ")"}]},
             {"x"}
            }], GridBox[{
             {
              RowBox[{",", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"for", " ", "b"}], "-", 
                 FractionBox["1", 
                  RowBox[{"4", "a"}]]}], "<", "x", "<=", 
                RowBox[{"b", "+", 
                 FractionBox["1", 
                  RowBox[{"4", "a"}]]}]}]}]},
             {
              RowBox[{",", " ", 
               RowBox[{
                RowBox[{"for", " ", "x"}], "<", 
                RowBox[{"b", "+", 
                 FractionBox["1", 
                  RowBox[{"4", "a"}]]}]}]}]}
            }]}
         },
         AllowedDimensions->{2, Automatic},
         Editable->True,
         GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
