Cell[TextData[{
 "The plot suggests that we want to be able to shift the graph towards the \
right. For this we introduce ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c498c56c-a186-41a8-bc1d-8ed89e13df36"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{"b", "-", 
      FractionBox["1", 
       RowBox[{"exp", "(", 
        RowBox[{"x", "-", "a"}], ")"}]]}], "=", 
     RowBox[{"b", "-", 
      RowBox[{"exp", "(", 
       RowBox[{"a", "-", "x"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0c53db18-b429-4fa9-8a58-ba8fc45d81ec"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"exp", "(", 
     RowBox[{"a", "-", "x"}], ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2ed7a67-256e-4711-81cd-5fb4596c3c7c"]
}], "Text",
 CellChangeTimes->{{3.9004930203288317`*^9, 3.9004930625460176`*^9}, {
  3.900493168093135*^9, 3.900493206567753*^9}, {3.90049427276717*^9, 
