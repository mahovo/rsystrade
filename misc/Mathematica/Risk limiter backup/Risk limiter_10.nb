 RowBox[{
  RowBox[{
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", " ", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"LogLinearPlot", "[", "\[IndentingNewLine]", 
  RowBox[{"out", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"b", ",", " ", 
     RowBox[{"-", "1"}], ",", "10"}], "}"}], ",", "\[IndentingNewLine]", 
