Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"x", ";", " ", "b"}], ")"}], "=", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"log", "(", "b", ")"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c", " ", "x"}], "-", "1"}], ")"}]}], ")"}], ")"}]]}], 
   TraditionalForm]],ExpressionUUID->"c3664083-806b-4eea-9c48-3fd632d1fcd2"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", 
    RowBox[{"-", 
     FractionBox["1", 
      StyleBox[
       RowBox[{"\[ExponentialE]", " ", "b", " ", 
        RowBox[{"log", "(", "b", ")"}]}],
       FontSize->13]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1751eb02-a9cd-4be3-a25c-fa0861083f94"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", "(", 
     RowBox[{"x", ";", " ", "b"}], ")"}], "==", 
    FormBox[
     TagBox[GridBox[{
        {"\[Piecewise]", GridBox[{
           {
            RowBox[{
             RowBox[{"f", "(", "x", ")"}], " "}], 
            RowBox[{
             RowBox[{"for", " ", "x"}], " ", "<", " ", "a", "\[Congruent]", 
             RowBox[{"\[ExponentialE]", " ", "b"}]}]},
           {"x", 
            RowBox[{
             RowBox[{"for", " ", "x"}], ">", "a", "\[Congruent]", 
             RowBox[{"\[ExponentialE]", " ", "b"}]}]}
          },
          AllowedDimensions->{2, Automatic},
          Editable->True,
