Cell[TextData[{
 "As for the downward limiter, we also want to be able to change the shape of \
the knee. For this we introduce the variable ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "20ec17b4-92cf-4a67-819b-a0e58327da4a"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "a"}], ",", " ", "b", ",", " ", "c"}], ")"}], 
    "=", 
    RowBox[{
     RowBox[{"b", "-", 
      FractionBox["1", 
       RowBox[{"exp", "(", 
        RowBox[{"c", " ", 
         RowBox[{"(", 
          RowBox[{"x", "-", "a"}], ")"}]}]}]]}], "=", 
     RowBox[{"b", "-", 
      RowBox[{"exp", "(", 
       RowBox[{"c", "(", 
        RowBox[{"a", "-", "x"}], ")"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bf67ede7-f893-4a28-8b9a-7aa2fce6eeac"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", " ", 
    RowBox[{"exp", "(", 
     RowBox[{"c", "(", 
      RowBox[{"a", "-", " ", "x"}], ")"}], ")"}]}], TraditionalForm]],
