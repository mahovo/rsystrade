      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<\[Tau](\>\"", ",", 
          RowBox[{"ToString", "[", "x", "]"}], ",", " ", "\"\<)\>\""}], "]"}],
         ",", " ", "12"}], "]"}]}], " ", "}"}]}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"\"\<x = \>\"", ",", " ", 
      RowBox[{"ToString", "[", "x", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
   "]"}]}], "Input",
