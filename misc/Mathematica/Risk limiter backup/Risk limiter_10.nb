Cell["The constraints on the downward limiting multiplier are:", "Text",
 CellChangeTimes->{{3.900391034592424*^9, 3.900391036496579*^9}, {
  3.900731062041336*^9, 3.900731063543419*^9}, {3.900735190108963*^9, 
  3.900735191151011*^9}},ExpressionUUID->"c589e94b-8f0d-470a-86e4-\
0e885b3cd57b"],

Cell[TextData[{
 "Constraints on ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "1ef41c2b-1358-4faa-9ed4-0c92b4c8c8fa"]
}], "Text",
 CellChangeTimes->{{3.900391024301837*^9, 3.900391024560705*^9}, {
  3.900399157480195*^9, 3.90039915962315*^9}, {3.9007351982506313`*^9, 
  3.900735198403582*^9}},
 FontWeight->"Bold",ExpressionUUID->"f00f7b10-136d-4130-9af4-dd86216c7f0d"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ">=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d2775fb1-e6cc-4f52-93e0-158764541751"],
 " (because ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "9c4d9576-46e1-4c4f-a736-eaa687362aa7"],
 " is a standard deviation)"
}], "Text",
 CellChangeTimes->{{3.900735203007696*^9, 3.900735219935606*^9}, {
  3.900735291471333*^9, 
  3.900735291471388*^9}},ExpressionUUID->"98af4c61-4e38-44bb-8c21-\
a10c0ad39917"],

Cell[TextData[{
 "Constraints on ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "09813fe0-712c-4a1b-97a8-557c42bfdda7"]
}], "Text",
 CellChangeTimes->{{3.900391024301837*^9, 3.900391024560705*^9}, {
  3.900399157480195*^9, 3.90039915962315*^9}},
 FontWeight->"Bold",ExpressionUUID->"7073f24a-8b4a-42d5-b6d2-e10b571120dd"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"0", "<", "b", "<", "1"}], 
  TraditionalForm]],ExpressionUUID->"b765aadf-adcc-483f-bbe3-b5bcf029e182"]], \
"Text",
 CellChangeTimes->{{3.9003909790669613`*^9, 3.900391039276432*^9}, {
  3.9004780655708857`*^9, 3.9004780659390078`*^9}, {3.90072904198925*^9, 
  3.900729042372746*^9}},ExpressionUUID->"24d24065-858b-40e7-8634-\
a446472997f4"],

Cell[TextData[{
 "Constraints on ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "6783194d-f757-436d-ad63-5bd55430effd"]
}], "Text",
 CellChangeTimes->{{3.9003910424421186`*^9, 3.900391051871559*^9}, {
   3.9003927258670397`*^9, 3.900392751375025*^9}, 3.900399097693967*^9, {
   3.9004780061478233`*^9, 3.900478008539351*^9}},
 FontWeight->"Bold",ExpressionUUID->"d91ca416-5161-4fca-9b74-80e78ad5d7eb"],

Cell[TextData[{
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "c", "<", 
    FractionBox["1", 
     StyleBox[
      RowBox[{"b", " ", 
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{
        StyleBox["(",
         FontSize->14], 
        RowBox[{
         StyleBox["\[ExponentialE]",
          FontSize->14], 
         StyleBox[" ",
          FontSize->14], 
         StyleBox["-",
          FontSize->14], 
         StyleBox[" ",
          FontSize->14], 
         SuperscriptBox["b", 
          StyleBox[
           RowBox[{
            RowBox[{"-", "c"}], " ", 
            SubscriptBox["x", "extreme"]}],
           FontSize->13]]}], 
        StyleBox[")",
         FontSize->14]}]}],
      FontSize->14]]}], TraditionalForm]],ExpressionUUID->
  "09aa2f9e-9a27-429e-ac5f-f65c461848e5"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "extreme"], ">", 
    RowBox[{"-", 
     FractionBox["1", 
      StyleBox[
       RowBox[{"c", " ", 
        RowBox[{"log", "(", "b", ")"}]}],
       FontSize->12]]}], "\[Congruent]", "a"}], TraditionalForm]],
  ExpressionUUID->"62794571-0e15-4e4b-80b5-8d4dcb2a2e0a"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.900753293377022*^9, 3.900753348831957*^9}, {
  3.900753436095656*^9, 3.9007534917678337`*^9}, {3.900753591500573*^9, 
  3.900753606348095*^9}},ExpressionUUID->"ad702a8a-5206-4049-aab2-\
40e71f3675d5"],

Cell[TextData[{
 "Equivalent:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "c", "<", 
    FractionBox["1", 
     StyleBox[
      RowBox[{"b", " ", 
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{
        StyleBox["(",
         FontSize->14], 
        RowBox[{
         StyleBox["\[ExponentialE]",
          FontSize->14], 
         StyleBox[" ",
          FontSize->14], 
         StyleBox["-",
          FontSize->14], 
         StyleBox[" ",
          FontSize->14], 
         SubscriptBox["k", "extreme"]}], 
        StyleBox[")",
         FontSize->14]}]}],
      FontSize->14]]}], TraditionalForm]],ExpressionUUID->
  "727b013e-e860-47d2-bcf5-de07307b7741"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "extreme"], ">", "\[ExponentialE]"}], TraditionalForm]],
  ExpressionUUID->"72d2bafe-5956-40a4-bb6c-2e7cedd50aec"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "extreme"], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["b", 
       RowBox[{
        RowBox[{"-", "c"}], " ", 
        SubscriptBox["x", "extreme"]}]], "\[DoubleLeftRightArrow]", 
      SubscriptBox["x", "extreme"]}], "=", 
     RowBox[{"-", 
      StyleBox[
       FractionBox[
        RowBox[{"log", "(", 
         SubscriptBox["k", "extreme"], ")"}], 
        RowBox[{"c", " ", 
         RowBox[{"log", "(", "b", ")"}]}]],
       FontSize->16]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b6f261ae-9f8c-405a-bef0-6309f60dddb6"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "extreme"], TraditionalForm]],ExpressionUUID->
  "ef22f5f0-cca3-42b3-a381-94921ae7ea2c"],
 " is the maximum possible value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "6fc5b957-b830-4761-b1a5-1866ed3324eb"],
 ". Theoretically this value is ",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]],ExpressionUUID->
  "acfc8e2f-2c38-435e-b2c2-9219040765f3"],
 ". In practice, this value is chosen heuristically. The trade-off is that \
the higher the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "extreme"], TraditionalForm]],ExpressionUUID->
  "21a8ff8c-a2dd-441d-afdf-624496198d18"],
 ", the more narrow the valid range of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "9376a202-a753-4573-bc31-2fe7924c4d88"],
 ". For ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "extreme"], "=", "\[Infinity]"}], TraditionalForm]],
  ExpressionUUID->"a6ffd01f-0fd8-4590-9f97-353d0bbadc70"],
 " there will be no valid value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "3e1b575d-c228-48b6-876d-cb95e4180831"],
 ". For values of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "extreme"], TraditionalForm]],ExpressionUUID->
  "9ab3be8e-389b-4556-9587-7dbace6d2c2b"],
 " very close to ",
 Cell[BoxData[
  FormBox["\[ExponentialE]", TraditionalForm]],ExpressionUUID->
  "26a6032f-813c-437b-a29e-c1b797cd41d4"],
 ", the max value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "d7d44487-d107-443e-a7cf-e6218eaad99f"],
 " can get very big, and the resulting ",
 Cell[BoxData[
  FormBox[
   RowBox[{"h", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "7f844c5d-4fa3-48d8-adcd-5946fd5b06e4"],
 " may have negative slope for some values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "03487afd-d758-433d-8061-5310030ffd31"],
 ".\n\nFor ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "e35472a3-c086-4e43-b07f-b6a09f28c033"],
 " values close to 1, ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "48a33a6b-e5af-4576-855c-33cb5d7e766d"],
 " can get very big. \n\nFor implementation it can be a good idea to impose a \
maximum ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "e1c53eb5-aae3-4663-9b4b-506cf45b820e"],
 " value. Something like ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", "10"}], TraditionalForm]],ExpressionUUID->
  "38c6b6ad-5154-425e-9c15-2ecc3204d06d"],
 " might be reasonable.\n\nFor implementation, we don\[CloseCurlyQuote]t know \
the minimum value of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "extreme"], TraditionalForm]],ExpressionUUID->
  "41955379-8e58-4475-91ea-75d285b5cba2"],
 ", when we calculated the constraints on ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "eea40b0d-bcad-47e7-bc6e-068cbd8406f8"],
 ". Instead we can calculate the constraints on ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da721093-1ef4-4016-8e22-c81cb39d74e4"],
 " based on ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "extreme"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f81a5cad-e04d-4755-8429-ee3f1ac87cb9"],
 ", and then check that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "extreme"], ">", 
    RowBox[{"-", 
     FractionBox["1", 
      StyleBox[
       RowBox[{"c", " ", 
        RowBox[{"log", "(", "b", ")"}]}],
       FontSize->12]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b8903fb3-6768-4b2c-8de6-98dae3ca9225"],
 "."
}], "Text",
 CellChangeTimes->{{3.900392703527252*^9, 3.900392729691001*^9}, {
   3.900425640856038*^9, 3.900425643152762*^9}, 3.9004266583966513`*^9, {
   3.900735799016768*^9, 3.90073587065135*^9}, {3.900735905395825*^9, 
   3.900735916235806*^9}, {3.900736056004757*^9, 3.900736143948175*^9}, {
   3.900748723035941*^9, 3.900748726981536*^9}, {3.900748870935622*^9, 
   3.900748882134861*^9}, {3.9007492578325872`*^9, 3.900749290248496*^9}, {
   3.900749321473929*^9, 3.900749331281654*^9}, {3.900749837669942*^9, 
   3.900749854086308*^9}, {3.900749974000656*^9, 3.9007500576249723`*^9}, {
   3.900750092371463*^9, 3.900750187984187*^9}, {3.900753382438151*^9, 
   3.900753461816515*^9}, {3.9007578624881077`*^9, 3.900757882788076*^9}, {
   3.900757967790348*^9, 3.900758074630834*^9}, {3.90075841428484*^9, 
   3.900758447629973*^9}, {3.900758496388907*^9, 
   3.900758496389182*^9}},ExpressionUUID->"8344e3f5-950f-4c3a-931b-\
1acf4340a36b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Plot", "Subsubsection",
 CellChangeTimes->{{3.9003451443122473`*^9, 3.900345149568396*^9}, 
   3.900732585473741*^9},ExpressionUUID->"01de812f-1811-43ff-8428-\
c395e6473e8b"],

Cell[TextData[{
 "Note: In the following plots, for hard inequalities we set the range of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "22bc6a87-efba-4fa4-a441-375e59763599"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"\[Delta]", ",", " ", 
     SubscriptBox["c", "max"]}], "]"}], TraditionalForm]],ExpressionUUID->
  "0e06534b-93ad-4ab9-b22a-f0d0e4cdf8fd"],
 ", and the range of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "ccafbd14-fc61-4375-a871-dd2de460edd3"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", 
    RowBox[{"\[Delta]", ",", " ", 
     RowBox[{
      SubscriptBox["b", "max"], "-", "\[Delta]"}]}], "]"}], TraditionalForm]],
  ExpressionUUID->"d690c227-ba17-45b0-b51e-b743d93031e7"],
 "."
}], "Text",
 CellChangeTimes->{{3.9003974744062557`*^9, 3.900397522289064*^9}, {
  3.900400135567205*^9, 3.900400233393808*^9}, {3.900735257615459*^9, 
  3.900735257831135*^9}, {3.900735411428883*^9, 3.900735436757202*^9}, {
  3.90073547981551*^9, 3.900735482894691*^9}, {3.900766566192045*^9, 
  3.900766575899942*^9}},ExpressionUUID->"e7e4f64d-ad6d-49a8-b641-\
1678e4600fc1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Delta]", "=", "1*^-8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bmax", " ", "=", "1"}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cmax", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"binit", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cinit", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"kinit", "=", 
    RowBox[{"N", "[", 
     RowBox[{"E", "+", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"xtreme", "=", 
     RowBox[{"E", "+", "2"}]}], ";"}], "*)"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"The", " ", "higher", " ", "the", " ", "max", " ", "x"}], ",", 
    " ", 
    RowBox[{
    "the", " ", "smaller", " ", "the", " ", "range", " ", "of", " ", "c"}]}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "a", ",", "b", ",", "c"}], "]"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"aval", "[", 
     RowBox[{"b_", ",", "c_", ",", "d_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"1", "/", "c"}], "-", 
     RowBox[{"log", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"d", "/", 
         RowBox[{"(", 
          RowBox[{"c", " ", "log", " ", 
           RowBox[{"(", "b", ")"}]}], ")"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"c", " ", "log", " ", 
         RowBox[{"(", "b", ")"}]}], ")"}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"aval", "[", 
      RowBox[{"x_", ",", "b_", ",", "c_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Log", "[", "b", "]"}], "*", 
             RowBox[{"(", 
