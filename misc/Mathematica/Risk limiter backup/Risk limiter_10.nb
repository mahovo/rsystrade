      Selectable->False,
      StripWrapperBoxes->True],
     TraditionalForm]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a7044eae-db87-4509-a4b9-9708577b3884"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"h", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "\[Lambda]"}], ")"}], "=", 
    RowBox[{
     RowBox[{"\[Lambda]", " ", 
      RowBox[{"g", "(", "x", ")"}]}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", "\[Lambda]"}], ")"}], 
      RowBox[{"max", "(", 
       RowBox[{"x", ",", " ", "b"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b0ffe44b-8e51-45da-a06b-286341431244"],
 "    , ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<=", "\[Lambda]", "<=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "87ba8fcc-a89f-4e67-8502-25e3b8030782"],
 "\n\n",
 Cell[BoxData[
