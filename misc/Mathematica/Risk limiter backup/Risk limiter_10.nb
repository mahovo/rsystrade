        RowBox[{"(", 
         RowBox[{"2", "*", 
          RowBox[{"Log", "[", "b", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"b", "-", "1"}], ")"}]}], ")"}]}]}], "}"}], ",", 
     "\[Delta]", ",", " ", 
