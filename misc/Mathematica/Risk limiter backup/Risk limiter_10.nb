Cell[BoxData[
 FormBox[
  RowBox[{"d", "-", 
   RowBox[{"c", " ", 
    RowBox[{"log", "(", "b", ")"}], " ", 
    SuperscriptBox["b", 
     RowBox[{"1", "-", 
      RowBox[{"c", " ", "x"}]}]]}]}], TraditionalForm]], "Output",
