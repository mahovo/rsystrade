Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7afb5e79-23a0-4162-8667-8fa9e2ace96e"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3be34fbc-5620-40f0-ad10-e1e230638554"]
}], "Subsubsection",
