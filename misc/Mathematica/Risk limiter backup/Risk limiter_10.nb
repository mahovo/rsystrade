Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"b", " ", "=", " ", "1.2"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"m", "=", "1"}], ";", " ", "\[IndentingNewLine]", 
    RowBox[{"n", "=", 
     RowBox[{
      RowBox[{"2", "*", "m"}], "+", "2"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"c", ",", " ", "x"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"x_", ",", " ", "c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", "*", "b", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{"E", "-", 
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}], ")"}]}]}], ")"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"xvalues", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{"10", "^", 
          RowBox[{"(", 
           RowBox[{"Range", "[", 
            RowBox[{
             RowBox[{"-", "m"}], ",", "m"}], "]"}], ")"}]}]}], "]"}], "]"}], 
      "]"}]}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvalues", "=", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", " ", "1", ",", " ", "10", ",", " ", "100"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"Length", "[", "xvalues", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", 
    RowBox[{"i", "<", 
     RowBox[{"n", "+", "1"}]}], ",", " ", 
    RowBox[{"i", "++"}], ",", " ", 
    RowBox[{"legends", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"legends", ",", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<x=\>\"", ",", 
          RowBox[{"ToString", "[", 
