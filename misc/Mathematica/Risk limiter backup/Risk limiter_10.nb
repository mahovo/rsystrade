   3.90047426751794*^9}, {3.9004760042566633`*^9, 3.900476008783805*^9}, {
   3.900476929487712*^9, 3.900476939943705*^9}},
 Background->RGBColor[1, 0.85, 0.85],
 CellLabel->
  "In[1335]:=",ExpressionUUID->"78c71e81-6bc7-4b16-a411-629d5cd44124"],

