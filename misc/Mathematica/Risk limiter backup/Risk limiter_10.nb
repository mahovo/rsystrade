DWMLBNJ2M7vAtOiudbwgOl4iVRZE35EPVALRu04fMADRedMYskF0zTI+MM34
umN6KpC+tPoEmF5jsjwxF0gvcYHQNd2x70tB7uiB0P/83xRUAmmbRZyFIPrp
YeZ6ED1jWQuY7mFTfLQPSC8qMHwMoic3dDwH0bmNEBoAePKbZw==
  "],
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"66131423-37ed-462c-b229-ab93ee0dddd7"],

Cell[TextData[{
 "What if ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", 
    RowBox[{"1", "?"}]}], TraditionalForm]],ExpressionUUID->
  "24d902df-f084-428b-b375-27ed3fe770f3"],
 "\n\nThe theoretical maximum value of c is ",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]],ExpressionUUID->
  "92ea4144-69fd-4b80-a61e-3b6c35e22362"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "faee07fc-21e7-4351-bbab-0c23bf935200"],
 ". Also, for values of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "e6746764-951e-497d-bc8f-6dcd1429d2fc"],
 " close to ",
 Cell[BoxData[
  FormBox["1", TraditionalForm]],ExpressionUUID->
  "9c633f52-4504-4d6e-969e-3e81830cdebc"],
 " we will get huge maximum values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "8d61bdd7-90f7-4b6b-9dec-d51a9dfdc2ed"],
 " (which of course in itself should not be a problem)."
}], "Text",
 CellChangeTimes->{{3.900569430375042*^9, 3.90056944971618*^9}, {
  3.900569490492712*^9, 3.900569630605689*^9}, {3.900569674162279*^9, 
  3.900569736700082*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"726cab48-cc5d-43ef-a544-6f0cb5931196"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LogLogPlot", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Log", "[", "b", "]"}], "*", 
      RowBox[{"(", 
       RowBox[{"b", " ", "-", " ", "1"}], ")"}]}], ")"}]}], ",", " ", 
