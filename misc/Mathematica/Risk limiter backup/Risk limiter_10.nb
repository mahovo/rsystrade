Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "b", ",", "c"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"b", "=", "1.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", "0"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tauzero", "[", 
     RowBox[{"b_", ",", " ", "c_"}], "]"}], ":=", " ", 
    RowBox[{"c", " ", "*", " ", "b", "*", 
     RowBox[{"Log", "[", "b", "]"}], "*", 
     RowBox[{"(", 
      RowBox[{"E", "-", "1"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"c", "*", "E"}], "-", 
       RowBox[{"c", "*", 
        RowBox[{"b", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "c"}], "*", "x"}], ")"}]}]}]}], "==", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"b", "*", 
         RowBox[{"Log", "[", "b", "]"}]}], ")"}]}]}], ",", "c", ",", 
     "Reals"}], "]"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"tauzero", "[", 
       RowBox[{"b", ",", " ", "c"}], "]"}], "==", "1"}], ",", "c", ",", 
     "Reals"}], "]"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"1", "/", 
  RowBox[{"(", " ", 
   RowBox[{"b", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
