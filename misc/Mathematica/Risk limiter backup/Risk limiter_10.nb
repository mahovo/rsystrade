Cell[TextData[{
 "While the knee looks better, the limit is shifted downward.\nWhat if we \
shift ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "2e397e39-6099-4a95-bef2-85dfc8ce841f"],
 " upward to compensate?\nNot surprisingly, the two lines won\
\[CloseCurlyQuote]t meet, when we shift on upward.\nSo not only must ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "4", ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"g", "'"}], 
     RowBox[{"(", "4", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "06840434-eea9-48c6-8fe4-3be4dbb4a23a"],
 ", we also need ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", "4", ")"}]}], " ", "=", " ", 
    RowBox[{"g", 
     RowBox[{"(", "4", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "0e8c477f-e25f-4b43-8b8b-5e0ecef8f5eb"],
 "."
}], "Text",
 CellChangeTimes->{{3.9003035474318743`*^9, 3.9003035576482487`*^9}, {
  3.900307036661574*^9, 3.900307041089313*^9}, {3.900482125274454*^9, 
  3.9004821341059027`*^9}},ExpressionUUID->"6724affc-fbd4-46bf-9447-\
2546722f2fff"],

Cell[TextData[{
 "What if we multiply b by some factor, ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "4d209f71-e917-4df7-bbb2-1da453e77006"],
 ". How could we then express ",
 Cell[BoxData[
  FormBox["z", TraditionalForm]],ExpressionUUID->
  "0b3a90b0-fa30-4032-a039-752757af973c"],
 " and a to meet the conditions?"
}], "Text",
 CellChangeTimes->{{3.9003070563402863`*^9, 3.900307115853072*^9}, {
  3.900482137650279*^9, 
  3.9004821398494177`*^9}},ExpressionUUID->"7f0e2c4c-e26d-420f-8141-\
515a245ef396"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", " ", "b", ",", " ", "c"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f4temp", "[", 
    RowBox[{
    "x_", ",", " ", "a_", ",", " ", "b_", ",", " ", "c_", ",", " ", "z_"}], 
    "]"}], ":=", 
   RowBox[{"a", "/", 
    RowBox[{"(", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"c", "*", 
       RowBox[{"Log", "[", 
        RowBox[{"b", "*", "z"}], "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"x", "-", "a"}], ")"}]}], "]"}], ")"}]}]}], 
  " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"df4", "[", "x_", "]"}], "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"f4temp", "[", 
     RowBox[{"x", ",", " ", "a", ",", "0.1", ",", " ", "10", ",", " ", "z"}], 
     "]"}], ",", " ", "x"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"df4", "[", "a", "]"}], "==", "1"}], ",", 
     RowBox[{
      RowBox[{"f4temp", "[", 
       RowBox[{
       "a", ",", " ", "a", ",", " ", "0.1", ",", " ", "10", ",", " ", "z"}], 
       "]"}], "==", "a"}], ",", " ", 
     RowBox[{
      RowBox[{"f4temp", "[", 
       RowBox[{
       "0", ",", " ", "a", ",", "  ", "0.1", ",", " ", "10", ",", " ", "z"}], 
       "]"}], "==", "0.1"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"a", ",", " ", "z"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.900303202894401*^9, 3.900303267238537*^9}, {
   3.900303385202042*^9, 3.9003033893381*^9}, {3.90030348050368*^9, 
