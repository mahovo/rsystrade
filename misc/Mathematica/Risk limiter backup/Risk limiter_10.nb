Cell[BoxData[{
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{"x_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "1"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Log", "[", "b", "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"Log", "[", "b", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"x", "+", 
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"Log", "[", "b", "]"}]}], ")"}]}], ")"}]}], "]"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g2", "[", "x_", "]"}], ":=", "x"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h2", "[", 
   RowBox[{"x_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f2", "[", 
        RowBox[{"x", ",", " ", "b"}], "]"}], ",", " ", 
       RowBox[{"x", "<", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "/", 
          RowBox[{"Log", "[", "b", "]"}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"g2", "[", "x", "]"}], ",", " ", 
       RowBox[{"x", ">=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "/", 
          RowBox[{"Log", "[", "b", "]"}]}], ")"}]}]}], "}"}]}], "}"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.900296130574726*^9, 3.9002961976162367`*^9}, {
   3.9002962506907263`*^9, 3.9002962722742367`*^9}, {3.90029636228586*^9, 
