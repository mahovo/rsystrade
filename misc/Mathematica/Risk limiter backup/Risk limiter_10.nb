Cell[TextData[{
 "So the constraint for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e3ae0872-de15-446c-be72-602ea87dfcb9"],
 " and ",
 Cell[BoxData[
  FormBox[
