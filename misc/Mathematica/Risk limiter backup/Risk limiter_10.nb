Cell[TextData[{
 "Constraint:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"log", "(", "b", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"b", "-", "1"}], ")"}]}]]}], TraditionalForm]],ExpressionUUID->
  "0bfc5935-9062-4519-a450-5c7586120a22"],
 "\n\nIf we constrain ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "ada258fc-867e-442e-96ce-d6f35ef4cef3"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"b3f8a8bc-36c1-409e-be96-c051baf88974"],
 ", when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "\[ExponentialE]"], "<", "b", "<", "1"}], 
   TraditionalForm]],ExpressionUUID->"c7277bbb-d577-40b3-81d9-48e4d1991c2e"],
 ", we should be safe for all positive ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "873c4d7c-ec06-499e-8d0d-c40f8a2adfa4"],
 "."
}], "Text",
