Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"2739fb29-f8f8-4629-830e-b908de9474a3"],
 "  is not monotonically increasing in ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "f699dbfc-d114-4b42-8069-0a0d795b0150"],
 ".\n\nSo for which value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "7eec02fa-50ce-461f-bfd0-0d250a5c436f"],
 " should we solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"c681efd5-e0bd-498d-8980-3e4b84447fb6"],
 " for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "a7ce1688-e3b4-43f6-ba81-b0f2fe65e799"],
 "?\n\nFor positive values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fa84fb38-628a-4ca4-bcbc-7e47a347d12c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "feee921e-fcc2-4ec5-85f8-ba63cc5db1a3"],
 StyleBox["is ",
  FontWeight->"Bold"],
 "increasing in ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b7c87cc9-ccbc-46d2-b61f-c967fda89c2c"],
 ".\n\nSince we have an upper constraint on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"04df1154-9fae-4c9c-84e6-2942c8ca03c6"],
 ", the \[OpenCurlyDoubleQuote]worst case\[CloseCurlyDoubleQuote] is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "ce855f2a-c19e-4d5d-a412-37461c4bd2e5"],
 "."
}], "Text",
 CellChangeTimes->{
  3.9004212622241163`*^9, {3.900421837281644*^9, 3.9004218835215693`*^9}, 
   3.900422679405821*^9, {3.9004238861266813`*^9, 3.900423907999133*^9}, {
   3.9004241546429987`*^9, 3.900424236404953*^9}, {3.900424356895626*^9, 
   3.9004243658396873`*^9}, {3.90064911404624*^9, 3.9006491342745113`*^9}, {
   3.9006494816143007`*^9, 3.900649485087448*^9}, {3.900669852431362*^9, 
   3.900669856350882*^9}, {3.9006701932987823`*^9, 3.90067022881042*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"38bbde76-41d7-4f48-b084-a07cbbdaef02"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", 
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], " ", ")"}]}], 
   TraditionalForm]],ExpressionUUID->"6d3c1458-5011-4451-8e72-5f82bf78d74c"],
 " is increasing as c is increasing, when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", ">", " ", "1"}], TraditionalForm]],ExpressionUUID->
  "5dba5fc3-a802-4b6a-98c7-9a08fa10901a"],
 ". This is true for all ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", " ", ">", " ", "0"}], TraditionalForm]],ExpressionUUID->
  "cc87e7f6-7618-436c-9ef3-a3e7e1579b42"],
 ".\nFor all other values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "699a581c-381b-4a8a-b9e3-19d11533cef0"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", 
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], " "}], 
   TraditionalForm]],ExpressionUUID->"1f7e6d3f-a2ef-41fe-b010-94e1a5adc626"],
 "is not monotonically increasing in ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "0916aa4e-56d8-4db1-acb3-a72aca87fab8"],
 ".\n\nSo for which value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "74b84e9e-e6d3-4ed2-88bb-9c4c2cb36a11"],
 " should we solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"54df120c-813c-4b31-97f6-ee61c22d12aa"],
 " for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "b9648ede-375e-405f-bd43-471d6aa13c86"],
 "?\n\nSince we have an upper constraint on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"53314e3d-2efb-4eea-b54d-59168abca463"],
 ", the \[OpenCurlyDoubleQuote]worst case\[CloseCurlyDoubleQuote] is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "f725faf3-d817-48ee-9924-be4e6e528e13"],
 "."
}], "Text",
 CellChangeTimes->{{3.9006492347967176`*^9, 3.900649309705311*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"fd71add8-47b6-4951-a6a9-efd3d53a4dcf"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", "c", ")"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Tau]", "(", 
       RowBox[{
        RowBox[{"c", ";", " ", "x"}], ",", " ", "b"}], ")"}], 
      SubscriptBox["|", 
       RowBox[{"x", "=", "0"}]]}], "=", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"b", "-", "1"}], ")"}]}]}]}], TraditionalForm]],ExpressionUUID->
  "06e76074-9807-4a07-8762-90f838b6d18a"]
}], "Text",
 CellChangeTimes->{{3.900425077533064*^9, 3.900425154167832*^9}, {
  3.900425201728876*^9, 3.900425225137726*^9}, {3.9004259331509666`*^9, 
  3.900425947552602*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"42b7b48f-ce09-4530-b8bc-710007567a37"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", "c", ")"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Tau]", "(", 
       RowBox[{
        RowBox[{"c", ";", " ", "x"}], ",", " ", "b"}], ")"}], 
      SubscriptBox["|", 
       RowBox[{"x", " ", "=", " ", "\[Infinity]"}]]}], "=", 
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], "\[ExponentialE]", " "}]}]}], 
   TraditionalForm]],ExpressionUUID->"013356a6-e80b-44cf-b6ed-7bcc75a3c1ab"],
 "\nfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "5510e68c-0608-49f2-b429-c6b516ab28a2"],
 ".\n\nHere we are imposing the constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "238987f1-f5b6-4ad5-9a5c-4a3ca0a12707"],
 ", to simplify the problem."
}], "Text",
 CellChangeTimes->{{3.900425077533064*^9, 3.900425154167832*^9}, {
  3.900425201728876*^9, 3.900425225137726*^9}, {3.9004259331509666`*^9, 
  3.900425947552602*^9}, {3.900649356281088*^9, 3.9006493714991293`*^9}, {
  3.900649536471546*^9, 3.900649561495467*^9}, {3.900649595352298*^9, 
  3.900649617490563*^9}, {3.900650210536124*^9, 3.900650247608173*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"1804515f-4845-4988-ad00-8eec2589b5ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tau2", "[", 
   RowBox[{"b_", ",", " ", "c_"}], "]"}], ":=", " ", 
  RowBox[{"c", " ", "*", " ", 
   RowBox[{"Log", "[", "b", "]"}], "*", 
   RowBox[{"(", 
    RowBox[{"b", "-", "1"}], ")"}]}]}]], "Input",
