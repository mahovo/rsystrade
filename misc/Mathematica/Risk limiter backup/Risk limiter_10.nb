Cell[TextData[{
 "Again, let\[CloseCurlyQuote]s consider the extreme case where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "def6368c-dc43-40d0-9b30-f3fc8c53d6d6"],
 ".\n\nThen we have the constraint\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", " ", 
       RowBox[{
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}], "<", "1"}]}]}], TraditionalForm]],
  ExpressionUUID->"b24cc3b6-36ed-4fd8-8a90-5b5b701c6506"],
 "\n\nHere we have \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "f198a24f-7e3d-45f3-a7b2-4d8e5e50ccb0"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "<", 
    RowBox[{"log", "(", "b", ")"}], "<", "0"}], TraditionalForm]],
  ExpressionUUID->"1b5ebae6-b37f-4708-afb6-eaeeceba7357"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     FractionBox["1", "\[ExponentialE]"], "-", "1"}], "<", 
    RowBox[{"b", "-", "1"}], "<", "0"}], TraditionalForm]],ExpressionUUID->
  "8c689c65-ffc9-4079-9f04-4a7939c18dfb"],
 "\n\nSo ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"b", "-", "1"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "455394d8-0a15-4c5c-bab5-99d6709332ba"],
 " is positive for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "\[ExponentialE]"], "<", "b", "<", "1"}], 
   TraditionalForm]],ExpressionUUID->"b8f6d969-1c3d-462f-9756-928cd6d948f2"],
 ". Therefore,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"e0ccd91d-566a-4ca3-99e3-a56b1933e078"]
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQBWIQLc77VyaA/63jyV1u8iCa62BiPojetLGrDES7PWyq
BdGNHR5NINqic18HiK5KbugGq7/+fAKIPm8zbT6I/vf54VIQvd6wdjmI7s9P
