   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", " ", "\"\<\[Tau](x)=1\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"out", "=", 
