Cell[TextData[{
 "The blue line does not hit ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "8153bf31-1a23-4d2d-a285-c44aee0bcb41"],
 " at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "7f96c007-6b58-4e61-81fa-0dc6f8c39ba8"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "=", 
        StyleBox["0",
         FontColor->RGBColor[1, 0.5, 0]]}], ";", " ", "a"}], ",", " ", "b"}], 
     ")"}], "=", 
    RowBox[{
     StyleBox[
      FractionBox["a", 
       SuperscriptBox["\[ExponentialE]", 
        StyleBox[
         RowBox[{
          RowBox[{"log", "(", "b", ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            StyleBox["0",
             FontColor->RGBColor[1, 0.5, 0]], 
            StyleBox[" ",
             FontColor->RGBColor[1, 0.5, 0]], "-", " ", "a"}], ")"}], " "}],
         FontSize->14]]],
      FontSize->20], "=", 
     SuperscriptBox["ab", "a"]}]}], TraditionalForm]],ExpressionUUID->
  "82cd6ab6-fefb-4625-a872-cb43665813db"],
 "\n\nSo ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "189d0693-4d2a-4fc0-b13a-41cdfa9b8466"],
 " will only approach ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "5a8785ce-cdc9-4d1c-b15a-8ef1475e242f"],
 " from above when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "8dcf5158-c52d-4386-bd0e-ae06af2a8e56"],
 "."
}], "Text",
 CellChangeTimes->{{3.900644919971488*^9, 3.900644956604866*^9}, {
  3.900645014978395*^9, 3.900645119735387*^9}, {3.900645160511468*^9, 
  3.9006452076159363`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"aac2ce26-c18a-490d-a26d-f2e7b6845725"],

Cell[TextData[{
 "We arrive at the soft knee limiter function\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"log", "(", "b", ")"}], "  ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c", "  ", "x"}], "-", "1"}], ")"}]}], ")"}]], "+", " ", 
     RowBox[{"d", " ", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "c9a9aa8a-9448-422f-865b-36d625d6d01c"],
 "\nwith\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "0f72bc6e-0c16-4416-b767-510e3c32889a"]
}], "Text",
 CellChangeTimes->{{3.90039788499474*^9, 3.900397983581708*^9}, {
  3.900398135120605*^9, 3.900398144770084*^9}, {3.900398253101708*^9, 
  3.900398279671317*^9}, {3.900593427893959*^9, 3.90059342789401*^9}, {
  3.900645722061846*^9, 3.900645817362568*^9}, {3.9006458477548018`*^9, 
  3.900645874482518*^9}, {3.900645921311553*^9, 3.900645922988254*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"a4ff1447-b1d1-48a1-b7a4-46933185cada"],

Cell[TextData[{
 "We need to be able to set a fixed limit, ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "809262e9-2113-49ba-add2-b8257fa1f613"],
 ". Then by adjusting the \[OpenCurlyDoubleQuote]softness\
\[CloseCurlyDoubleQuote] of the knee and the horizontal \
\[OpenCurlyDoubleQuote]stretch\[CloseCurlyDoubleQuote] of the curve, it \
should be possible to find a point where ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "eb31c8d7-d34f-4b85-98c9-7aa7b427032d"],
 " tangents ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "ebd773fb-9300-4605-8bdc-315185d5caf7"],
 ".\nThe ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "e705bb44-f5d2-47fa-9c7d-60a76bce5574"],
 "-value which we earlier called ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "9fa89122-3015-4465-9c48-2dc75b01db97"],
 ", i.e. the ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "7d9ee0ce-35ae-484b-afa2-7d4da033fe25"],
 "-value at which ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "285ac47d-02a2-4903-8e74-0e42bf97cbc5"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "a0263333-d607-4516-ab41-e664943077e0"],
 " meet, is now given implicitly by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "d089db4f-32b0-49f7-86db-b00b8f857f78"],
 ". We will derive ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "af594811-8813-4092-b15f-974cd1ae6828"],
 " below.\n\nIn this plot, ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "46302579-bc9f-41b8-a12d-0478f47d2424"],
 " will stretch the blue curve, while ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "f75ee4cf-838b-40b7-ad31-767ec36f69b4"],
 " adjusts the softness of the knee:"
}], "Text",
 CellChangeTimes->{{3.9006459261187468`*^9, 3.900645956828929*^9}, {
  3.900645996092874*^9, 3.9006460896639557`*^9}, {3.900646119776778*^9, 
  3.900646219954894*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"684fe034-cc9c-404b-bb55-6bd8a4c8fcdd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "b", ",", " ", "c", ",", " ", "d"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f6temp", "[", 
   RowBox[{"x_", ",", " ", "b_", ",", " ", "c_", ",", " ", "d_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"Log", "[", "b", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c", " ", "*", " ", "x"}], "-", "1"}], ")"}]}], "]"}], 
     ")"}]}], "+", 
   RowBox[{"d", "*", "x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"df6", "[", "x_", "]"}], "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"f6temp", "[", 
     RowBox[{"x", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "]"}], ",", 
    " ", "x"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"LogLogPlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f6temp", "[", 
        RowBox[{"x", ",", " ", "b", ",", " ", "c", " ", ",", " ", "d"}], 
        "]"}], ",", " ", "x"}], "}"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "3"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<f(x)\>\"", ",", " ", "\"\<y=x\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", " ", "\"\<y\>\""}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\<Log-log\>\""}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0.1"}], "}"}], ",", " ", "0", ",", " ", "1", 
     ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "1"}], "}"}], ",", " ", "0.1", ",", " ", "10", 
     ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "1", ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]"}], "Input",
