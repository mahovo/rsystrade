Cell[TextData[{
 "f does meet g in (1, 1), but the combined curve will not be smooth.\nAnd it \
won\[CloseCurlyQuote]t work for other values of ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "c810c524-a9b0-4115-8a28-2ecd4fbc6903"],
 " than 1!"
}], "Text",
