Cell[TextData[{
 "Of course, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "6974424c-9258-436d-aeb0-95db775399f0"],
 ", it is easy to solve for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "dbc27017-18f4-4722-a76f-0c9849c772ab"],
 " analytically:"
}], "Text",
 CellChangeTimes->{{3.900425891893673*^9, 3.900425925986738*^9}, 
   3.900425972409256*^9},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"16cfbfb1-12dd-4a55-b03f-e60b447557bb"],

Cell[TextData[{
 "Of course, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "7b56abe5-9645-46e9-bf04-9707698b87f3"],
 ", it is easy to solve for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "bc097b51-07be-4dea-a591-89a13f5a7a49"],
 " analytically:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", "c", ")"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Tau]", "(", 
       RowBox[{
        RowBox[{"c", ";", " ", "x"}], ",", " ", "b"}], ")"}], 
      SubscriptBox["|", 
       RowBox[{"x", " ", "=", " ", "\[Infinity]"}]]}], "=", 
     RowBox[{
      RowBox[{"c", " ", "b", " ", 
       RowBox[{"log", "(", "b", ")"}], "\[ExponentialE]"}], "<", "1"}]}]}], 
   TraditionalForm]],ExpressionUUID->"c5d1118d-f97f-4bb1-a09a-9b51ad82fd45"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleLeftRightArrow]", 
    RowBox[{"c", "<", 
     StyleBox[
      FractionBox["1", 
       RowBox[{"b", " ", 
        RowBox[{"log", "(", "b", ")"}], "\[ExponentialE]"}]],
      FontSize->20]}]}], TraditionalForm]],ExpressionUUID->
  "97ca281f-0562-4a8e-a594-3b47d5711e55"],
 "\n\nfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "1"}], TraditionalForm]],ExpressionUUID->
  "d99e8b46-097e-4119-bd74-f75e8c97628d"],
 "."
}], "Text",
 CellChangeTimes->{{3.900425891893673*^9, 3.900425925986738*^9}, 
   3.900425972409256*^9, {3.900650186724999*^9, 3.900650187036672*^9}, {
   3.9006503138995*^9, 3.9006504157324543`*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"d182ecd8-b6ff-4568-8c70-901b2ec4e11c"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", " ", 
     RowBox[{"log", "(", "b", ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"b", "-", "1"}], ")"}]}], "<", 
    RowBox[{"1", "\[DoubleLongLeftRightArrow]", "c"}], "<", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"log", "(", "b", ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"b", "-", "1"}], ")"}]}]]}], TraditionalForm]],ExpressionUUID->
  "f6739c37-7b45-4491-b1bb-d5a5eabd832e"],
 "\nNote that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], "<", "0", " "}], TraditionalForm]],
  ExpressionUUID->"505cee7e-c1a1-4764-93ba-7df923601cf9"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"b", "-", "1"}], "<", "0"}], TraditionalForm]],ExpressionUUID->
  "99a53041-5056-4fa8-8a3e-cf82eb862ccb"],
 ", when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<", 
    FractionBox["1", "\[ExponentialE]"]}], TraditionalForm]],ExpressionUUID->
  "1b750d50-ad53-4550-9c68-b599d122f7a1"],
 "."
}], "Text",
 CellChangeTimes->{{3.900425975213369*^9, 3.900426017796454*^9}, {
  3.9004260773637667`*^9, 3.90042607749933*^9}, {3.900426124062228*^9, 
