Cell[CellGroupData[{

Cell["Our final soft knee limiter function", "Subsection",
 CellChangeTimes->{{3.900341195561695*^9, 3.900341201425879*^9}, {
  3.900426975272293*^9, 
  3.900426976056411*^9}},ExpressionUUID->"8dd601ce-c5f0-438d-8ed3-\
a7d1db50b7ee"],

Cell[TextData[{
 "We arrive at the soft knee limiter function\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"log", "(", "b", ")"}], "  ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c", "  ", "x"}], "-", "1"}], ")"}]}], ")"}]], "+", " ", 
     RowBox[{"d", " ", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "498afa41-c09d-4b73-b21d-7b6cba7e698a"],
 "\nwith\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]]}]}]}], TraditionalForm]],ExpressionUUID->
  "a213aa87-0c57-4a43-97cb-e7f1b6a35821"]
}], "Text",
 CellChangeTimes->{{3.90039788499474*^9, 3.900397983581708*^9}, {
