Cell[TextData[{
 "For small values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "ee5eac63-f2c4-435e-bfa4-387e96d01a97"],
 " we risk hitting the constraint. Again, we need to deal with this, as the \
situation where we need the limiter function is exactly when ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "7e4090e8-0f09-4eab-98c9-b4358f03fec5"],
 " is small.\n\nSo again, let\[CloseCurlyQuote]s look at the extreme case \
where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "c7700ec0-e2ac-43ba-bf63-3f0f777fdf04"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", "(", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"1", "-", "cx"}]], "-", "1"}], ")"}], "<", "1"}], 
   TraditionalForm]],ExpressionUUID->"a5ccfdb3-af4b-4c38-b161-c6d8d0ad0e18"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"1", "-", "cx"}]], "=", "\[ExponentialE]"}], TraditionalForm]],
  ExpressionUUID->"54d670b1-c093-47ed-abfc-c2c3d9381c02"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "23b59aea-49bf-42d1-8a2c-ce62eea3cdf0"],
 ". So we get the constraint\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", "(", 
     RowBox[{"\[ExponentialE]", "-", "1"}], ")"}], "<", 
    RowBox[{"1", "\[DoubleLongLeftRightArrow]", "c"}], "<", 
    FractionBox["1", 
     RowBox[{"\[ExponentialE]", "-", "1"}]], "\[TildeTilde]", 
    "0.5819767068693265`"}], TraditionalForm]],ExpressionUUID->
  "d85af6e9-d40b-4010-881c-0a23576a6bd6"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.900386847186009*^9, 3.900387235956761*^9}, {
  3.9003889668191557`*^9, 3.900388971417268*^9}, {3.9003890837663517`*^9, 
  3.90038914099826*^9}, {3.9003891718404512`*^9, 3.9003892141548634`*^9}, {
  3.9003892646573963`*^9, 3.900389390487586*^9}, {3.900427603145402*^9, 
  3.900427603933786*^9}, {3.900467136174814*^9, 3.900467136268306*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"7f8638c0-6303-4f77-9b04-7dd63e554bd6"],

