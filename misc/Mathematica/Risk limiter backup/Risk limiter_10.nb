Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", " ", "-", 
        SuperscriptBox["b", 
         RowBox[{
          RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"57a4c68a-c57b-445d-9c50-df0de85c5a6c"],
 "\n\nLet\[CloseCurlyQuote]s define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", "c", ")"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Tau]", "(", 
       RowBox[{
        RowBox[{"c", ";", " ", "x"}], ",", " ", "b"}], ")"}], 
      SubscriptBox["|", 
       RowBox[{"x", " ", "=", " ", "\[Infinity]"}]]}], "=", 
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], "\[ExponentialE]", " "}]}]}], 
   TraditionalForm]],ExpressionUUID->"3f176f1e-948a-4844-b48b-de91e539a3b9"],
 "\n\nConstraint:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     StyleBox[
      RowBox[{"b", " ", 
       RowBox[{"log", "(", "b", ")"}], "\[ExponentialE]"}],
      FontSize->14]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e6b69756-5514-4abb-9948-7f1562d87e48"]
}], "Text",
