 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", " ", "-", 
        SuperscriptBox["b", 
         RowBox[{
          RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"1e411f69-bb15-48a0-adf2-48dc26975a8c"],
 "\n\nLet\[CloseCurlyQuote]s define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", "c", ")"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Tau]", "(", 
       RowBox[{
        RowBox[{"c", ";", " ", "x"}], ",", " ", "b"}], ")"}], 
      SubscriptBox["|", 
       RowBox[{"x", " ", "=", " ", "\[Infinity]"}]]}], "=", 
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
