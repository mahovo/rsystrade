Cell[TextData[{
 "Constraint:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"a6e45e55-e9a3-4868-a960-bbccd0c88ef9"],
 "\n\nIf we constrain ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "dc52e69c-5f56-4111-abc0-0d00c1d35d0a"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"86a8af18-7f3e-4822-9a28-3889ea4eea59"],
 ", when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "<", "b", "<", "\[ExponentialE]"}], TraditionalForm]],
  ExpressionUUID->"6b62e70f-a5d1-4671-90c3-d2f279a36a7c"],
 ", we should be safe for all positive ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "d8ea3317-c57a-47fa-aafb-b5ddbae9ee0c"],
 "."
}], "Text",
