     StyleBox[
      FractionBox[
       RowBox[{"b", " ", "-", " ", 
        FractionBox[
         RowBox[{
          RowBox[{"b", " ", "c"}], " ", "-", " ", "1"}], "c"]}], 
       RowBox[{"exp", "(", 
        RowBox[{"c", "(", 
         RowBox[{"x", " ", "-", " ", 
