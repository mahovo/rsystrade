        RowBox[{"f", "[", 
         RowBox[{"x", ",", " ", "b", ",", " ", "c"}], "]"}], ",", " ", 
        RowBox[{"x", "<", 
         RowBox[{"1", "/", "c"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g", "[", "x", "]"}], ",", " ", 
        RowBox[{"x", ">=", 
         RowBox[{"1", "/", "c"}]}]}], "}"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"LogLogPlot", "[", "\[IndentingNewLine]", 
