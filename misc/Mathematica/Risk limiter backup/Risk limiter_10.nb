Cell[TextData[{
 "Let\[CloseCurlyQuote]s modify the plot such that ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "d9c5f681-9d36-4f08-85f2-1d9d841f76a5"],
 " is small:"
}], "Text",
