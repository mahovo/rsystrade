Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     FractionBox[
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], "-", 
       RowBox[{"log", "(", 
        FractionBox[
         RowBox[{"d", "-", "1"}], 
         RowBox[{"c", " ", 
          RowBox[{"log", "(", "b", ")"}]}]], ")"}]}], 
      RowBox[{"c", " ", 
       RowBox[{"log", "(", "b", ")"}]}]]}], "}"}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.900600395077322*^9, 3.900600433921493*^9}, 
   3.900600548092846*^9, 3.900600621822904*^9, 3.900600727945994*^9, 
