Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"b", " ", "=", " ", "1.2"}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"m", "=", "1"}], ";", " ", "\[IndentingNewLine]", 
    RowBox[{"n", "=", 
