Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"9951d800-72cb-44de-8f79-c5818d0b852b"],
 "  is monotonically increasing in ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "627154bc-0d76-410d-9cb8-0582a3890c04"],
 " for all values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "197ca6c4-5503-49d4-b539-2c8902575741"],
 ", when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f9397263-2dd8-48e8-b020-04b0d8717741"],
 ".\n\nSince we have an upper constraint on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  ExpressionUUID->"dd1e14e3-990e-4ed2-afc3-ba00087fec25"],
 ", the \[OpenCurlyDoubleQuote]worst case\[CloseCurlyDoubleQuote] is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "\[Infinity]"}], TraditionalForm]],ExpressionUUID->
  "b3f650d1-a871-449f-805d-7e079f54da1b"],
 ". As the plot suggests, the higher the value of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e9aad189-2cb5-4bb5-8598-5690ec968feb"],
 ", the sooner \[Tau](x; b, c) will reach the limit of 1, as ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "32ad0f1e-b877-4eff-8372-02d5a00d1d56"],
 " increases.\n\nLook at the constraint again:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", " ", "-", 
        SuperscriptBox["b", 
         RowBox[{
          RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"00309938-b63f-40f2-855e-775920e18519"],
 "\n\nFor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "289b9f83-899c-4bec-8a8a-6722a702e448"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "77232d89-b6f9-4a67-8641-bdd0b3ecf073"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["b", 
      RowBox[{
       RowBox[{"-", "c"}], " ", "x"}]]}], "->", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "afc74c55-d51f-4574-af8d-097dec56f6d7"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1de99dc2-b1a5-440e-aaed-828d1491b611"],
 ", so ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", " ", "b", " ", 
     RowBox[{"log", "(", "b", ")"}], 
     RowBox[{"(", 
      RowBox[{"\[ExponentialE]", " ", "-", 
       SuperscriptBox["b", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "->", 
    RowBox[{"c", " ", "b", " ", 
     RowBox[{"log", "(", "b", ")"}], "\[ExponentialE]"}]}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "61bf0a27-b291-448e-86ef-69af6dba67b3"],
 ".\n\nIn short:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "->", 
    RowBox[{"c", " ", "b", " ", 
     RowBox[{"log", "(", "b", ")"}], "\[ExponentialE]"}]}], TraditionalForm]],
  
  FormatType->TraditionalForm,ExpressionUUID->
  "d646ce0c-258a-42e7-b784-673b6bc4469b"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "->", "\[Infinity]"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8e67c559-bc7d-46e7-b5ed-d0246523f0a4"],
 " for all values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "38b64dfd-50c9-4977-a4b1-a1f4ce2f6629"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", 
    RowBox[{
     RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6ba38c94-5f1d-4393-8505-fce894bb7e63"],
 " is increasing in ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "b8dc847d-c41f-4dbe-a2f2-88c967b2fa10"],
 ".\n\nSo the calculated max value of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "385defd1-29a9-48ef-9b68-535b59670ebd"],
 " will be the upper limit."
}], "Text",
 CellChangeTimes->{{3.900665294960576*^9, 3.900665317775117*^9}, {
  3.900675952473001*^9, 3.900675952856534*^9}, {3.900678311911426*^9, 
  3.900678313902507*^9}, {3.900678562752199*^9, 3.9006785725193768`*^9}, {
  3.900678641948407*^9, 3.900678688705159*^9}, {3.900678719068396*^9, 
  3.900678766366482*^9}, {3.900678802474408*^9, 3.900678825595479*^9}, {
  3.900678870617774*^9, 3.900678901657381*^9}, {3.900678961822681*^9, 
  3.900678997493421*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"874e0ffb-52f6-4cc6-ba8f-f800740204c0"]
}, Open  ]],

