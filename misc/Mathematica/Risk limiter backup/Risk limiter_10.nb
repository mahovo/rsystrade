Cell[TextData[{
 "Again, ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "b90c862f-ea79-4542-b9e7-40dfe55691a2"],
 " does meet ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "a70724ce-afb6-4a2c-90eb-32b7ccf4c3d9"],
 " in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"a", ",", " ", "a"}], ")"}], TraditionalForm]],ExpressionUUID->
  "686ebc3c-f2e5-45ed-9963-e4e64403b731"],
 ", but the combined curve will not be smooth.\nAnd what\[CloseCurlyQuote]s \
worse, the blue curve misses the minimum limit of 0.5!"
}], "Text",
 CellChangeTimes->{{3.9002956135199823`*^9, 3.9002956236863947`*^9}, {
  3.900481943504435*^9, 3.900481946959324*^9}, {3.900482011543497*^9, 
  3.9004820189265842`*^9}, {3.900590330572644*^9, 
  3.900590364453827*^9}},ExpressionUUID->"29282256-d10b-4e87-acd5-\
35493a85ad24"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s try to construct a function that has g as a tangent. \
We can then join the two functions at the tangent point to get a smooth \
combined curve. So we want to find the derivative of ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "fb959a8f-898a-414c-9a4d-638ceb6d1ff4"],
 " wrt",
 Cell[BoxData[
  FormBox[" ", TraditionalForm]],ExpressionUUID->
  "0775e535-8b7f-4a3c-b767-f561ce83b31a"],
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "b9e2a903-2c5e-418e-8f5e-4fe12f6d9647"],
 ", i.e. the slope of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "71c5a13f-3629-4f80-9d62-a156e528a571"],
 "..."
}], "Text",
 CellChangeTimes->{
  3.900295506338861*^9, {3.900295672545169*^9, 3.900295731833795*^9}, {
   3.900295768514707*^9, 3.900295778482315*^9}, {3.900295818212241*^9, 
   3.900295826348414*^9}, {3.900481990809824*^9, 
   3.900482004872677*^9}},ExpressionUUID->"1548ec12-af5d-4425-8648-\
0e20ffd9c46d"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", ";", " ", "a"}], ",", " ", "b"}], ")"}]}], "=", 
   RowBox[{
    RowBox[{"-", "a"}], " ", 
    RowBox[{"log", "(", "b", ")"}], " ", 
    SuperscriptBox["b", 
     RowBox[{"a", "-", "x"}]]}]}], 
  TraditionalForm]],ExpressionUUID->"91a8d928-5dd1-4572-8dda-b14ebc282ed6"]], \
"Text",
 CellChangeTimes->{{3.900488766303257*^9, 
  3.9004888057273703`*^9}},ExpressionUUID->"8eda1d0a-910b-4762-8177-\
de19f40443cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"df1", "[", "x_", "]"}], "=", 
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"f1", "[", 
     RowBox[{"x", ",", " ", "a", ",", " ", "b"}], "]"}], ",", " ", "x"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9002936559757977`*^9, 3.900293701718136*^9}, {
  3.9002937907379208`*^9, 3.900293833895462*^9}, {3.900293877888921*^9, 
  3.900293884712277*^9}, {3.900419392267167*^9, 3.90041939448206*^9}},
 CellLabel->
  "In[1221]:=",ExpressionUUID->"be488bf5-15e9-4557-b409-a8e0fdc8f4a6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"-", "a"}], " ", 
   RowBox[{"log", "(", "b", ")"}], " ", 
   SuperscriptBox["b", 
    RowBox[{"a", "-", "x"}]]}], TraditionalForm]], "Output",
 CellChangeTimes->{3.9002938343634653`*^9, 3.900301557996545*^9, 
  3.9007520930843163`*^9, 3.9008393960121107`*^9},
 CellLabel->
  "Out[1221]=",ExpressionUUID->"bad74f38-8389-42d3-9a76-158adab27800"]
}, Open  ]],

Cell[TextData[{
 "...and then we want to solve for ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "800a80e3-f04f-4642-9765-228ba891edc9"],
 " to figure out, for which expression of a the slope of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "51b454df-8a68-450d-9dbd-e4977aed4d31"],
 " is 1:"
}], "Text",
 CellChangeTimes->{{3.900295831894991*^9, 3.900295909863143*^9}, {
   3.900481980243701*^9, 3.900481986757865*^9}, 
   3.900482027234804*^9},ExpressionUUID->"0b1ef53e-a09b-42f4-8e35-\
c72ef3ad9fc7"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{"a", "=", 
   RowBox[{"-", 
    FractionBox["1", 
     RowBox[{"log", "(", "b", ")"}]]}]}], 
  TraditionalForm]],ExpressionUUID->"b525317b-9dd6-4e3f-b1a9-42fd1316515a"]], \
"Text",
 CellChangeTimes->{{3.90048882307303*^9, 
  3.900488835785859*^9}},ExpressionUUID->"7f294596-1dd6-4912-914e-\
a979ef20b528"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"df1", "[", "a", "]"}], "==", "1"}], ",", " ", "a"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.900293816207263*^9, 3.9002938193427258`*^9}, {
   3.900293851350995*^9, 3.900293864591916*^9}, {3.900293907871171*^9, 
   3.900293935687416*^9}, 3.900301540513329*^9, 3.900301588392749*^9, 
   3.900419400122993*^9},
 CellLabel->
  "In[1222]:=",ExpressionUUID->"cb0b9508-a39b-44cb-b811-cd87c1467f6d"],

Cell[BoxData[
 FormBox[
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"a", "\[Rule]", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"log", "(", "b", ")"}]]}]}], "}"}], "}"}], 
  TraditionalForm]], "Output",
 CellChangeTimes->{{3.900293820902934*^9, 3.900293836399189*^9}, 
   3.90029394111261*^9, {3.900301565947197*^9, 3.900301588783086*^9}, 
   3.900752093104815*^9, 3.900839396035924*^9},
 CellLabel->
  "Out[1222]=",ExpressionUUID->"e5aa5dac-01c0-40bf-bd7d-3057f08dd953"]
}, Open  ]],

Cell[TextData[{
 "We now substitute this expression of ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],ExpressionUUID->
  "420f2a63-083d-4cf6-9f8a-658af1f6ea69"],
 " into ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],ExpressionUUID->
  "369da28e-04d6-4a95-85af-8dcfa77ceeb2"],
 ":"
}], "Text",
 CellChangeTimes->{{3.900295896589404*^9, 3.900295923271174*^9}, {
  3.900482035767655*^9, 
  3.900482039140864*^9}},ExpressionUUID->"f6835189-9283-4cc6-b1e0-\
9a58eeef9333"],

Cell[TextData[Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"f", "(", 
    RowBox[{"x", ";", " ", "b"}], ")"}], "=", 
   RowBox[{"-", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"log", "(", "b", ")"}], "  ", 
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"log", "(", "b", ")"}], " ", 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          RowBox[{"(", 
           RowBox[{"-", 
            FractionBox["1", 
             RowBox[{"log", "(", "b", ")"}]]}], ")"}]}], ")"}]}], 
       ")"}]}]]}]}], 
  TraditionalForm]],ExpressionUUID->"31a7db41-5f8e-45b0-9e5c-40153316b204"]], \
"Text",
 CellChangeTimes->{{3.900488863834943*^9, 3.900488951507236*^9}, {
  3.900584534040213*^9, 
  3.900584534512212*^9}},ExpressionUUID->"bd860254-92c1-4620-a032-\
9f56142127bf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f2", "[", 
   RowBox[{"x_", ",", " ", "b_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "1"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Log", "[", "b", "]"}], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"Log", "[", "b", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{"x", "+", 
         RowBox[{"(", 
          RowBox[{"1", "/", 
           RowBox[{"Log", "[", "b", "]"}]}], ")"}]}], ")"}]}], "]"}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.900293954113233*^9, 3.900294073969441*^9}, 
