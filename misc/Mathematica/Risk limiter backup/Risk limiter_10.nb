Cell[TextData[{
 "So far we have the constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "c", "<", "1.58"}], TraditionalForm]],ExpressionUUID->
  "d2a79c23-fddc-448b-922e-b5321990e731"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", 
    FractionBox["1", "\[ExponentialE]"]}], TraditionalForm]],ExpressionUUID->
  "b0eff93a-a62e-4dbb-9b0b-fdf1c5aa9d75"],
 ".\n\nWhat about for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "f1e80064-3572-4178-b8d9-b18b4fce41cd"],
 "?\nIf ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"d7999d69-ff6e-4571-958a-fd3ab2b336b1"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "="}], TraditionalForm]],ExpressionUUID->
  "1bfde3aa-52bd-4428-b508-f8076976a66d"],
 Cell[BoxData["1"],ExpressionUUID->"868b644d-e13a-4c9b-9c81-a4f578a03118"],
 ", and...\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", " ", 
       RowBox[{
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "=", 
     RowBox[{"0", "<", "1"}]}]}], TraditionalForm]],ExpressionUUID->
  "1395ca9c-cb9c-4373-8090-2f387316632f"],
 "\n\n...which is true for all ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "8f79f852-b746-49ac-a84a-b276f27752f2"],
 ".\n\nSo what happens as we decrease ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "47abe79f-fe7b-4b3f-99f3-0b3f2fc329af"],
 " from a value of ",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "\[ExponentialE]"], TraditionalForm]],ExpressionUUID->
  "256b909e-93ce-4fcc-8818-ab7989040b5f"],
 " towards 0?\n\nGoing back to the constraint...\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", " ", 
       RowBox[{
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"361cd97c-fd3e-4a24-88f8-5176fdc4da3a"],
 "\n"
}], "Text",
 CellChangeTimes->{{3.9004025843599*^9, 3.900402629127986*^9}, {
  3.900402818223426*^9, 3.900402956659174*^9}, {3.900403105060523*^9, 
  3.900403118126309*^9}, {3.900403495879984*^9, 3.9004034966961527`*^9}, {
  3.90040364736087*^9, 3.900403706721609*^9}, {3.900418234187921*^9, 
  3.9004182407964487`*^9}, {3.900418283363393*^9, 3.9004183140231743`*^9}, {
  3.9004183655012712`*^9, 3.9004183659958763`*^9}, {3.900418409230554*^9, 
  3.900418440390196*^9}, {3.900418634554275*^9, 3.900418643898726*^9}, {
  3.900419897243985*^9, 3.90041991252242*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"54f063b4-5da7-413d-a175-1aace4ea1321"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s examine the LH side of the inequality as a function \
of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "f9bec682-5137-4230-8fd3-94dba90195ca"],
 " for different values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "8a88d42f-7e17-460e-bdbd-8b90b6d3ca09"],
 ".\nWe are setting ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "ff4f823d-bbe6-4125-83c7-b630704eddb2"],
 " to 1."
}], "Text",
 CellChangeTimes->{{3.900403702913134*^9, 3.900403747817502*^9}, {
  3.900403813174385*^9, 3.900403830014292*^9}, {3.900405644890792*^9, 
  3.900405655225155*^9}, {3.9004720729160023`*^9, 3.9004720843883677`*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"0b1ee4a1-9ee8-41c0-940a-200a06519553"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"b", ",", " ", "c"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{"1", "-", "c"}], ")"}]}], "-", "1"}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cvalues", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "n"}], "]"}]}], ")"}], "/", "10"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<c=\>\"", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"cvalues", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}]}],
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", " ", "\"\<\[Tau](x)=1\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", 
      RowBox[{"tauvals", "[", 
       RowBox[{
        RowBox[{"cvalues", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", " ", "b"}], "]"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", " ", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{"out", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"b", ",", " ", "0", ",", " ", 
     RowBox[{"1", "/", "\[ExponentialE]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "5"}], ",", " ", "2"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", " ", "legends"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<b\>\"", ",", " ", "12"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<\[Tau](\>\"", ",", 
          RowBox[{"ToString", "[", "x", "]"}], ",", " ", "\"\<)\>\""}], "]"}],
         ",", " ", "12"}], "]"}]}], " ", "}"}]}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"\"\<x = \>\"", ",", " ", 
      RowBox[{"ToString", "[", "x", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
   "]"}]}], "Input",
