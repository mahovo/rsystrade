  RowBox[{"b", " ", "=", " ", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"c", "*", "E"}], "-", 
     RowBox[{"c", "*", 
      SuperscriptBox["b", 
       RowBox[{
        RowBox[{"-", "c"}], "*", "x"}]]}]}], "==", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"b", " ", "*", 
       RowBox[{"Log", "[", "b", "]"}]}], ")"}]}]}], ",", " ", "c", ",", " ", 
   "Reals", ",", " ", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", ">", "0"}], ",", " ", 
      RowBox[{"x", "<", "1"}]}], "}"}]}]}], "]"}]}], "Input",
