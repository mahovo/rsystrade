  "83427731-acbf-492b-a067-93a6758942c9"]
}], "Subsection",
 CellChangeTimes->{{3.900344930465667*^9, 3.9003449333857107`*^9}, {
  3.900399033491602*^9, 3.9003990425093*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"3da04810-bc5a-47ec-b550-e0d45031ebdc"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], ">=", 
    RowBox[{"1", "\[DoubleLongLeftRightArrow]", "b"}], ">=", "e"}], 
   TraditionalForm]],ExpressionUUID->"9fa165cb-74ba-4b7b-a239-ee15389fcc14"],
 "\n\nAbove we considered the case where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", "\[ExponentialE]"}], TraditionalForm]],ExpressionUUID->
  "768939dd-09a9-476c-9f26-ba8ff71edfa9"],
 ". Now let\[CloseCurlyQuote]s focus on the case where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "\[ExponentialE]"}], TraditionalForm]],ExpressionUUID->
  "fdd4801c-36e0-426f-a610-629d8392eb1d"],
 ".\n\nAgain we look at the constraint:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", " ", 
       RowBox[{
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"4bed31ad-d0c5-4b12-8b73-a4948bcc67bd"],
 "\n\nHere, \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "e2739d2d-5f9c-4b8f-9aca-f3284a0b1a33"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "\[ExponentialE]", ">", "1"}], TraditionalForm]],
  ExpressionUUID->"5790a03a-7c98-46b0-a9fb-2307402dfb6c"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], ">", "1", ">", "0"}], TraditionalForm]],
  ExpressionUUID->"820a3dee-3d43-40c9-9747-f5f05c4832e9"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "3e89643e-8d66-44af-8f49-0a0de9d87280"],
 " by definition\n\nFor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "\[ExponentialE]"}], TraditionalForm]],ExpressionUUID->
  "7505191d-8be8-400b-b7e5-3611fa06f3f8"],
 " the situation is again the same as before:\n\nL",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"og", "(", "b", ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"b", "-", "1"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b5093cab-3212-4096-928d-55525f705da8"],
 " is positive. Therefore, as before\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"1014d566-6aa6-414c-8bbf-d3d443a7897a"]
}], "Text",
 CellChangeTimes->{
  3.900339499608522*^9, {3.9003449425703773`*^9, 3.900344942874227*^9}, {
   3.900345101031148*^9, 3.9003451281753063`*^9}, {3.900389632212493*^9, 
   3.900389728647633*^9}, {3.900389797393793*^9, 3.9003900499481783`*^9}, {
   3.900390088780018*^9, 3.9003901170468884`*^9}, {3.9003901827267113`*^9, 
   3.900390229519208*^9}, {3.90039030648311*^9, 3.9003907116629868`*^9}, {
   3.900419985507944*^9, 3.900419985508163*^9}, {3.900420033215184*^9, 
   3.900420033299274*^9}, {3.9004201071566687`*^9, 3.900420107531993*^9}, {
   3.900420330293194*^9, 3.90042036585124*^9}, {3.900420467663957*^9, 
   3.9004204850490007`*^9}, {3.900420521718403*^9, 3.900420522166568*^9}, {
   3.900420687225437*^9, 3.9004207512114973`*^9}, {3.900476691529612*^9, 
   3.900476694273436*^9}, {3.9004774359876337`*^9, 3.900477437163476*^9}, {
   3.9004778588868732`*^9, 3.900477900870528*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"fdd46a29-9c17-4f62-9569-3caea4359b57"],

Cell[CellGroupData[{

Cell[TextData[{
 "Conclusion for region 4 (",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "\[ExponentialE]"}], TraditionalForm]],ExpressionUUID->
  "4057a92b-cbf1-48d4-a565-f3326bb6d62e"],
 ")"
}], "Subsubsection",
 CellChangeTimes->{{3.900340857077725*^9, 3.900340858930613*^9}, {
  3.900340991432539*^9, 3.900341019591834*^9}, {3.900344803469986*^9, 
  3.900344812702051*^9}, {3.900389567860702*^9, 3.9003895696188087`*^9}, {
  3.9003907462089376`*^9, 3.9003907499754343`*^9}, {3.9004812210816603`*^9, 
  3.900481221192429*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"ae73daab-1624-4e60-ad51-5b2660cfca1b"],

Cell[TextData[{
 "Constraint:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"b06beee1-3b40-40a5-bc06-0656d92fe588"],
 "\n\nIf we constrain ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "7f73a08e-fe84-4085-92df-853ce7a9c804"],
 " to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"2f6bdaf0-51a4-4b29-b32a-db57b42294f2"],
 ", when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "1"}], TraditionalForm]],ExpressionUUID->
  "9da53e9f-2d99-4ad4-b022-2a938d3db95d"],
 ", we should be safe for all positive ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "874b3a3d-6e6e-44eb-a30c-423534d277bb"],
 "."
}], "Text",
 CellChangeTimes->{{3.900477945838052*^9, 3.9004779591226883`*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"237679bb-556a-4a5d-a5c2-350cc53ab6b9"]
