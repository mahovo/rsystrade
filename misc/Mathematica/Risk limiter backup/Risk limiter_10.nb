   RowBox[{"f", "'"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "58dad147-d2c0-4fc4-afbe-ddea25aabb85"],
 " is 1 and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "=", " ", "g"}], TraditionalForm]],
