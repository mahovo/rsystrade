Cell[TextData[{
 StyleBox["Instead of setting ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "e20ac18d-78ad-4fd4-8a85-9ca2521f2a08"],
 StyleBox[" manually, it is baked in as a property of ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox["f", TraditionalForm]],
  FontColor->GrayLevel[0],ExpressionUUID->
  "1fb7ea33-e283-4853-8a6f-964da84c80a2"],
 StyleBox[". The tangent point is at ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", " ", "1"}], "/", "log"}], 
     RowBox[{"(", "b", ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "c5bf6607-c637-4667-8ddf-5ea75991ab4e"],
 ":"
}], "Text",
