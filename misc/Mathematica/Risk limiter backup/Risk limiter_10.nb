Cell[TextData[{
 "For  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "01b81308-117c-456a-9002-2138cd2ad98a"],
 " and ",
