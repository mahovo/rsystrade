   3.9003165399117537`*^9}, {3.900316584273408*^9, 3.900316594723166*^9}, {
   3.900323719779212*^9, 3.9003238018377*^9}, {3.900323979796742*^9, 
   3.9003239799001827`*^9}, {3.900324063706633*^9, 3.9003240723302097`*^9}, {
