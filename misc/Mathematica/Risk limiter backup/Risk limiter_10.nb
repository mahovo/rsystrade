Cell[TextData[{
 "For ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "<", "b", "<", "\[ExponentialE]"}], TraditionalForm]],
  ExpressionUUID->"da7d1bd7-3a02-4437-8a59-ee974aeaf099"],
 " the situation is the same as before:\n\nL",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"og", "(", "b", ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"b", "-", "1"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b5ce2092-95aa-4beb-b084-bc8e53f62ed5"],
 " is positive. Therefore, as before\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     RowBox[{" ", 
      RowBox[{
       RowBox[{"log", "(", "b", ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"b", "-", "1"}], ")"}]}]}]]}], TraditionalForm]],
  ExpressionUUID->"d0b690b5-8d09-48df-8a3b-1c7791e9bdbb"]
}], "Text",
 CellChangeTimes->{{3.900477730036232*^9, 3.90047774175981*^9}, {
  3.900477774162677*^9, 3.9004778363242893`*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"bcf703fc-def4-412e-8376-9b3c431f37b5"],

Cell[CellGroupData[{

Cell[TextData[{
 "Conclusion for region 3 (",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "<", "b", "<", "\[ExponentialE]"}], TraditionalForm]],
  ExpressionUUID->"61c2ba9b-b121-4359-b3b5-19c3ef4c5e50"],
 ")"
}], "Subsubsection",
