 RowBox[{
  RowBox[{"b", "=", "0.2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", "0"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"tauzero", "[", 
     RowBox[{"b_", ",", " ", "c_"}], "]"}], ":=", " ", 
    RowBox[{"c", " ", "*", " ", "b", "*", 
     RowBox[{"Log", "[", "b", "]"}], "*", 
     RowBox[{"(", 
      RowBox[{"E", "-", "1"}], ")"}]}]}], "*)"}], "\[IndentingNewLine]", 
