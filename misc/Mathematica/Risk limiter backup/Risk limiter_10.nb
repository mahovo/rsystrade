Cell[TextData[{
 "The problem here is, that the two curves will only have the same slope at \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", 
    RowBox[{"1", "/", "c"}]}], TraditionalForm]],ExpressionUUID->
  "4497dbbf-4794-41dd-b712-b6f5bda4ab6d"],
 ", which is not (necessarily) the point where the curves meet.\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]]}]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"2c810708-f8e6-40ef-8e89-49d955b9ea1b"],
 "\n",
 Cell[BoxData[
  FormBox["\[DoubleLongLeftRightArrow]", TraditionalForm]],ExpressionUUID->
  "4c695326-6728-4587-b39e-ba06246e00dc"]
}], "Text",
 CellChangeTimes->{{3.900599827852199*^9, 3.9005998344606733`*^9}, {
  3.90059986655783*^9, 3.900599883278068*^9}, {3.900599973041862*^9, 
  3.900599996749631*^9}, {3.900600325083115*^9, 3.900600339358672*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"e7fcaccf-9be8-4814-9624-ccef834091f9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f6temp", "[", 
    RowBox[{"x_", ",", " ", "b_", ",", " ", "c_", ",", " ", "d_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"Log", "[", "b", "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"c", " ", "*", " ", "x"}], "-", "1"}], ")"}]}], "]"}], 
      ")"}]}], "+", 
    RowBox[{"d", "*", "x"}]}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"df6", "[", "x_", "]"}], "=", 
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"f6temp", "[", 
       RowBox[{"x", ",", " ", "b", ",", " ", "c", ",", " ", "d"}], "]"}], ",",
       " ", "x"}], "]"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"df6", "[", "x_", "]"}], "=", 
  RowBox[{"d", " ", "-", " ", 
   RowBox[{"c", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"b", "^", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"c", "*", "x"}]}], ")"}]}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"df6", "[", "x", "]"}], "==", "1"}], ",", " ", "x"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.900600392947101*^9, 3.900600433161118*^9}, {
   3.9006005294006033`*^9, 3.900600547495101*^9}, {3.9006006173234873`*^9, 
