Cell[CellGroupData[{

Cell["Derivation of the upward limiter function", "Section",
 CellChangeTimes->{{3.90050557519312*^9, 3.900505584569412*^9}, {
  3.900583810949684*^9, 
  3.900583821725802*^9}},ExpressionUUID->"f39aa9c8-a42e-42d4-aec1-\
e0d04cf3f617"],

Cell[TextData[{
 "We want to limit risk (standard deviation) upward.\nAbove ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "acebd748-2b1d-445f-8fbe-b37cc5562285"],
 ", limit y with a function, ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "10b9f919-3232-4839-b6b2-72f0a549c0e1"],
 ", such that ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "8e43e64f-2b37-4a6b-b6a7-602fc1072437"],
 " approaches a limit, ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "e13496b1-592e-42ad-bf78-4b99b67cc96c"],
 ", as ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "fdcb770c-9948-44bd-845f-ea5e37fa5534"],
 " increases from below.\nBelow ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "d828f3f1-4318-4577-9314-b66dbbba24f9"],
 ", we want the input ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "067f0357-1dbd-4b95-b536-6d90ef5afbf0"],
 " to pass unchanged to the output ",
 Cell[BoxData[
  FormBox["y", TraditionalForm]],ExpressionUUID->
  "0aa27f51-075c-49d2-b20c-6c88f5caa038"],
 ", i.e. ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", " ", "=", " ", "x"}], TraditionalForm]],ExpressionUUID->
  "5d42c382-dcaf-4dd7-b65f-52a977d4ceec"],
 ". \nLet ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"g", 
     RowBox[{"(", "x", ")"}]}], " ", "=", " ", "x"}], TraditionalForm]],
  ExpressionUUID->"f9eb5a28-3804-4720-a244-eb670dc8763c"],
 ".\nSo we want to construct a piecewise function which is equal to ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "86b68a77-9d5b-4a00-af97-44bd5a4c9e96"],
 " above ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "8b4fd847-141a-48fd-9220-c4a537b48527"],
 " and equal to ",
 Cell[BoxData[
  FormBox["g", TraditionalForm]],ExpressionUUID->
  "83519767-0341-4079-9fa2-cc8ffd3f40e6"],
 " below ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", " ", "=", " ", "a"}], TraditionalForm]],ExpressionUUID->
  "bf8224e5-08c5-4221-b75b-b889ca8613c2"],
 ".\nInitial idea for ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "b4bb878e-761a-4fb5-a943-6a913f9375bf"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9004882272636127`*^9, 3.9004882409414597`*^9}, {
  3.9005839824917383`*^9, 
  3.9005839886024017`*^9}},ExpressionUUID->"ff1881f5-416f-492b-8e35-\
1500fe5a5db2"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "(", "x", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5d79a4c3-40a4-4908-8be9-e2cdcd8dcca1"],
 " should tend to the threshold ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2a604828-faec-453c-9d2f-525fe17dd09d"],
 ", as ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "da37e9ae-f680-4877-a60c-3955f66d863c"],
 " tends to ",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9fe84a29-d815-4ba3-977f-72acd6a9e7b7"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "'"}], 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "438bba7e-cca9-4da5-adc6-cd3af5a9f647"],
 " should tend to 0, as ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "803a735c-02a4-4c00-9ca4-abc61626a422"],
 " tends to ",
 Cell[BoxData[
  FormBox["\[Infinity]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "54b8c568-3e75-44d1-a21f-9138048d5304"],
 ".\n\nThis gives us the following idea:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     RowBox[{"b", "-", 
      FractionBox["1", 
       RowBox[{"exp", "(", "x", ")"}]]}], "=", 
     RowBox[{"b", "-", 
      RowBox[{"exp", "(", 
       RowBox[{"-", "x"}], ")"}]}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fb03cce8-64b0-46e1-80b3-8ce96af303fa"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"exp", "(", "x", ")"}]], "=", 
     RowBox[{"exp", "(", 
      RowBox[{"-", "x"}], ")"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "573c6b39-55df-4855-a691-d5ff535408af"]
}], "Text",
 CellChangeTimes->{{3.90039788499474*^9, 3.900397983581708*^9}, {
