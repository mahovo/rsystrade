Cell[TextData[{
 "For  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<", "b", "<", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "12c16c81-b7d6-43d0-a071-8776894f6e20"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3939dd00-b3fc-4a2f-bdfa-9734126a57ee"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "(", "c", ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1324a65b-4814-436e-b446-31159f52041b"],
 " is monitonically decreasing, and always negative for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0748c1f0-2e3c-4d39-9533-3e49eb4d1fee"],
 "."
}], "Text",
 CellChangeTimes->{{3.900680008232541*^9, 3.900680059946375*^9}, {
  3.90068078753263*^9, 3.90068079592549*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"43aa5218-f218-453c-b85f-6d7c4503e43a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Implementation notes", "Subsection",
 CellChangeTimes->{{3.900675226984086*^9, 3.900675227328068*^9}, {
  3.9006794259471827`*^9, 
  3.900679430394781*^9}},ExpressionUUID->"56a1bbc1-baeb-4013-8bea-\
5088089ce868"],

Cell[TextData[{
 "For implementation, a way forward might be to solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"90e0bd04-44ad-4a5a-aa21-dd68f9fea07e"],
 " for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "bfb177da-1c7e-4340-b3e0-dbf52062307f"],
 " given a value of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "255a79f9-314d-47cd-a262-907316640c2c"],
 ", to find the range of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "d6b1bd85-021c-4e7c-997f-69778e5e9765"],
 " where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], "<", "1"}], 
   TraditionalForm]],ExpressionUUID->"f6fc83e1-e909-470e-8c0d-14bc75532a43"],
 ".\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", " ", "-", 
        SuperscriptBox["b", 
         RowBox[{
          RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"e13a8c04-867e-4997-a802-f1c44378b0e1"]
}], "Text",
 CellChangeTimes->{{3.900420867716454*^9, 3.900420996226609*^9}, {
  3.900421258695315*^9, 3.900421259111597*^9}, {3.9006487354019012`*^9, 
  3.900648735401958*^9}, {3.9006551976183*^9, 3.900655197618353*^9}, {
  3.9006649685842447`*^9, 3.9006649724310913`*^9}, {3.900675568535707*^9, 
  3.900675573115456*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"efc5c8ae-4962-4427-869e-8fe5f8e47c40"],

Cell[TextData[{
 "Given conditions ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "c1d52584-5edb-4bfd-b252-c13cf8b8e463"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "24c4717e-6749-4090-8ec0-98c92939d372"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"c", " ", "b", " ", 
     RowBox[{"log", "(", "b", ")"}], 
     RowBox[{"(", 
      RowBox[{"\[ExponentialE]", " ", "-", 
       SuperscriptBox["b", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "<", "1"}], 
   TraditionalForm]],ExpressionUUID->"44e47cf8-4385-44cd-83b5-f522e51d55c4"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[DoubleLeftRightArrow]", 
    RowBox[{
     RowBox[{"b", " ", 
