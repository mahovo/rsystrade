Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"b", ",", " ", "c"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"x_", ",", " ", "c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"x", "*", "c"}]}], ")"}]}], "-", "1"}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvalues", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "n"}], "]"}]}], ")"}], "/", "10"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<c=\>\"", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"cvalues", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}]}],
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", " ", "\"\<\[Tau](x)=1\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", 
      RowBox[{"tauvals", "[", 
       RowBox[{"x", ",", " ", 
        RowBox[{"cvalues", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", " ", "b"}], "]"}]}], "]"}]}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", " ", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{"out", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"b", ",", " ", "0", ",", 
     RowBox[{"1", "/", "\[ExponentialE]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", " ", "legends"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<b\>\"", ",", " ", "12"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"StringJoin", "[", 
         RowBox[{"\"\<\[Tau](\>\"", ",", 
          RowBox[{"ToString", "[", "x", "]"}], ",", " ", "\"\<)\>\""}], "]"}],
         " ", ",", " ", "12"}], "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
   
   RowBox[{"PlotLabel", "\[Rule]", 
    RowBox[{"StringJoin", "[", 
     RowBox[{"\"\<x = \>\"", ",", " ", 
      RowBox[{"ToString", "[", "x", "]"}]}], "]"}]}]}], "\[IndentingNewLine]",
   "]"}]}], "Input",
 CellChangeTimes->{{3.9004059177739267`*^9, 3.900405945008497*^9}, {
