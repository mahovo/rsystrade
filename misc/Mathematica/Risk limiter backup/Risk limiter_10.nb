            RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
      "]"}]}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
