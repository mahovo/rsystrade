Cell[TextData[{
 "The curves above ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "1590557e-b82b-453a-9ba8-9216f83f6ed4"],
 " are associated with values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "dbb5e766-262d-48fe-8327-ff785d70c2fa"],
 " less than ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "x"}], TraditionalForm]],ExpressionUUID->
  "60b56a90-b481-4d55-a840-ebc97dcc665b"],
 ".\nThe curves below ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "723c8888-b77d-4cf9-bd6d-07178d6149cc"],
 " are associated with values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "b615f72c-fe98-411f-a146-8c42141c940e"],
 " more than ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "x"}], TraditionalForm]],ExpressionUUID->
  "70a1ba33-42d4-40e2-94c6-71f799224e10"],
 ".\nThe green curve on y=0 is associated with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "=", 
    RowBox[{"1", "/", "x"}]}], TraditionalForm]],ExpressionUUID->
  "3e279a40-a4ac-41cc-8c3d-2301b3ba92c6"],
 ".\nHere ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "d9dda0ee-e03f-417a-8d7a-f477323cfc88"],
 " in the two plots above."
}], "Text",
 CellChangeTimes->{
  3.9004036985639973`*^9, {3.9004039112002163`*^9, 3.9004039760587463`*^9}, {
   3.9004046694934607`*^9, 3.900404731982378*^9}, {3.900404782139477*^9, 
   3.900404788914596*^9}, {3.900405496190387*^9, 3.900405629914331*^9}, {
