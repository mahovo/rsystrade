h3jKvNzoQZioETgM16+nfYZRG4IJeFgphiiUs7Upo2zojSQGlrzaN0m5EDFN
/Ad0zvCL
  "],
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"40b57384-4b03-4f7d-bce4-9c7a122b2e8a"],

Cell[TextData[{
 "1) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "0", " "}], TraditionalForm]],ExpressionUUID->
  "f9b605b3-05db-4b67-bc7d-20b1cc395ab3"],
 " because ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "54c161c0-3bf6-480a-bb71-6621d8d9f40b"],
 " is a risk value, i.e. a standard deviation, and because we take log of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "cbc48f80-4b15-4d70-ad6e-cd8755171fac"],
 ".\n2) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "0e123780-883e-4bcd-9fa3-f6cb3768d2e0"],
 " (because ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "29dcbd1a-bdfb-4e03-a4fb-3a743c616f2e"],
 " is a standard deviation)\n\nWe need to consider 4 regions of ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "ee13cdd0-72b2-405b-8e27-8aed84f29f0e"],
 ", separated by the following values:"
}], "Text",
 CellChangeTimes->{
  3.900339648821661*^9, {3.900339742174902*^9, 3.9003397462246027`*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"fa6909a5-623d-4cbf-803d-353411d04a43"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Region 1: ",
 Cell[BoxData[
  RowBox[{"0", "<", "b", "<=", 
   FractionBox["1", "\[ExponentialE]"]}]],ExpressionUUID->
  "5894f60d-2ddb-458c-8a48-5af1bf16b0a1"]
}], "Subsubsection",
 CellChangeTimes->{
  3.90033957092187*^9, {3.900398984859227*^9, 3.900398986851884*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"7dd0bcff-0511-4407-9893-4e355f1b9475"],

Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Infinity]", "<", 
    RowBox[{"log", "(", "b", ")"}], "<=", 
    RowBox[{"-", 
     RowBox[{"1", "\[DoubleLongLeftRightArrow]", "0"}]}], "<", "b", "<=", 
    FractionBox["1", "\[ExponentialE]"]}], TraditionalForm]],ExpressionUUID->
  "a90c0377-fdb9-4cea-8a85-d507184402a4"],
 " \n\nIf ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "487b2b39-d2ab-411b-8433-b93081859899"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "="}], TraditionalForm]],ExpressionUUID->
  "c657b838-5d0b-4f58-9f6d-71d29eb13d35"],
 Cell[BoxData[
  FractionBox["1", "\[ExponentialE]"]],ExpressionUUID->
  "1f136918-95a3-4569-b361-5fad9a65a235"],
 ", and...\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", " ", "-", 
        SuperscriptBox["b", 
         RowBox[{
          RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], " ", "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"0c122f04-8eb8-462a-8af4-54a648d5104b"]
}], "Text",
 CellChangeTimes->{{3.900339557681263*^9, 3.900339565755574*^9}, {
  3.900339753344574*^9, 3.90033975385574*^9}, {3.900340205304859*^9, 
  3.900340205863863*^9}, {3.900340316267692*^9, 3.9003404682542953`*^9}, {
  3.900402725817281*^9, 3.900402739689413*^9}, {3.900419846859977*^9, 
  3.9004198650564327`*^9}, {3.900430617702066*^9, 3.900430667375252*^9}, {
  3.9006485352930403`*^9, 3.9006485352931433`*^9}, {3.900648568477542*^9, 
  3.900648590501214*^9}, {3.900648646133651*^9, 3.900648657300516*^9}},
 Background->RGBColor[
  0.88, 1, 0.88],ExpressionUUID->"c3197596-7714-4001-8bc3-82cf6236bc28"],

Cell[TextData[{
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Infinity]", "<", 
    RowBox[{"log", "(", "b", ")"}], "<=", 
    RowBox[{"-", 
     RowBox[{"1", "\[DoubleLongLeftRightArrow]", "0"}]}], "<", "b", "<=", 
    FractionBox["1", "\[ExponentialE]"]}], TraditionalForm]],ExpressionUUID->
  "96d78eda-c095-497c-9c18-2c9e31d5932b"],
 " \n\nIf ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], "=", 
    RowBox[{"-", "1"}]}], TraditionalForm]],ExpressionUUID->
  "5e497815-8e63-4a02-86e2-c649ffd498ac"],
 ", then ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "="}], TraditionalForm]],ExpressionUUID->
  "c0957c6f-572a-4cb1-9c80-d81a13a7567f"],
 Cell[BoxData[
  FractionBox["1", "\[ExponentialE]"]],ExpressionUUID->
  "01c6030d-5da7-4f5b-8504-44dab9c7e97f"],
 ", and...\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", " ", 
       RowBox[{
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "=", 
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"log", "(", 
        FractionBox["1", "\[ExponentialE]"], ")"}], 
       RowBox[{"(", " ", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["1", "\[ExponentialE]"], ")"}], 
          RowBox[{"1", "-", 
           RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "=", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"c", "(", " ", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox["1", "\[ExponentialE]"], ")"}], 
           RowBox[{"1", "-", 
            RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "=", 
       RowBox[{
        RowBox[{"c", "(", 
         RowBox[{"1", "-", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"c", " ", "x"}], "-", "1"}]]}], ")"}], "<", "1"}]}]}]}]}],
    TraditionalForm]],ExpressionUUID->
  "e270a628-5b32-4d96-a646-7bb828451c93"],
 "\n\nThis is not true for all values of ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "a29a7b7a-da1a-407a-958a-2a9902517b3e"],
 ", when ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "77462424-0293-46e7-bef1-8f52a3d0a966"],
 " is small.\n(This is bad, because small values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
   " ", Cell["x",ExpressionUUID->"a5ed2a97-4dba-4105-b2fb-87c715e63f1b"]}], 
   TraditionalForm]],ExpressionUUID->"22ef54ec-a3ea-4139-9152-e9a31f139ee7"],
 " are exactly the values we want to limit.)\n\nLet\[CloseCurlyQuote]s define\
\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{"c", ";", " ", "x"}], ")"}], ":=", 
    RowBox[{"c", "(", 
     RowBox[{"1", "-", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"c", " ", "x"}], "-", "1"}]]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"c9dabb92-82a6-4625-b335-4fe54b629d7b"]
}], "Text",
 CellChangeTimes->{{3.900339557681263*^9, 3.900339565755574*^9}, {
