Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", "0.0001"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "10"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"b", ",", " ", "c"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"x_", ",", " ", "c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", "*", 
    RowBox[{"Log", "[", "b", "]"}], "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"x", "*", "c"}]}], ")"}]}], "-", "1"}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"cvalues", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"Range", "[", 
        RowBox[{"1", ",", "n"}], "]"}]}], ")"}], "/", "10"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<c=\>\"", ",", 
         RowBox[{"ToString", "[", 
