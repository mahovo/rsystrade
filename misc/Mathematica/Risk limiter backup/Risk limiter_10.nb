  FormBox[
   RowBox[{"0", "<", "b", "<", 
    FractionBox["1", "\[ExponentialE]"]}], TraditionalForm]],ExpressionUUID->
  "3ac76e67-856e-4f67-9085-90bc6666b17c"],
 ")"
}], "Subsubsection",
