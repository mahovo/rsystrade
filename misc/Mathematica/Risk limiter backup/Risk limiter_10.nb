Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "<=", 
    RowBox[{"log", "(", "b", ")"}], "<=", 
    RowBox[{"0", "\[DoubleLongLeftRightArrow]", 
     FractionBox["1", "\[ExponentialE]"]}], "<=", "b", "<=", "1"}], 
   TraditionalForm]],ExpressionUUID->"3c3d1399-6c25-4c98-8626-6a5ed0a172ee"],
 " "
}], "Text",
 CellChangeTimes->{{3.900339488138535*^9, 3.900339501460103*^9}, {
  3.900341257451206*^9, 3.900341404856069*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"13d02279-dd36-4df1-ab37-903fa60f5839"],

Cell[TextData[{
 "If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", "(", "b", ")"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"91d81638-3098-42c7-aabb-20a505e1920f"],
 ", then we get the constraint\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", " ", 
       RowBox[{
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "=", 
     RowBox[{"0", "<", "1"}]}]}], TraditionalForm]],ExpressionUUID->
  "616d71a9-fef7-48d6-a565-2f1f012e6822"],
 "\n\n...which is true for all ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],ExpressionUUID->
  "3f2e236e-81b5-48d4-870e-c8aa6e19d296"],
 ".\n\nIf ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "<=", 
    RowBox[{"log", "(", "b", ")"}], "<", "0"}], TraditionalForm]],
  ExpressionUUID->"a2c8fcea-f6cf-4a62-b450-a992236f6c00"],
 ", then...\n",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{"\[Tau]", "(", 
      RowBox[{
       RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
     RowBox[{
      RowBox[{"c", " ", 
       RowBox[{"log", "(", "b", ")"}], 
       RowBox[{"(", " ", 
        RowBox[{
         SuperscriptBox["b", 
          RowBox[{"1", "-", 
           RowBox[{"c", " ", "x"}]}]], "-", "1"}], ")"}]}], "<", "1"}]}]}], 
   TraditionalForm]],ExpressionUUID->"16936cd9-18c7-49c3-bdc8-20767dc640d8"],
 " only if ...??"
}], "Text",
 CellChangeTimes->{{3.90034147362458*^9, 3.900341479858288*^9}, {
  3.900341536331696*^9, 3.900341562690915*^9}, {3.900341619700482*^9, 
  3.900341632876824*^9}, {3.900341789744651*^9, 3.9003418645785913`*^9}, {
  3.900342002151585*^9, 3.900342002559421*^9}, {3.9003424298899937`*^9, 
  3.900342431578322*^9}, {3.900343424812625*^9, 3.90034342519654*^9}, {
  3.900386584440473*^9, 3.900386590057488*^9}, {3.90041994681069*^9, 
  3.900419950187684*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"ee1af6cc-aa32-44c4-89fb-2c8aa353d763"],

Cell[TextData[{
 "Picking a ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "f009970e-65f1-4f7d-90ad-c29246679bd3"],
 "-value inside the region, very close to the lower bound:"
}], "Text",
 CellChangeTimes->{{3.9003421990193453`*^9, 3.9003422240287247`*^9}, {
  3.900344219838511*^9, 3.900344230750842*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"52b83c41-d9cc-4d24-80f5-53ce97a297e6"],

Cell[TextData[{
 "Generate a sequence of x-values:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "exp"], "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "m"}], ")"}]}], ",", "...", ",", " ", 
      RowBox[{"10", "^", 
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}]}]}], "}"}]}], TraditionalForm]],
  ExpressionUUID->"3ea25401-acb9-4934-b646-61753508a3cc"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "lin"], "=", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "...", ",", " ", "10"}], "}"}], "/", "10"}]}], 
   TraditionalForm]],ExpressionUUID->"dd5fb6eb-224d-458e-848e-5cfd7de57cf6"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "vals"], "=", 
    RowBox[{"{", 
     RowBox[{
      SubscriptBox["x", "exp"], ",", " ", 
      SubscriptBox["x", "lin"]}], "}"}]}], TraditionalForm]],ExpressionUUID->
  "9c1b72fa-137e-46a8-9e36-41398c237b9a"]
}], "Text",
 CellChangeTimes->{{3.9004754193941717`*^9, 3.9004755006228533`*^9}, {
  3.900475531349228*^9, 3.900475531749452*^9}, {3.900475658727928*^9, 
  3.900475690001811*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"dff28f0d-1f8f-4e78-93fe-128ad7468376"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "/", "\[ExponentialE]"}], ")"}], "+", "0.0001"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m", "=", "5"}], ";"}], " ", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"m", "+", "9"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "c", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tauvals", "[", 
    RowBox[{"x_", ",", " ", "c_", ",", " ", "b_"}], "]"}], ":=", " ", 
   RowBox[{"c", " ", 
    RowBox[{"Log", "[", "b", "]"}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"b", "^", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"c", " ", "*", " ", "x"}]}], ")"}]}], "-", "1"}], ")"}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvalues", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Flatten", "[", 
     RowBox[{"Append", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"10", "^", 
        RowBox[{"(", 
         RowBox[{"Range", "[", 
          RowBox[{
           RowBox[{"-", "m"}], ",", 
           RowBox[{"-", "1"}]}], "]"}], ")"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"2", ",", " ", "10"}], "]"}], "/", "10"}]}], 
      "\[IndentingNewLine]", "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"legends", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<x=\>\"", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"xvalues", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}]}],
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"legends", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"legends", ",", " ", "\"\<\[Tau](x)=1\>\""}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"out", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<", 
    RowBox[{"n", "+", "1"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", " ", 
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", 
      RowBox[{"tauvals", "[", 
       RowBox[{
        RowBox[{"xvalues", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", " ", "c", ",", " ", "b"}], 
       "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"out", "=", 
    RowBox[{"Append", "[", 
     RowBox[{"out", ",", " ", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", "\[IndentingNewLine]", 
  RowBox[{"out", ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{"c", ",", " ", "0", ",", " ", "20"}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "4"}], ",", " ", "4"}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<c\>\"", ",", " ", "12"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<\[Tau](c; x)\>\"", ",", " ", "12"}], "]"}]}], "}"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "\[Rule]", "legends"}], ",", "\[IndentingNewLine]", 
   
   RowBox[{
   "PlotLabel", "\[Rule]", "\"\<b = (1/\[ExponentialE])+0.0001\>\""}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.9003420052375507`*^9, 3.900342077377859*^9}, {
