Cell[TextData[{
 StyleBox["But we still have the problem, that the blue curve is missing the \
limit value. (Which is only noticable in the plot for small balues of ",
  FontColor->GrayLevel[0]],
 Cell[BoxData[
  FormBox["b", TraditionalForm]],ExpressionUUID->
  "1b955dbc-ec9a-4f8a-a8ea-d162553bd17d"],
 ", but ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", "b"}], TraditionalForm]],ExpressionUUID->
  "5f294127-67d2-4a2d-8240-4aa717652172"],
 " will typically be small!)\nIgnoring that, we can define the piecewise \
function ",
 Cell[BoxData[
  FormBox["h", TraditionalForm]],ExpressionUUID->
  "4c3ea8fa-e4c3-48ee-99db-d2494acbec28"],
 ":"
}], "Text",
