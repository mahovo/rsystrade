Cell[TextData[{
 "The strategy is to solve ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", " ", "\[ExponentialE]"}], " ", "-", 
      RowBox[{"c", " ", 
       SuperscriptBox["b", 
        RowBox[{
         RowBox[{"-", "c"}], " ", "x"}]]}]}], ")"}], ">", 
    FractionBox["1", 
     RowBox[{"b", " ", 
      RowBox[{"log", "(", "b", ")"}]}]]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "e0be11ef-b281-406d-a6ef-14d2ef16ad63"],
 "for ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "33898e06-60c7-45d9-98cf-7a5026f914fd"],
 " with two extreme values of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a20c3717-8a81-4cff-b869-c6183325463c"],
 "."
}], "Text",
 CellChangeTimes->{{3.9006628283873053`*^9, 3.9006629230451317`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"8065cd50-3590-495f-93de-15a61fb82fe0"],

Cell[CellGroupData[{

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"b", ">", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "6793d202-738b-44c0-8d6d-443897bc3df7"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "44b05736-cd19-465d-bba8-8d6e69112c36"]
}], "Subsubsection",
 CellChangeTimes->{{3.9006769725277557`*^9, 3.9006769765371933`*^9}, {
  3.90067702593638*^9, 3.900677032450287*^9}, {3.9006771813654957`*^9, 
  3.900677184986805*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"74672ab5-f462-43eb-92a7-f1ba1ede552f"],

Cell[TextData[{
 "First, we set ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "73491343-b159-4b9e-9462-0474bd2094b6"],
 " to 0:"
}], "Text",
 CellChangeTimes->{{3.900662933654418*^9, 3.900662943133285*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"5b26c5a5-89d2-4085-9c09-c4e467767526"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", 
     RowBox[{
      RowBox[{"x", ";", " ", "b"}], ",", " ", "c"}], ")"}], ":=", 
    RowBox[{
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", " ", "-", 
        SuperscriptBox["b", 
         RowBox[{
          RowBox[{"-", "c"}], " ", "x"}]]}], ")"}]}], "<", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"46ff046c-ff41-4b8b-b4d2-fec9731217ad"],
 "\n\nLet\[CloseCurlyQuote]s define ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Tau]", "(", "c", ")"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Tau]", "(", 
       RowBox[{
        RowBox[{"c", ";", " ", "x"}], ",", " ", "b"}], ")"}], 
      SubscriptBox["|", 
       RowBox[{"x", " ", "=", " ", "\[Infinity]"}]]}], "=", 
     RowBox[{"c", " ", "b", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"\[ExponentialE]", "-", "1"}], ")"}], " "}]}]}], 
   TraditionalForm]],ExpressionUUID->"61410a6a-e4df-4c46-93ae-c35c5602b6bb"],
 "\nfor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "f8ac2996-73f2-42b6-8591-f82993615cf9"],
 ".\n\nConstraint:\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", "<", 
    FractionBox["1", 
     StyleBox[
      RowBox[{"b", " ", 
       RowBox[{"log", "(", "b", ")"}], 
       RowBox[{"(", 
        RowBox[{"\[ExponentialE]", "-", "1"}], ")"}]}],
      FontSize->14]]}], TraditionalForm]],ExpressionUUID->
  "58c2bd7a-9c44-44be-86c3-6d30283630b2"],
 "\n\nHere we are imposing the constraint ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],ExpressionUUID->
  "a53ba768-3db8-45ce-a657-4d7ac6e8657b"],
 ", to simplify the problem."
}], "Text",
 CellChangeTimes->{{3.900425077533064*^9, 3.900425154167832*^9}, {
  3.900425201728876*^9, 3.900425225137726*^9}, {3.9004259331509666`*^9, 
