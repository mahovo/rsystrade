 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    FractionBox["1", 
     RowBox[{
      RowBox[{"exp", "(", 
       RowBox[{
        RowBox[{"log", "(", "b", ")"}], 
