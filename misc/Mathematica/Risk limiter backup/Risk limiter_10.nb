  FormatType->TraditionalForm,ExpressionUUID->
  "e2c7948f-fd85-40e7-b9d3-72b745af80ee"],
 " is monitonically decreasing, and always negative for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", ">", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2f95182c-2085-42e5-abf6-0d4980861668"],
 "."
}], "Text",
