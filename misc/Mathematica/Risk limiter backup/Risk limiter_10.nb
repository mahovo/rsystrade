   3.900322756226247*^9, 3.900322777487455*^9}, {3.900322867413589*^9, 
   3.9003228963313293`*^9}, {3.9003229325361023`*^9, 3.900322937046607*^9}, 
   3.900323004886098*^9, 3.900323078112986*^9, 3.9004303287110443`*^9, {
   3.900430390617002*^9, 3.900430420228153*^9}, 3.900593610017026*^9, 
   3.900752212333939*^9, 3.900839496146421*^9},
 CellLabel->
  "Out[1274]=",ExpressionUUID->"c4bb4ec2-6b77-40d3-b7ef-489ca1be26fe"]
}, Open  ]],

Cell[TextData[{
 "We need to find the point where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", "'"}], TraditionalForm]],ExpressionUUID->
  "5f0033df-4a98-486c-8b35-a6f72a761b99"],
 " is 1 and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"f", " ", "=", " ", "g"}], TraditionalForm]],ExpressionUUID->
  "0b95167c-d52e-4dbb-b17f-e097eb0dabff"],
 ".\n\nFrom ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{"d", "-", 
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], " ", 
      SuperscriptBox["b", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}]], " "}]}]}], TraditionalForm]],
  ExpressionUUID->"0356a9cf-35a7-4142-9418-6a509018c007"],
 "we immediately see that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", "1"}], TraditionalForm]],ExpressionUUID->
  "ec026cb3-961e-4c36-b011-da47ca727729"],
 " when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"c", " ", "=", " ", 
    FractionBox["1", "x"]}], TraditionalForm]],ExpressionUUID->
  "61a7c46c-307f-4015-8fd7-47ba9ec0e6e0"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"d", "=", 
    RowBox[{
     FractionBox[
      RowBox[{"log", "(", "b", ")"}], "x"], "+", "1"}]}], TraditionalForm]],
  ExpressionUUID->"53d350e8-b3ad-4add-ac9c-c8f2f30edbda"],
 ". \nWe now have two expressions of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "a02f2982-03af-43c5-bce3-079f9c560f9c"],
 ":\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", 
    FractionBox["1", "c"]}], TraditionalForm]],ExpressionUUID->
  "140e9c9d-4fae-453c-8c4b-f08ffd91b4b6"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"x", "=", 
     FractionBox[
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"d", "-", "1"}]]}], ",", " ", 
    RowBox[{"b", ">", "0"}], ",", " ", 
    RowBox[{"c", ">", "0"}], ",", " ", 
    RowBox[{"d", "\[NotEqual]", "0"}]}], TraditionalForm]],ExpressionUUID->
  "b876617c-19c8-40f2-8f14-9c8dd296049b"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLongLeftRightArrow]", "d"}], "=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}]}], "+", "1"}]}], TraditionalForm]],
  ExpressionUUID->"8bae8ece-92c0-43ff-8168-59daa80f76e6"],
 "\n\nWe can now plug this expression of ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "67c16a72-17b6-4e95-9fdc-83745b1f1700"],
 " into ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "701d68e0-341c-4be9-b1ab-1aa99791f17f"],
 ":\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", "x", ")"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{
       RowBox[{"exp", "(", 
        RowBox[{
         RowBox[{"log", "(", "b", ")"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"c", " ", "x"}], "-", "1"}], ")"}]}], ")"}], ")"}]], "+", 
     " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", " ", 
         RowBox[{"log", "(", "b", ")"}]}], " ", "+", " ", "1"}], ")"}], 
      "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "3fca0b48-31d3-41f9-b96a-1cb0057a2eea"],
 "\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"f", "'"}], 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", " ", 
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]]}], ")"}]}], "+", "1"}]}], 
   TraditionalForm]],ExpressionUUID->"addf7c63-6d88-4299-af96-74960955bd91"]
}], "Text",
 CellChangeTimes->{{3.900317767770631*^9, 3.9003179322411118`*^9}, {
  3.900318026212029*^9, 3.9003180755512457`*^9}, {3.90031817842625*^9, 
  3.900318178426362*^9}, {3.900318233346236*^9, 3.900318279773047*^9}, {
  3.9003183193727407`*^9, 3.900318352653961*^9}, {3.900323025287129*^9, 
  3.90032302528728*^9}, {3.900323092017212*^9, 3.900323119209714*^9}, {
  3.900323211903633*^9, 3.900323240060848*^9}, {3.9003232703110313`*^9, 
  3.900323351353931*^9}, {3.9003233847050533`*^9, 3.900323624594486*^9}, {
  3.900399452402638*^9, 3.900399452946465*^9}, {3.9003994983077297`*^9, 
  3.9003995462389927`*^9}, {3.900399629655571*^9, 3.900399649183072*^9}, {
  3.900482346084433*^9, 3.900482377768051*^9}, {3.900575029936001*^9, 
  3.9005750367992487`*^9}, {3.90059981120989*^9, 
  3.900599816975706*^9}},ExpressionUUID->"5aab89fa-5976-49c0-8948-\
3cf26d607132"],

Cell[TextData[{
 "The slope of this new ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "31fdb13a-9bc4-4e3c-95b4-689770e2126f"],
 " is 1 when\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"c", " ", 
      RowBox[{"log", "(", "b", ")"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", " ", 
        SuperscriptBox["b", 
         RowBox[{"1", "-", 
          RowBox[{"c", " ", "x"}]}]]}], ")"}]}], "+", "1"}], "=", "1"}], 
   TraditionalForm]],ExpressionUUID->"e5ce0cc8-bad7-452b-84aa-e83921265f42"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLongLeftRightArrow]", 
     SuperscriptBox["b", 
      RowBox[{"1", "-", 
       RowBox[{"c", " ", "x"}]}]]}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"8a870c07-a97b-4f08-878d-e9faa1189e05"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[DoubleLongLeftRightArrow]", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"c", " ", "x"}]}], ")"}]}], " ", 
     RowBox[{"log", "(", "b", ")"}]}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"5071c99c-ba8e-4680-bc20-2fee8b87a3de"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"\[DoubleLongLeftRightArrow]", "1"}], "-", 
     RowBox[{"c", " ", "x"}]}], "=", "0"}], TraditionalForm]],ExpressionUUID->
  "bfa91d95-2954-45ca-81e2-773b142fd17d"],
 "\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[DoubleLongLeftRightArrow]", "x"}], "=", 
    RowBox[{"1", "/", "c"}]}], TraditionalForm]],ExpressionUUID->
  "75fb8a4c-e25c-43ac-a9f8-c88642ed7a10"]
}], "Text",
 CellChangeTimes->{{3.900575058889161*^9, 3.90057508622003*^9}, {
  3.9005755635526953`*^9, 3.900575659869409*^9}, {3.900575690318159*^9, 
  3.900575782353385*^9}, {3.900575817219459*^9, 
  3.900575831746729*^9}},ExpressionUUID->"fe8b3ec0-cf3b-4b92-886f-\
4959ab343e2c"],

Cell[TextData[{
 "But \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", "(", 
     RowBox[{"1", "/", "c"}], ")"}], "=", 
    RowBox[{"1", "+", " ", 
     RowBox[{"log", "(", "b", ")"}], " ", "+", " ", 
     RowBox[{"1", "/", "c"}]}]}], TraditionalForm]],ExpressionUUID->
  "938b1772-656c-416b-88ef-7b7ae0562218"],
 "\nwhich is not ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", "c"}], TraditionalForm]],ExpressionUUID->
  "ffd2d4f9-b57a-4ebf-b99e-cd959ee18e87"],
 "!\n\nWe need to get rid of the term ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", 
    RowBox[{"log", "(", "b", ")"}]}], TraditionalForm]],ExpressionUUID->
  "571366dc-fbae-4514-80a5-b71a5e1502a7"],
 ". But if we just subtract it from ",
 Cell[BoxData[
  FormBox["f", TraditionalForm]],ExpressionUUID->
  "e63c11cf-d9c4-4b3c-85e6-930f76de156e"],
 ", we won\[CloseCurlyQuote]t hit the limit of ",
 Cell[BoxData[
  FormBox[Cell[TextData[Cell[BoxData[
    FormBox["b", TraditionalForm]],ExpressionUUID->
    "d4832f27-f46c-4f35-9a36-b4794a6d3d3d"]],ExpressionUUID->
    "25f869d3-8a9b-425b-b51a-dc2ded230c8e"], TraditionalForm]],ExpressionUUID->
  "746abd42-418c-49c8-94b2-7cc2732bda58"],
 "at ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "cba0e44a-a795-48dc-8834-a6a9c11d85e1"],
 "."
}], "Text",
 CellChangeTimes->{{3.90059387679963*^9, 3.900593903721713*^9}, {
  3.900593933841667*^9, 3.900593978114705*^9}, {3.9005943245616703`*^9, 
  3.900594325038898*^9}},
 Background->RGBColor[
  1, 0.85, 0.85],ExpressionUUID->"403da111-64f2-4644-9713-047a0018b723"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"f6", "[", 
   RowBox[{"x_", ",", " ", "b_", ",", " ", "c_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"Log", "[", "b", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"c", " ", "*", " ", "x"}], "-", "1"}], ")"}]}], "]"}], 
     ")"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", "*", 
       RowBox[{"Log", "[", "b", "]"}]}], "+", "1"}], ")"}], "*", 
    "x"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g6", "[", "x_", "]"}], ":=", "x"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h6", "[", 
    RowBox[{"x_", ",", " ", "b_", ",", " ", "c_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f6", "[", 
         RowBox[{"x", ",", " ", "b", ",", " ", "c"}], "]"}], ",", " ", 
        RowBox[{"x", "<", 
         RowBox[{"1", "/", "c"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"g6", "[", "x", "]"}], ",", " ", 
        RowBox[{"x", ">=", 
         RowBox[{"1", "/", "c"}]}]}], "}"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"LogLogPlot", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"h6", "[", 
      RowBox[{"x", ",", " ", "b", ",", " ", "c"}], "]"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", "10"}], "}"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"PlotRange", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "10"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"PlotLegends", "\[Rule]", 
      RowBox[{"{", "\"\<h(x)\>\"", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"AxesLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", " ", "\"\<h(x)\>\""}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", ",", " ", "0.1"}], "}"}], ",", " ", "0", ",", " ", "1", 
     ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "0.1"}], "}"}], ",", " ", "0.01", ",", " ", 
     "0.5", ",", " ", 
     RowBox[{"Appearance", "->", "\"\<Open\>\""}]}], "}"}]}], 
  "\[IndentingNewLine]", "]"}]}], "Input",
 CellChangeTimes->{{3.900301887736432*^9, 3.90030189034455*^9}, {
   3.9003020142372427`*^9, 3.900302042108905*^9}, {3.900302122264468*^9, 
   3.900302161297121*^9}, {3.900302226578681*^9, 3.900302227041766*^9}, 
